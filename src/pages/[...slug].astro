---
import { ArrowRight } from '@lucide/astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return [
    'home-page',
  ].map((slug) => ({ params: { slug } }));
}

const slug = Astro.params.slug ?? '';
const canonicalSlug = slug === 'faqs' ? 'resources/faqs' : slug;

const pageTitle = canonicalSlug.split('/').filter(Boolean).map((s) => s.replaceAll('-', ' ')).join(' ') || 'Home';
---

<BaseLayout title={`Genesis360 | ${pageTitle}`}>
  <Header />
  <main>
    {canonicalSlug === 'home-page' && (
      <>
        <PageHero eyebrow="Genesis360" title="Precision Dry Fog. Automated Efficiency. 360-Degree Coverage." copy="The current Genesis360 homepage is available at the site root." />
        <section class="bg-white py-20">
          <div class="container-page">
            <a href="/" class="button-primary">Open Home Page <ArrowRight class="h-4 w-4" /></a>
          </div>
        </section>
      </>
    )}
  </main>
  <Footer />
</BaseLayout>
