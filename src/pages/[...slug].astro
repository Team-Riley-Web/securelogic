---
import type { ImageMetadata } from 'astro';
import { ArrowDownToLine, ArrowRight, Check, FileText, Leaf, Mail, Phone, Repeat, ShieldCheck, Target, Wrench, X } from '@lucide/astro';
import { Image } from 'astro:assets';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import QuoteForm from '../components/QuoteForm.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { posts } from '../data/blog-posts';
import { humanMarkets } from '../data/human-markets';
import { hvacMarkets } from '../data/hvac-markets';
import { agMarkets } from '../data/ag-markets';
import botanimaxLogo from '../assets/images/botanimax-logo.png';
import botanimaxBottle from '../assets/images/botanimax-bottle.png';
import compact from '../assets/images/genesis-compact.png';
import inroom from '../assets/images/inroom-mist.png';
import hvac from '../assets/images/hvac-mist.png';
import mobile from '../assets/images/mobile-mist.png';
import medical from '../assets/images/medical-mist.png';
import portable from '../assets/images/portable-mist.png';
import agri from '../assets/images/agri-guard.png';
import physics from '../assets/images/physics-icon.png';
import nozzle from '../assets/images/nozzle-icon.png';
import nozzles from '../assets/images/nozzles.png';
import pathogen from '../assets/images/pathogen.png';
import faqRoom from '../assets/images/faq-room.jpg';
import contactBg from '../assets/images/contact-bg.jpeg';
import label from '../assets/images/botanimax-label.png';
import childcare from '../assets/images/brochure-childcare.png';
import agriculture from '../assets/images/brochure-agriculture.png';
import fitness from '../assets/images/brochure-fitness.png';

export function getStaticPaths() {
  return [
    'home-page',
    'human',
    'hvac',
    'ag',
    'genesis360mistingsystems',
    'botanimax',
    'resources',
    'resources/brochures',
    'resources/documentation',
    'resources/faqs',
    'faqs',
    'about-us',
    'about-us/technology',
    'contact-us',
    'get-a-quote',
    'privacy-policy',
  ].map((slug) => ({ params: { slug } }));
}

const slug = Astro.params.slug ?? '';
const canonicalSlug = slug === 'faqs' ? 'resources/faqs' : slug;

const systems: { name: string; image: ImageMetadata; alt: string }[] = [
  { name: 'InRoomMist', image: inroom, alt: 'Genesis 360 InRoom Mist' },
  { name: 'HVACMist', image: hvac, alt: 'Genesis 360 HVAC misting system image' },
  { name: 'Compact Mist', image: compact, alt: 'Secure Logic Genesis Compact' },
  { name: 'MobileMist', image: mobile, alt: 'Genesis 360 Mobile Mist' },
  { name: 'MedicalMist', image: medical, alt: 'Kinetic Systems Medical Mist' },
  { name: 'PortableMist', image: portable, alt: 'Kinetic Systems Portable Mist' },
  { name: 'AgriGuard', image: agri, alt: 'Genesis 360 Grey AgriGuard' },
];

const differentiators = [
  ['True whole-room disinfection', 'Sub-10-micron dry mist behaves like a vapor, filling the entire room volume and treating air, surfaces, and hard-to-access areas for genuine 360-degree coverage.'],
  ['Automation and remote operation', 'Industrial-grade controls run pre-programmed cycles automatically, with options for centralized or remote control so staff don’t need to be in the room.'],
  ['Faster reentry times', 'Integrated air movement and drying accelerate clear-out, allowing rooms to return to service more quickly than with many traditional fogging or vapor systems.'],
  ['Environmentally neutral and safer than competitors', 'Dry mist leaves no residue, does not change humidity or temperature, and uses tightly controlled dosing — reducing chemical waste, material compatibility issues, and risk to sensitive equipment and surfaces.'],
  ['Sub-10 micron, dry-mist technology', 'Ultra-fine droplets stay suspended longer and move with airflow, wrapping around objects and reaching shadowed zones that line-of-sight UV and large-droplet sprayers miss.'],
  ['Precision-engineered nozzle system', 'Custom nozzles deliver consistent droplet size and low, predictable flow rates, maximizing coverage while minimizing product consumption and oversaturation.'],
  ['Platform, not a single device', 'A modular family of systems — HVAC, in-room, medical, mobile, agricultural — built on the same core technology, enabling standardized physics and logic across very different facility types.'],
  ['Engineered reliability and low maintenance', 'Minimal moving parts and simple periodic checks deliver high uptime, long service life, and a lower total cost of ownership.'],
  ['Volumetric hygiene layer that complements cleaning', 'Adds an automated, whole-room treatment layer on top of manual cleaning and other technologies, doing what people and line-of-sight systems simply cannot.'],
];

const features = [
  'EPA 2(c) Registered',
  'Controls harmful bacteria, viruses, and fungi',
  'Helps contain emerging pathogens',
  'Residual clean efficacy',
  'An emerging viral pathogen disinfectant',
  'Made in the USA',
];

const botanimaxFeatures: { title: string; copy: string }[] = [
  { title: 'Plant Actives', copy: 'BotaniMax is meticulously crafted from 150+ plant actives, ensuring that every drop is infused with the natural power and resilience of botanicals for a holistic defense against pathogens.' },
  { title: 'Comprehensive Protection', copy: 'Our formula is designed to combat a wide spectrum of harmful microorganisms — bacteria, viruses, or fungi — making it a versatile solution for many different environments.' },
  { title: "Potency of Nature's Defenses", copy: 'Embrace the full potency of nature’s defenses. By utilizing plant oil, our disinfectant goes beyond synthetic alternatives to deliver a natural and effective tool against pathogens.' },
  { title: 'Eco-Friendly Solution', copy: 'BotaniMax is not only powerful but also eco-friendly. We prioritize sustainability so the product aligns with responsible practices — a choice that’s good for you and for the planet.' },
  { title: "Trust in Nature's Wisdom", copy: 'Nature has been defending itself for centuries, and BotaniMax taps into that inherent wisdom. Trust in the time-tested efficacy of botanicals to protect your surroundings.' },
];

const docGroups: { heading: string; items: [string, string][] }[] = [
  {
    heading: 'Documentation',
    items: [
      ['EPA Registration for the Label', 'Botanical-Disinfectant-Master-Label-1.pdf'],
      ['BotaniMax SDS Sheet', 'SDS-PreVasive-Botanical-Disinfectant-RTU-4-1.pdf'],
    ],
  },
  {
    heading: 'Lab Reports',
    items: [
      ['Efficacy Lab Report', 'Pathogen-Report.pdf'],
      ['Staph Efficacy Lab Report', 'Staph-Final-Report.pdf'],
    ],
  },
  {
    heading: 'White Paper',
    items: [
      ['Industrial Hygiene White Paper', 'INDUSTRIAL-HYGIENE-White-Paper-Genesis-misting-Trial-BotaniMax.pdf'],
    ],
  },
];

const brochures: { title: string; image: ImageMetadata; file: string; summary: string }[] = [
  { title: 'Early Child Care Centers', image: childcare, file: '/docs/Secure-Logic-Early-Child-Care-NoBmax-Brochure.pdf', summary: 'Keeping classrooms, nap areas, and play spaces safe for the youngest and most vulnerable.' },
  { title: 'Agriculture Overview', image: agriculture, file: '/docs/Secure-Logic-AgBrochure1-General.pdf', summary: 'Automated biosecurity for barns, greenhouses, and grow rooms that protects yield and herd health.' },
  { title: 'Fitness Centers', image: fitness, file: '/docs/Secure-Logic-Fitness-Center-Brochure-Final-1.pdf', summary: 'Whole-room disinfection for locker rooms, mats, and high-touch equipment between sessions.' },
];

const techSections: { title: string; image: ImageMetadata; alt: string; paragraphs: string[]; bullets?: string[] }[] = [
  {
    title: 'Physics-Based Precision',
    image: physics,
    alt: 'Physics-based precision misting icon',
    paragraphs: [
      'At the core of the Genesis360™ platform is a simple truth: droplet behavior defines performance. Every nozzle produces a uniform stream of sub-10 µm dry-mist droplets — small enough to stay airborne, light enough to behave like a vapor, and engineered to surround airborne and surface-bound particles with measurable consistency.',
      'Unlike conventional foggers or sprayers that produce 30–120 µm droplets which fall rapidly and leave gaps, Genesis360™ micro-droplets remain suspended long enough to reach hidden zones, under equipment, and behind obstacles — achieving true volumetric saturation.',
    ],
  },
  {
    title: 'Intelligent Nozzle Architecture',
    image: nozzle,
    alt: 'Intelligent nozzle architecture icon',
    paragraphs: [
      'Each precision nozzle atomizes fluid at roughly ⅓ oz per minute, maintaining consistent particle size distribution and eliminating over-application. The result is a mist that is perfectly even — dry to the touch, residue-free, and safe for electronics, optics, and sensitive surfaces.',
    ],
    bullets: [
      'Tapered orifice geometry for uniform atomization',
      'Corrosion-resistant alloys for durability in harsh environments',
      'Laminar flow design that minimizes turbulence and noise',
    ],
  },
  {
    title: 'Automated Intelligence',
    image: compact,
    alt: 'Genesis 360 automated controller',
    paragraphs: [
      'Genesis 360™ replaces human variability with programmable logic. An industrial-grade PLC controller regulates misting duration, interval, and density. Once configured, each cycle runs autonomously — set the schedule, press start, walk away.',
      'Every cycle delivers identical results — drop for drop, second for second — removing training, supervision, and inconsistency from the equation. This automation ensures predictable operation across multi-zone facilities, reducing chemical waste and energy use.',
    ],
  },
];

const microDynamics: { title: string; copy: string }[] = [
  { title: 'Extended Suspension', copy: 'Smaller droplets remain airborne 10–20× longer, maximizing contact time.' },
  { title: 'Omnidirectional Movement', copy: 'Vapor-phase mist diffuses through convection currents, wrapping around every surface.' },
  { title: 'No Oversaturation', copy: 'The mist evaporates before pooling — ideal for climate-sensitive spaces like labs, data centers, and greenhouses.' },
  { title: 'Surface Adhesion', copy: 'Droplets form at a low contact angle (≈ 4–12%), clinging evenly across vertical, horizontal, and underside planes.' },
];

const envSafe = [
  'Cleanrooms and medical labs',
  'Semiconductor or optics manufacturing',
  'HVAC ducts and data centers',
  'Agricultural and livestock facilities',
];

const faqs: { question: string; answer: string; bullets?: string[] }[] = [
  {
    question: 'What is the Genesis 360™ Misting System Platform?',
    answer: 'Genesis 360 is an automated environmental misting platform that uses sub-10 micron dry mist droplets and intelligent controls to deliver consistent 360-degree coverage in the air and on surfaces — the same way, every cycle.',
  },
  {
    question: 'How is Genesis 360 different from traditional foggers or spray systems?',
    answer: 'Traditional foggers and pump sprayers produce larger wet droplets (30–120 microns) that fall quickly and leave gaps. Genesis 360 droplets remain suspended long enough to fill the room or duct volume, wrap around objects, and reach hidden zones — without relying on a person to aim the sprayer.',
  },
  {
    question: 'What problems does Genesis 360 solve for facilities?',
    answer: 'It removes the human variability that undermines manual disinfection, addressing the issues facilities struggle with most:',
    bullets: [
      'Inconsistent coverage from manual cleaning',
      'Labor dependence and rising labor costs',
      'Unpredictable chemical use and overspray',
    ],
  },
  {
    question: 'What does "sub-10 micron droplets" mean, and why does it matter?',
    answer: 'It means each droplet is smaller than ten microns across. At that size, droplets remain airborne far longer, make contact with airborne particles, reach hidden and underside surfaces, and evaporate before pooling — enabling true volumetric coverage instead of wet, uneven spray.',
  },
  {
    question: 'What is meant by "360-degree coverage"?',
    answer: 'The system treats the entire three-dimensional space rather than just the surfaces a person can reach. In practice, the mist works to:',
    bullets: [
      'Fill the entire room or duct volume',
      'Wrap around and underneath surfaces',
      'Make contact with airborne particles and contaminants',
    ],
  },
  {
    question: 'Can Genesis 360 products be customized for different buildings or processes?',
    answer: 'Yes. Genesis 360 is a configurable platform, not a single fixed device. Deployments can be tuned by:',
    bullets: [
      'Number and placement of nozzles',
      'Flow rates and droplet density',
      'Cycle durations and dwell times',
      'Zone configurations for large or multi-building sites',
      'Control inputs such as schedules and optional sensors',
    ],
  },
  {
    question: 'Is the technology safe for electronics, medical equipment, and sensitive surfaces?',
    answer: 'The dry mist is engineered to remain vapor-phase and evaporate quickly without standing moisture, condensation, or pooling when installed and operated as directed — making it suitable for electronics, optics, and other sensitive equipment.',
  },
  {
    question: 'What kind of maintenance does Genesis 360 require?',
    answer: 'Most systems require low monthly maintenance, such as inspecting filters, verifying nozzle performance, and checking fluid levels.',
  },
];

const storyProblems = [
  'Inconsistent manual labor',
  'Missed surfaces and hidden zones',
  'Wet sprays that damaged materials',
  'Chemical waste',
  'HVAC systems quietly spreading contaminants',
];

const designSystems = [
  'Reduce labor and training burden',
  'Eliminate guesswork about coverage',
  'Limit waste and material damage',
  'Fit into real-world constraints like tight mechanical rooms and limited budgets',
];

const principles: { icon: typeof Target; title: string; copy: string }[] = [
  { icon: Target, title: 'Precision', copy: 'Physics-driven droplet control that reaches the same coverage in every corner of a space.' },
  { icon: Repeat, title: 'Repeatability', copy: 'Automated cycles that deliver identical results run after run, without depending on who is holding the sprayer.' },
  { icon: Wrench, title: 'Practicality', copy: 'Systems that fit real budgets, real mechanical rooms, and the real constraints of working facilities.' },
];
---

<BaseLayout title={`Secure Logic | ${canonicalSlug.split('/').filter(Boolean).map((s) => s.replaceAll('-', ' ')).join(' ') || 'Home'}`}>
  <Header />
  <main>
    {canonicalSlug === 'home-page' && (
      <>
        <PageHero eyebrow="Secure Logic" title="Precision Misting. Automated Efficiency. 360-Degree Coverage." copy="The current Secure Logic homepage is available at the site root." />
        <section class="bg-white py-20">
          <div class="container-page">
            <a href="/" class="button-primary">Open Home Page <ArrowRight class="h-4 w-4" /></a>
          </div>
        </section>
      </>
    )}

    {canonicalSlug === 'human' && (
      <>
        <PageHero eyebrow="Human" title="Protecting People Everywhere They Gather" copy="From wrestling rooms to hospital wings, Genesis 360 and BotaniMax deliver automated, whole-room coverage anywhere infection risk follows close contact." />
        <section class="bg-white py-20">
          <div class="container-page">
            <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
              {humanMarkets.map(({ icon: Icon, slug: marketSlug, title, summary }) => (
                <a href={`/human/${marketSlug}/`} class="card group p-6">
                  <Icon class="h-6 w-6 text-botanical-600" />
                  <h2 class="mt-5 text-lg font-semibold text-slate-900">{title}</h2>
                  <p class="mt-3 text-sm leading-6 text-slate-600">{summary}</p>
                  <span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-primary-700">Learn more <ArrowRight class="h-4 w-4 transition group-hover:translate-x-1" /></span>
                </a>
              ))}
            </div>
            <a href="/#applications" class="button-secondary mt-8 inline-flex">See all applications <ArrowRight class="h-4 w-4" /></a>
          </div>
        </section>
        <section class="bg-slate-100 py-20">
          <div class="container-page">
            <h2 class="section-title">Related reading</h2>
            <div class="mt-10 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
              {posts.filter((p) => humanMarkets.some((m) => m.postSlugs.includes(p.slug))).map((post) => (
                <a href={`/blogs/${post.slug}/`} class="card group flex flex-col overflow-hidden">
                  <Image src={post.image} alt={post.imageAlt} class="aspect-[16/9] w-full object-cover" widths={[420, 640, 860]} sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw" />
                  <div class="flex flex-1 flex-col p-6">
                    <time datetime={post.isoDate} class="text-xs font-semibold uppercase tracking-[0.16em] text-botanical-600">{post.date}</time>
                    <h3 class="mt-3 text-lg font-semibold leading-7 text-slate-900">{post.title}</h3>
                    <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-primary-700">Read article <ArrowRight class="h-4 w-4 transition group-hover:translate-x-1" /></span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </section>
        <section class="bg-white py-20"><div class="container-page"><QuoteForm /></div></section>
      </>
    )}

    {canonicalSlug === 'hvac' && (
      <>
        <PageHero eyebrow="HVAC" title="Cleaner Air. Longer Equipment Life." copy="360HVAC Mist infuses air-handling systems with ultra-fine BotaniMax mist, keeping coils, ducts, and vents clear of the biofilm that spreads facility-wide." />
        <section class="bg-white py-20">
          <div class="container-page">
            <div class="grid gap-6 sm:grid-cols-2">
              {hvacMarkets.map(({ icon: Icon, slug: marketSlug, title, summary }) => (
                <a href={`/hvac/${marketSlug}/`} class="card group p-6">
                  <Icon class="h-6 w-6 text-botanical-600" />
                  <h2 class="mt-5 text-lg font-semibold text-slate-900">{title}</h2>
                  <p class="mt-3 text-sm leading-6 text-slate-600">{summary}</p>
                  <span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-primary-700">Learn more <ArrowRight class="h-4 w-4 transition group-hover:translate-x-1" /></span>
                </a>
              ))}
            </div>
          </div>
        </section>
        <section class="bg-slate-100 py-20">
          <div class="container-page">
            <h2 class="section-title">Related reading</h2>
            <div class="mt-10 grid gap-8 md:grid-cols-2">
              {posts.filter((p) => hvacMarkets.some((m) => m.postSlugs.includes(p.slug))).map((post) => (
                <a href={`/blogs/${post.slug}/`} class="card group flex flex-col overflow-hidden">
                  <Image src={post.image} alt={post.imageAlt} class="aspect-[16/9] w-full object-cover" widths={[420, 640, 860]} sizes="(min-width: 768px) 50vw, 100vw" />
                  <div class="flex flex-1 flex-col p-6">
                    <time datetime={post.isoDate} class="text-xs font-semibold uppercase tracking-[0.16em] text-botanical-600">{post.date}</time>
                    <h3 class="mt-3 text-lg font-semibold leading-7 text-slate-900">{post.title}</h3>
                    <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-primary-700">Read article <ArrowRight class="h-4 w-4 transition group-hover:translate-x-1" /></span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </section>
        <section class="bg-white py-20"><div class="container-page"><QuoteForm /></div></section>
      </>
    )}

    {canonicalSlug === 'ag' && (
      <>
        <PageHero eyebrow="Agriculture" title="Reach Every Corner. Protect Every Acre." copy="AgGriGuard Mist and InRoom Mist disperse BotaniMax into the air and across every exposed surface with touch-free, full-coverage disinfection for crops, canopy, and livestock." />
        <section class="bg-white py-20">
          <div class="container-page">
            <div class="grid gap-6 md:grid-cols-3">
              {agMarkets.map(({ icon: Icon, slug: marketSlug, title, summary }) => (
                <a href={`/ag/${marketSlug}/`} class="card group p-6">
                  <Icon class="h-6 w-6 text-botanical-600" />
                  <h2 class="mt-5 text-lg font-semibold text-slate-900">{title}</h2>
                  <p class="mt-3 text-sm leading-6 text-slate-600">{summary}</p>
                  <span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-primary-700">Learn more <ArrowRight class="h-4 w-4 transition group-hover:translate-x-1" /></span>
                </a>
              ))}
            </div>
            <a href="/#applications" class="button-secondary mt-8 inline-flex">See all applications <ArrowRight class="h-4 w-4" /></a>
          </div>
        </section>
        <section class="bg-slate-100 py-20">
          <div class="container-page">
            <h2 class="section-title">Related reading</h2>
            <div class="mt-10 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
              {posts.filter((p) => agMarkets.some((m) => m.postSlugs.includes(p.slug)) || p.slug === 'secure-logic-newfields-ag-botanical-disinfection-partnership').map((post) => (
                <a href={`/blogs/${post.slug}/`} class="card group flex flex-col overflow-hidden">
                  <Image src={post.image} alt={post.imageAlt} class="aspect-[16/9] w-full object-cover" widths={[420, 640, 860]} sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw" />
                  <div class="flex flex-1 flex-col p-6">
                    <time datetime={post.isoDate} class="text-xs font-semibold uppercase tracking-[0.16em] text-botanical-600">{post.date}</time>
                    <h3 class="mt-3 text-lg font-semibold leading-7 text-slate-900">{post.title}</h3>
                    <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-primary-700">Read article <ArrowRight class="h-4 w-4 transition group-hover:translate-x-1" /></span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </section>
        <section class="bg-white py-20"><div class="container-page"><QuoteForm /></div></section>
      </>
    )}

    {canonicalSlug === 'genesis360mistingsystems' && (
      <>
        <PageHero eyebrow="Genesis 360 Systems" title="The Genesis360™ Misting System Family" copy="The Genesis360™ Platform represents the next generation of environmental control. Built around proprietary sub-10 micron droplet technology and precision-engineered nozzles, each system in the Genesis family provides the same level of scientific consistency — adapted for the specific needs of your space." />
        <section class="bg-white py-20">
          <div class="container-page">
            <p class="mx-auto max-w-3xl text-center text-lg leading-8 text-slate-600">Whether integrated into HVAC ducts, mounted in-room, deployed in medical facilities, or configured for agricultural and mobile use, every Genesis360™ system delivers measurable results: 360-degree coverage, predictable performance, and effortless operation.</p>
            <h2 class="section-title mt-16 text-center">The Genesis 360 System Lineup</h2>
            <div class="mt-10 flex flex-wrap justify-center gap-6">
            {systems.map(({ name, image, alt }) => (
                <article class="accent-card grid w-full max-w-[260px] place-items-center gap-4 border-t-4 border-primary-500 p-6 text-center sm:w-[calc(50%-0.75rem)] md:w-[calc(33.333%-1rem)] lg:w-[calc(25%-1.125rem)]">
                  <Image src={image} alt={alt} class="h-28 w-28 object-contain" widths={[150, 300, 450]} sizes="112px" />
                  <h3 class="text-lg font-semibold text-slate-900">{name}</h3>
                </article>
              ))}
            </div>
          </div>
        </section>
        <section class="bg-slate-100 py-20">
          <div class="container-page">
            <h2 class="section-title text-center">So, what sets the Genesis 360 Misting System apart?</h2>
            <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
              {differentiators.map(([title, copy]) => (
                <article class="card p-6">
                  <ShieldCheck class="h-6 w-6 text-botanical-600" />
                  <h3 class="mt-5 text-lg font-semibold text-slate-900">{title}</h3>
                  <p class="mt-3 text-sm leading-6 text-slate-600">{copy}</p>
                </article>
              ))}
            </div>
          </div>
        </section>
        <section class="bg-white py-20"><div class="container-page"><QuoteForm /></div></section>
      </>
    )}

    {canonicalSlug === 'botanimax' && (
      <>
        <PageHero eyebrow="BotaniMax" title="Botanical Disinfection for Cleaner Indoor Environments" copy="BotaniMax is dedicated to redefining the way you clean, one botanical solution at a time." />
        <section class="bg-white py-20">
          <div class="container-page grid items-center gap-12 lg:grid-cols-[.9fr_1.1fr]">
            <div class="grid place-items-center rounded-lg bg-slate-100 p-8 shadow-lift">
              <Image src={botanimaxLogo} alt="BotaniMax logo for disinfection product" class="h-40 w-40 object-contain" widths={[240, 400]} sizes="160px" />
              <Image src={botanimaxBottle} alt="Bottle of BotaniMax in a clear bottle" class="mt-8 max-h-[460px] object-contain" widths={[260, 420, 620]} sizes="(min-width: 1024px) 38vw, 100vw" />
            </div>
            <div>
              <h2 class="section-title">Why BotaniMax</h2>
              <p class="mt-4 text-base leading-8 text-slate-600">A patent-pending, plant-based disinfectant engineered to deliver hospital-grade results without the harsh synthetics.</p>
              <div class="mt-8 grid gap-3 sm:grid-cols-2">
                {features.map((feature) => (
                  <div class="flex gap-3 rounded-lg bg-slate-50 p-4">
                    <Check class="mt-0.5 h-5 w-5 shrink-0 text-botanical-600" />
                    <span class="text-sm font-semibold text-slate-800">{feature}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </section>

        <section class="bg-slate-100 py-20">
          <div class="container-page">
            <h2 class="section-title">Key Features of BotaniMax</h2>
            <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
              {botanimaxFeatures.map(({ title, copy }) => (
                <article class="accent-card border-t-4 border-botanical-500 p-6">
                  <Leaf class="h-6 w-6 text-botanical-600" />
                  <h3 class="mt-5 text-lg font-semibold text-slate-900">{title}</h3>
                  <p class="mt-3 text-sm leading-6 text-slate-600">{copy}</p>
                </article>
