---
// HVAC hub. Mirrors the ag and Human hubs on the shared sector blocks.
// Sources: H = Genesis360 HVAC.pdf (mission paragraphs, the "why homeowners
// should ask" list); hero footage is the supplied family/HVAC cutaway (see STOCK-SOURCES.md).
// Spec: docs/superpowers/specs/2026-09-17-hvac-section-design.md
import { ClipboardList, FileText, TrendingUp } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SectorHero from '../../components/sector/SectorHero.astro';
import SectorCards from '../../components/sector/SectorCards.astro';
import DifferenceGrid from '../../components/sector/DifferenceGrid.astro';
import PostsRow from '../../components/sector/PostsRow.astro';
import SectorCta from '../../components/sector/SectorCta.astro';
import { hvacMarkets } from '../../data/hvac-markets';
import { posts } from '../../data/blog-posts';
// Family-at-home footage per Marty (Userback 8434757): relatable, not commercial.
import heroVideo from '../../assets/videos/hvac-hub-family.mp4';
import heroPoster from '../../assets/images/hero-hvac-hub-family-poster.jpg';

const sectorCards = hvacMarkets.map((m) => ({
  title: m.title,
  tagline: m.tagline,
  href: `/hvac/${m.slug}/`,
  linkLabel: `Explore ${m.title.toLowerCase()}`,
  image: m.card?.image ?? m.hero.poster,
  imageAlt: m.card?.alt ?? m.hero.posterAlt,
  stat: m.stat,
}));

const checklist = [
  { icon: FileText, label: 'Product & system use guides' },
  { icon: TrendingUp, label: 'Coverage and maintenance guidance' },
  { icon: ClipboardList, label: 'Industry resources' },
];

// Audience cards, rewritten from Marty's 2026-09-25 feedback (were three of
// Source H p.1's "Why homeowners should ask for Genesis360").
const points: { icon: 'droplet' | 'coverage' | 'cycle' | 'shield'; title: string; copy: string }[] = [
  // Card 01: residential, written to the parent (Marty, 2026-09-25).
  { icon: 'shield', title: 'Safer air for your children', copy: 'Your kids breathe the air your HVAC moves, all day and all night. AeroGuard helps keep mold and bacteria off the coil, reducing the allergens that can trigger asthma and allergies in every bedroom.' },
  // Card 02: commercial, written to the employer about their people (Marty, 2026-09-25).
  { icon: 'cycle', title: 'A healthier place to work', copy: 'Your team breathes the building\'s air eight hours a day. Cleaner air supports a better workplace: less sick time, stronger retention and a team that gets more done.' },
  // Card 03: range (Marty, 2026-09-25). Odors moved up into the mission band.
  { icon: 'coverage', title: 'A system for every HVAC', copy: 'Hall closet, attic, rooftop or a building full of air handlers: there is an AeroGuard for every size and style of HVAC system, from residential to commercial spaces.' },
];

const HVAC_POSTS = [
  'biofilm-hvac-prevention',
  'how-to-extend-the-lifespan-of-your-hvac-system',
  'how-to-identify-sick-building-syndrome-and-improve-indoor-air-quality-in-your-building',
];
const hvacPosts = HVAC_POSTS.map((slug) => posts.find((post) => post.slug === slug)!).filter(Boolean);
---

<BaseLayout
  title="Genesis360 | HVAC"
  description="One platform for every air handler. Genesis360 AeroGuard treats the coil, drain pan and air handler on a schedule, from a single home to a plant that never switches off."
>
  <div class="bl bg-white" x-data x-init="document.documentElement.classList.add('reveal-enabled')">
    <Header />
    <main>
      <!-- Source H p.1 opening and "One system to reach the HVAC pathway". -->
      <SectorHero
        layout="split"
        eyebrow="HVAC"
        headline={['Cleaner Coils.', 'Cleaner Ducts.', 'Cleaner Air.']}
        support="One Platform. Every Air Handler."
        lede="Your air handler does more than heat and cool. It moves the air people breathe every day across a wet coil, through a cabinet and down the ducts. Genesis360 keeps the inside of that system cleaner by targeting the mechanical areas where biofilm, bacteria, mold and odors begin."
        poster={heroPoster}
        video={heroVideo}
        mediaPosition="35% center"
        cta={{ href: '/get-a-quote/', label: 'Get A Quote' }}
        secondaryCta={{ href: '#sectors', label: 'Explore By Sector' }}
      />

      <!-- Mission band, same pattern as the ag and Human hubs. Source H p.1. -->
      <section class="relative overflow-hidden bg-white py-20 sm:py-24">
        <div class="particle-field particle-field-light" aria-hidden="true">
          <span class="particle"></span><span class="particle"></span><span class="particle"></span><span class="particle"></span><span class="particle"></span>
          <span class="particle"></span><span class="particle"></span><span class="particle"></span><span class="particle"></span><span class="particle"></span>
        </div>
        <div class="container-page relative">
          <h2 class="bl-h2 reveal mx-auto text-center" x-intersect.once="$el.classList.add('is-visible')">
            Our mission is simple.<br /><span class="text-brand-600">Genesis360 makes the air you breathe cleaner from the source.</span>
          </h2>
          <div class="reveal mx-auto mt-14 grid max-w-5xl gap-10 md:grid-cols-2" x-intersect.once="$el.classList.add('is-visible')">
            <p class="text-base leading-7 text-brand-body">
              The HVAC is the lungs of the building. Every breath of indoor air passes through it, so indoor air quality starts there. Most odors start there too: the coil and drain pan collect moisture by design, and with it the biofilm and bacteria behind the smell. Candles, sprays and plug-ins only cover it up. Controlling the bacteria load inside the system removes the source.
            </p>
            <p class="text-base leading-7 text-brand-body">
              AeroGuard releases a sub-10-micron dry mist inside the air handler. The droplets are dry, so they do no harm to the electronics and mechanicals they land on. Unlike UV light, which only treats what its beam can reach, the mist touches every internal surface of the system, including the shadowed ones.
            </p>
            <p class="mx-auto max-w-3xl text-balance before:mx-auto before:mb-7 before:block before:h-1 before:w-12 before:rounded-full before:bg-botanical-500 before:content-[''] text-center text-lg font-semibold leading-8 text-brand-900 sm:text-xl md:col-span-2">
              We apply only enough to coat the system's internal components, not the whole home. Keeping biofilm and mold off the coil keeps air moving freely across it, which improves efficiency, lowers operating cost and extends the life of the equipment. Occupants won't even know AeroGuard is running. They will just notice a home that smells better and air that feels cleaner.
            </p>
          </div>
        </div>
      </section>

      <SectorCards
        heading="One platform, from a hall closet to a rooftop."
        prompt="Select a sector to see what is at stake"
        cards={sectorCards}
        checklist={checklist}
      />

      <!-- Health framing per Marty (2026-09-25). Figures: CDC asthma data (about
           1 in 12 Americans); EPA "The Inside Story" (indoor air 2-5x more
           polluted than outdoor; about 90% of time spent indoors). Marty's
           "all-time high due to poor IAQ" is not stated as fact: see Q32. -->
      <DifferenceGrid
        eyebrow="Why It Matters"
        heading="Poor Indoor Air Has A Health Cost."
        lede="About 1 in 12 Americans now lives with asthma. We spend roughly 90% of our time indoors, where the EPA finds air can be two to five times more polluted than outside. Mold, bacteria and allergens growing inside the HVAC ride that air into every room. AeroGuard stops them at the source."
        points={points}
        closing={{
          lead: 'The result: fewer asthma and allergy triggers in the air, and equipment that runs the way it was designed to.',
          aside: 'Every air handler is carrying the same wet, dark, dusty conditions. Genesis360 gives you a way to get ahead of the buildup instead of cleaning it out later.',
        }}
      />

      <PostsRow posts={hvacPosts} heading="From The Field" />

      <SectorCta
        eyebrow="Your Building. Your Coverage Plan."
        heading="Put Genesis360 To Work On Every Air Handler."
        copy="Tell us what the system serves and how it is maintained today. Our team will map the right AeroGuard configuration and build a practical coverage plan around it."
        href="/get-a-quote/"
      />
    </main>
    <Footer />
  </div>
</BaseLayout>
