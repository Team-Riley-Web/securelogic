---
// TEST PAGE v2 — not linked in nav. A closer match to blueland.com than v1.
// Palette, type scale, button geometry, and section order were sampled from the
// live site (computed styles + screenshots) rather than approximated:
//   navy #0B1057 · royal #133CD1 · bands #F0F7FF / #F6F9FE / #E1F2FF
//   Sailec → Figtree (nearest free geometric sans), body 13-16px, headings w500
//   CTAs: rounded-full, uppercase, letterspaced, 12-16px / 24-40px padding
import { ArrowRight, ChevronLeft, ChevronRight, Minus, Pause, Search, ShoppingCart, User } from '@lucide/astro';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import BenefitIcon from '../components/BenefitIcon.astro';
import CertMark from '../components/CertMark.astro';
import MegaMenu from '../components/MegaMenu.astro';
import { posts } from '../data/blog-posts';
import { megaMenus } from '../data/mega-menus';
import logo from '../assets/images/logo.png';
import greenhouse from '../assets/images/blog-greenhouse.png';
import wrestling from '../assets/images/blog-wrestling.png';
import cannabis from '../assets/images/blog-cannabis.png';
import sickBuilding from '../assets/images/blog-sick-building.png';
import botanimaxBottle from '../assets/images/botanimax-bottle.png';
import compact from '../assets/images/genesis-compact.png';
import inroom from '../assets/images/inroom-mist.png';
import hvacMist from '../assets/images/hvac-mist.png';
import mobileMist from '../assets/images/mobile-mist.png';
import medicalMist from '../assets/images/medical-mist.png';
import portableMist from '../assets/images/portable-mist.png';
import agri from '../assets/images/agri-guard.png';
import nozzles from '../assets/images/nozzles.png';

// "Shop By Category" — 8 tiles, same count/rhythm as the live grid.
const categories = [
  { title: 'Human', href: '/human/', image: wrestling, photo: true, copy: 'Schools, athletics, and healthcare where people gather' },
  { title: 'HVAC', href: '/hvac/', image: hvacMist, photo: false, copy: 'Ducts, coils, and vents kept clear of biofilm' },
  { title: 'Ag', href: '/ag/', image: agri, photo: false, copy: 'Barns, poultry houses, and indoor grow rooms' },
  { title: 'Genesis 360', href: '/genesis360mistingsystems/', image: compact, photo: false, copy: 'The automated misting platform, end to end' },
  { title: 'BotaniMax', href: '/botanimax/', image: botanimaxBottle, photo: false, copy: '150+ plant actives, EPA registered' },
  { title: 'Brochures', href: '/resources/brochures/', image: medicalMist, photo: false, copy: 'Industry guides for every facility type' },
  { title: 'Documentation', href: '/resources/documentation/', image: portableMist, photo: false, copy: 'Labels, SDS sheets, and lab reports' },
  { title: 'FAQs', href: '/resources/faqs/', image: inroom, photo: false, copy: 'Droplet physics, coverage, and maintenance' },
];

// The "4,000,000+ Homes Have Made the Switch" band.
const switchPoints: { icon: 'coverage' | 'precision' | 'botanical' | 'value'; title: string; copy: string }[] = [
  { icon: 'coverage', title: 'Powerfully Effective', copy: 'Sub-10 micron droplets reach what manual cleaning cannot' },
  { icon: 'precision', title: 'Physics-Based Precision', copy: 'Uniform atomization at roughly ⅓ oz per minute, per nozzle' },
  { icon: 'botanical', title: 'Clean Ingredients', copy: 'Botanical actives, safe around staff, livestock, and equipment' },
  { icon: 'value', title: 'Better Value', copy: 'Less labor, less chemical waste, lower total cost of ownership' },
];

const lineup = [
  { name: 'InRoomMist', image: inroom, tag: 'Fixed' },
  { name: 'HVACMist', image: hvacMist, tag: 'Integrated' },
  { name: 'Compact Mist', image: compact, tag: 'Compact' },
  { name: 'MobileMist', image: mobileMist, tag: 'Mobile' },
  { name: 'MedicalMist', image: medicalMist, tag: 'Clinical' },
  { name: 'PortableMist', image: portableMist, tag: 'Portable' },
  { name: 'AgriGuard', image: agri, tag: 'Agriculture' },
  { name: 'BotaniMax', image: botanimaxBottle, tag: 'Disinfectant' },
];

const certs = ['EPA Reg. No. 92089-2', 'Made in the USA', 'Patent-Pending', '150+ Plant Actives', 'Residual Efficacy'];

// Verified against the EPA master label PDF linked from /resources/documentation/
// and the live BotaniMax product copy. See CertMark.astro for why the federal
// EPA seal is not used here.
const certMarks: { kind: 'epa' | 'evp' | 'usa' | 'patent' | 'botanical'; caption: string }[] = [
  { kind: 'epa', caption: 'EPA Registered Disinfectant' },
  { kind: 'evp', caption: 'Emerging Viral Pathogen Claim' },
  { kind: 'botanical', caption: '150+ Plant-Derived Actives' },
  { kind: 'patent', caption: 'Patent-Pending Formula' },
  { kind: 'usa', caption: 'Made in the USA' },
];

const reviews = [
  { quote: "The barn that was treated had 30% less deads, 30% less culls, and went to market 10 pounds heavier.", name: 'Southwest Iowa Pig Farmer', product: 'AgriGuard Mist' },
  { quote: "It's been a game changer for us — healthier lambs, no coughing or diarrhea that you see in heated barns.", name: 'David Sark', product: 'BotaniMax' },
  { quote: "We went from having sow health issues to bringing in new sows and not having any issues!", name: 'Keaton Kitson', product: 'Genesis 360' },
];

const recentPosts = posts.slice(0, 4);

// Blueland splits its nav around the centred logo, so the menus split too.
const leftMenus = megaMenus.filter((m) => ['Human', 'HVAC', 'Ag'].includes(m.label));
const rightMenus = megaMenus.filter((m) => ['Resources', 'About Us'].includes(m.label));
---

<BaseLayout
  title="Secure Logic | Test Homepage v2 (Blueland style)"
  description="Design test v2: Secure Logic's homepage content matched closely to blueland.com — sampled palette, type scale, and section structure."
>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=Archivo:wght@600;700&display=swap');

    .bl2 {
      /* Sampled directly from blueland.com computed styles. */
      --navy: #0b1057;
      --royal: #133cd1;
      --royal-dark: #0f31ab;
      --band: #f0f7ff;
      --band-soft: #f6f9fe;
      --sky: #e1f2ff;
      --sky-mid: #a0ddff;
      --peri: #8bbcff;
      --mint: #c4eda4;
      --blush: #ffdfe8;
      /* Live site runs two families: Sailec for body/headings and GT-Pressura
         (font-secondary) for every uppercase display label. Both are licensed,
         so: Sailec → Figtree, GT-Pressura → Archivo (nearest free industrial
         grotesque). */
      font-family: Figtree, ui-sans-serif, system-ui, sans-serif;
      --font-secondary: Archivo, ui-sans-serif, system-ui, sans-serif;
      color: var(--navy);
      font-size: 16px;
    }

    .bl2 h1,
    .bl2 h2,
    .bl2 h3 {
      font-weight: 500;
      letter-spacing: -0.005em;
      color: var(--navy);
    }

    /* Headings placed on photography/royal bands opt out of the navy default. */
    .bl2 h1.on-dark,
    .bl2 h2.on-dark,
    .bl2 h3.on-dark {
      color: #fff;
    }

    /* Live site headings sit at w500, not bold — this is the tell that made v1
       read heavier than the real thing. */
    .bl2-h2 {
      font-size: clamp(1.75rem, 2.6vw, 2.4rem);
      line-height: 1.18;
    }

    /* Sampled: GT-Pressura 17px / w700 / ls 1px / uppercase */
    .bl2-eyebrow {
      font-family: var(--font-secondary);
      font-size: 17px;
      font-weight: 700;
      letter-spacing: 1px;
      text-transform: uppercase;
      color: var(--royal);
    }

    /* Sampled from the benefit row: GT-Pressura 20px / w700 / ls normal /
       line-height 26px / uppercase. The live classes carry `!tracking-normal`,
       which cancels the inherited tracking — so these are NOT letterspaced. */
    .bl2-label {
      font-family: var(--font-secondary);
      font-size: 20px;
      font-weight: 700;
      letter-spacing: normal;
      line-height: 26px;
      text-transform: uppercase;
      color: var(--royal);
    }

    .bl2-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      border-radius: 9999px;
      background: var(--royal);
      color: #fff;
      font-size: 0.82rem;
      font-weight: 700;
      letter-spacing: 0.07em;
      text-transform: uppercase;
      padding: 1rem 2.4rem;
      transition: background 0.2s ease;
      white-space: nowrap;
    }

    .bl2-btn:hover { background: var(--royal-dark); }

    .bl2-btn-ghost {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      border-radius: 9999px;
      background: #fff;
      color: var(--royal);
      border: 1.5px solid var(--royal);
      font-size: 0.82rem;
      font-weight: 700;
      letter-spacing: 0.07em;
      text-transform: uppercase;
      padding: 0.85rem 2rem;
      transition: background 0.2s ease;
      white-space: nowrap;
    }

    .bl2-btn-ghost:hover { background: var(--band); }

    /* Category tiles: label is a royal-blue link with a trailing arrow that
       nudges on hover, exactly like the live grid. */
    .bl2-cat-label {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 0.86rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--royal);
    }

    .bl2-cat:hover .bl2-arrow { transform: translateX(4px); }
    .bl2-arrow { transition: transform 0.2s ease; }

    .bl2-chip {
      display: inline-flex;
      align-items: center;
      border-radius: 9999px;
      border: 1.5px solid var(--peri);
      background: #fff;
      color: var(--navy);
      font-size: 0.78rem;
      font-weight: 600;
      padding: 0.5rem 1.05rem;
    }

    .bl2-marq { animation: bl2-marq 26s linear infinite; }
    @keyframes bl2-marq {
      from { transform: translateX(0); }
      to { transform: translateX(-50%); }
    }
    @media (prefers-reduced-motion: reduce) {
      .bl2-marq { animation: none; }
    }
  </style>

  <div class="bl2 bg-white">
    <!-- Announcement bar: sky gradient, navy text, chevrons at both edges -->
    <div class="relative flex items-center justify-center px-12 py-3 text-center" style="background: linear-gradient(90deg,var(--sky-mid),var(--sky),var(--peri));">
      <ChevronLeft class="absolute left-4 h-4 w-4" style="color: var(--navy);" aria-hidden="true" />
      <p class="text-[13px] font-medium" style="color: var(--navy);">
        New: 360HVAC Mist for facility air systems &nbsp;|&nbsp;
        <a href="/hvac/" class="underline underline-offset-2">Explore the platform →</a>
      </p>
      <ChevronRight class="absolute right-4 h-4 w-4" style="color: var(--navy);" aria-hidden="true" />
    </div>

    <!-- Header: split nav with centered logo, icon cluster right.
         `relative` anchors the mega-menu panel (it uses top-full). -->
    <header
      class="relative z-50 bg-white"
      style="--mm-accent: var(--royal); --mm-ink: var(--navy); --mm-tile-bg: var(--band-soft); --mm-tile-hover-bg: var(--sky); --mm-foot-bg: var(--band); --mm-row-hover-bg: var(--band-soft); --mm-border: #e6eefb; --mm-label-font: var(--font-secondary); --mm-trigger-size: 15px;"
    >
      <div class="mx-auto flex max-w-[1400px] items-center justify-between gap-6 px-6 py-5">
        <MegaMenu menus={leftMenus} />
        <a href="/" class="mx-auto lg:mx-0" aria-label="Secure Logic home">
          <Image src={logo} alt="Secure Logic logo" class="h-10 w-auto object-contain" widths={[120, 180, 240]} sizes="150px" />
        </a>
        <div class="flex items-center gap-6">
          <MegaMenu menus={rightMenus} />
          <div class="flex items-center gap-4">
            <Search class="h-5 w-5" aria-hidden="true" />
            <a href="/contact-us/" aria-label="Contact"><User class="h-5 w-5" aria-hidden="true" /></a>
            <a href="/get-a-quote/" aria-label="Get a quote"><ShoppingCart class="h-5 w-5" aria-hidden="true" /></a>
          </div>
        </div>
      </div>
      <!-- Sub-nav strip with the divider the live site puts after the 3rd item -->
      <div class="hidden justify-center gap-8 py-3.5 text-[13px] font-medium lg:flex" style="background: var(--band);">
        <a href="/human/">Human</a>
        <a href="/hvac/">HVAC</a>
        <a href="/ag/">Ag</a>
        <span aria-hidden="true" style="color: var(--peri);">|</span>
        <a href="/genesis360mistingsystems/">Genesis 360</a>
        <a href="/botanimax/">BotaniMax</a>
        <a href="/resources/brochures/">Brochures</a>
        <a href="/resources/faqs/">FAQs</a>
        <a href="/blogs/">Blog</a>
      </div>
    </header>

    <!-- Hero: full-bleed photo, centered lockup + uppercase pill -->
    <section class="relative isolate overflow-hidden">
      <Image src={greenhouse} alt="" class="absolute inset-0 h-full w-full object-cover" widths={[960, 1440, 1920]} sizes="100vw" aria-hidden="true" />
      <!-- Live hero keeps type legible over busy photography with a dark wash
           plus a stronger gradient from the bottom where the copy sits. -->
      <div class="absolute inset-0 bg-slate-950/45"></div>
      <div class="absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-slate-950/75 to-transparent"></div>
      <div class="relative mx-auto flex min-h-[560px] max-w-4xl flex-col items-center justify-end px-6 pb-16 pt-32 text-center text-white">
        <p class="text-[2.1rem] font-bold italic leading-none tracking-tight drop-shadow sm:text-[2.6rem]">
          Genesis 360<span class="ml-2 not-italic font-medium" style="color: var(--sky-mid);">Misting Systems</span>
        </p>
        <h1 class="on-dark mt-5 text-[clamp(1.9rem,3.6vw,3rem)] font-medium leading-[1.15]">Engineering Better Environments.</h1>
        <p class="mt-4 max-w-2xl text-[17px] leading-relaxed text-white/90">Automated dry mist that treats air and surfaces together — the same way, every cycle.</p>
        <a href="/get-a-quote/" class="bl2-btn mt-8">Get a quote</a>
      </div>
    </section>

    <!-- Shop By Category -->
    <section class="px-6 py-20">
      <div class="mx-auto max-w-[1200px] text-center">
        <h2 class="bl2-h2">Shop By Application</h2>
        <p class="mx-auto mt-3 max-w-2xl text-[15px] text-slate-600">Explore every Genesis 360 and BotaniMax deployment, organized by the environment it protects.</p>
      </div>
      <div class="mx-auto mt-12 grid max-w-[1200px] gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
        {categories.map(({ title, href, image, copy, photo }) => (
          <a href={href} class="bl2-cat group text-left">
            <div class="overflow-hidden rounded-lg" style="background: var(--band-soft);">
              <Image
                src={image}
                alt=""
                class:list={['aspect-[4/3] w-full transition duration-300 group-hover:scale-[1.04]', photo ? 'object-cover' : 'object-contain p-7']}
                widths={[240, 380]}
                sizes="260px"
              />
            </div>
            <p class="bl2-cat-label mt-4">{title} <ArrowRight class="bl2-arrow h-3.5 w-3.5" aria-hidden="true" /></p>
            <p class="mt-1.5 text-[14px] leading-6 text-slate-600">{copy}</p>
          </a>
        ))}
      </div>
      <div class="mt-12 text-center">
        <a href="/genesis360mistingsystems/" class="bl2-btn">Or scope a full system</a>
      </div>
    </section>

    <!-- "Made the switch" band -->
    <section class="px-6 py-20" style="background: var(--band);">
      <div class="mx-auto max-w-[1100px] text-center">
        <h2 class="bl2-h2">Sub-10 Micron Mist. 360° Coverage.</h2>
        <div class="mt-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
          {switchPoints.map(({ icon, title, copy }) => (
            <div>
              <!-- 160px to match blueland.com's benefit glyphs -->
              <div class="mx-auto h-40 w-40" style="color: var(--royal);">
                <BenefitIcon kind={icon} />
              </div>
              <p class="bl2-label mt-3">{title}</p>
              <p class="mt-2.5 text-[15px] leading-6 text-slate-600">{copy}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Featured lineup -->
    <section class="px-6 py-20">
      <div class="mx-auto max-w-[1200px] text-center">
        <h2 class="bl2-h2">The Genesis 360 Lineup</h2>
        <p class="mx-auto mt-3 max-w-2xl text-[15px] text-slate-600">One platform, adapted to the space it protects — proven across facilities, over and over again.</p>
      </div>
      <div class="mx-auto mt-12 grid max-w-[1200px] gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {lineup.map(({ name, image, tag }) => (
          <article class="rounded-lg p-5 text-center" style="background: var(--band-soft);">
            <div class="relative">
              <span class="absolute left-0 top-0 rounded-full px-2.5 py-1 text-[11px] font-semibold" style="background: var(--mint); color: var(--navy);">{tag}</span>
              <Image src={image} alt={name} class="mx-auto aspect-square w-full object-contain p-5" widths={[220, 340]} sizes="240px" />
            </div>
            <h3 class="mt-2 text-[15px] font-semibold">{name}</h3>
            <a href="/genesis360mistingsystems/" class="mt-3 inline-block text-[13px] font-semibold underline underline-offset-4" style="color: var(--royal);">Learn more</a>
          </article>
        ))}
      </div>
      <div class="mt-12 text-center">
        <a href="/genesis360mistingsystems/" class="bl2-btn-ghost">Shop all systems</a>
      </div>
    </section>

    <!-- Press coverage / certifications band -->
    <section class="px-6 py-20 text-center" style="background: var(--band);">
      <p class="bl2-eyebrow">Certifications &amp; Compliance</p>
      <h2 class="mx-auto mt-6 max-w-3xl text-[clamp(1.6rem,3vw,2.5rem)] font-medium" style="color: var(--royal);">"An Emerging Viral Pathogen Disinfectant"</h2>

      <!-- Seal row, mirroring Blueland's B Corp / Climate Neutral badge strip -->
      <div class="mx-auto mt-14 flex max-w-5xl flex-wrap items-start justify-center gap-x-14 gap-y-10">
        {certMarks.map(({ kind, caption }) => (
          <div class="flex w-[132px] flex-col items-center">
            <div class="h-[88px] w-[88px]" style="color: var(--royal);">
              <CertMark kind={kind} />
            </div>
            <p class="mt-4 text-[13px] font-semibold leading-5" style="color: var(--navy);">{caption}</p>
          </div>
        ))}
      </div>

      <!-- Variant B: glyph-only marks (EPA keeps its number — that text is the mark) -->
      <div class="mx-auto mt-16 max-w-5xl border-t pt-14" style="border-color: var(--peri);">
        <p class="text-[11px] font-bold uppercase tracking-[0.12em]" style="color: var(--peri);">Variant B · icon only</p>
        <div class="mt-10 flex flex-wrap items-start justify-center gap-x-14 gap-y-10">
          {certMarks.map(({ kind, caption }) => (
            <div class="flex w-[132px] flex-col items-center">
              <div class="h-[88px] w-[88px]" style="color: var(--royal);">
                <CertMark kind={kind} variant="icon" />
              </div>
              <p class="mt-4 text-[13px] font-semibold leading-5" style="color: var(--navy);">{caption}</p>
            </div>
          ))}
        </div>
      </div>

      <p class="mx-auto mt-14 max-w-2xl text-[12.5px] leading-5 text-slate-500">
        BotaniMax® is registered under EPA Reg. No. 92089-2. EPA registration indicates the product's
        labeling and efficacy data were reviewed and accepted; it does not constitute endorsement by
        the U.S. Environmental Protection Agency.
      </p>
    </section>

    <!-- Full-bleed photo with overlapping card -->
    <section class="relative">
      <Image src={cannabis} alt="Indoor grow room treated with Genesis 360 dry mist" class="h-[460px] w-full object-cover sm:h-[560px]" widths={[960, 1440]} sizes="100vw" />
      <div class="relative z-10 px-6">
        <div class="mx-auto -mt-28 max-w-[1200px] sm:-mt-32">
          <!-- z-10 needed: without a stacking context the replaced <img> paints
               over the card's background but not its text. -->
          <div class="relative z-10 ml-auto max-w-md rounded-lg bg-white p-8 shadow-xl sm:p-10">
            <h2 class="text-[clamp(1.5rem,2.4vw,2rem)] font-medium leading-tight">A Clean the Whole Planet Can Feel</h2>
            <p class="mt-4 text-[15px] leading-7 text-slate-600">BotaniMax is built from 150+ plant actives — an EPA-registered botanical disinfectant that controls bacteria, viruses, and fungi without harsh synthetics.</p>
            <a href="/botanimax/" class="bl2-btn mt-7">Shop BotaniMax</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Reviews: solid royal band, bordered carousel card, controls -->
    <section class="mt-20 overflow-hidden px-6 py-20 text-center" style="background: var(--royal);">
      <h2 class="on-dark text-[clamp(1.6rem,3vw,2.4rem)] font-medium">Trusted Where It Counts</h2>
      <div class="relative mx-auto mt-12 max-w-[1100px]">
        <div class="grid gap-6 lg:grid-cols-3">
          {reviews.map(({ quote, name, product }, i) => (
            <figure
              class="rounded-lg border border-white/40 p-8"
              style={i === 1 ? 'opacity:1' : 'opacity:.45'}
            >
              <div class="flex justify-center gap-1 text-white" aria-label="5 out of 5 stars">
                {[0, 1, 2, 3, 4].map(() => (
                  <svg viewBox="0 0 20 20" class="h-4 w-4" fill="currentColor" aria-hidden="true"><path d="M10 1.6l2.6 5.3 5.8.8-4.2 4.1 1 5.8L10 14.9 4.8 17.6l1-5.8L1.6 7.7l5.8-.8L10 1.6z"/></svg>
                ))}
              </div>
              <blockquote class="mt-6 text-[17px] leading-8 text-white">"{quote}"</blockquote>
              <figcaption class="mt-6 text-[14px] text-white/90">
                – {name} on <span class="font-bold uppercase tracking-wide underline underline-offset-4">{product}</span>
              </figcaption>
            </figure>
          ))}
        </div>
        <div class="mt-10 flex items-center justify-center gap-5 text-white">
          <button type="button" aria-label="Previous review"><ChevronLeft class="h-5 w-5" /></button>
          <div class="flex items-center gap-2.5">
            {[0, 1, 2].map((i) => (
              <span class="block h-2 w-2 rounded-full" style={i === 1 ? 'background:#fff' : 'border:1px solid rgb(255 255 255 / .7)'}></span>
            ))}
          </div>
          <Pause class="h-4 w-4" aria-hidden="true" />
          <button type="button" aria-label="Next review"><ChevronRight class="h-5 w-5" /></button>
        </div>
      </div>
    </section>

    <!-- How it works: split with image right -->
    <section class="px-6 py-24">
      <div class="mx-auto grid max-w-[1200px] items-center gap-16 lg:grid-cols-2">
        <div>
          <h2 class="bl2-h2">How It Works</h2>
          <p class="mt-5 text-[15px] leading-7 text-slate-600">One platform, configured once. Each nozzle atomizes at roughly ⅓ oz per minute, holding a consistent particle size so every cycle lands the same — dry to the touch, residue-free, safe for electronics and sensitive surfaces.</p>
          <a href="/about-us/technology/" class="bl2-btn-ghost mt-8">How it works</a>
        </div>
        <div class="overflow-hidden rounded-lg" style="background: var(--band-soft);">
