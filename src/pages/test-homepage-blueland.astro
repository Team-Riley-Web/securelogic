---
// TEST PAGE — not linked in nav. Recreates the real homepage's content using
// Blueland.com's visual language (bold rounded-pill CTAs, saturated royal-blue
// palette, light-blue trust bands, deep-blue testimonial + footer blocks,
// centered hero over full-bleed photography).
import { ArrowRight, ChevronLeft, ChevronRight, Mail, Phone, Quote, Sparkles } from '@lucide/astro';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CurveDivider from '../components/CurveDivider.astro';
import MegaMenu from '../components/MegaMenu.astro';
import { posts } from '../data/blog-posts';
import { megaMenus } from '../data/mega-menus';
import logo from '../assets/images/logo.png';
import farmVideo from '../assets/videos/farm.mp4';
import cannabisVideo from '../assets/videos/cannabis.mp4';
import gymVideo from '../assets/videos/gym.mp4';
import cowsVideo from '../assets/videos/cows.mp4';
import botanimaxBottle from '../assets/images/botanimax-bottle.png';
import botanimaxLogo from '../assets/images/botanimax-logo.png';
import compact from '../assets/images/genesis-compact.png';
import inroom from '../assets/images/inroom-mist.png';
import hvacMist from '../assets/images/hvac-mist.png';
import mobileMist from '../assets/images/mobile-mist.png';
import agri from '../assets/images/agri-guard.png';
import portableMist from '../assets/images/portable-mist.png';
import farmer1 from '../assets/images/farmer1.png';
import farmer2 from '../assets/images/farmer2.png';
import farmer3 from '../assets/images/farmer3.png';
import physics from '../assets/images/physics-icon.png';
import wrestling from '../assets/images/blog-wrestling.png';

const categories = [
  { title: 'Human', href: '/human/', image: wrestling, photo: true, copy: 'Wrestling rooms, hospitals, and shared facilities' },
  { title: 'HVAC', href: '/hvac/', image: hvacMist, photo: false, copy: 'Ducts, coils, and vents kept free of biofilm' },
  { title: 'Ag', href: '/ag/', image: agri, photo: false, copy: 'Barns, greenhouses, and grow rooms' },
  { title: 'Genesis 360', href: '/genesis360mistingsystems/', image: compact, photo: false, copy: 'The automated misting platform' },
  { title: 'BotaniMax', href: '/botanimax/', image: botanimaxBottle, photo: false, copy: '150+ plant actives, EPA registered' },
];

const trustStats = [
  { label: 'Sub-10 μm', copy: 'Dry-mist droplet size that behaves like a vapor', icon: Sparkles },
  { label: '360°', copy: 'Air and surface coverage, every cycle', icon: Sparkles },
  { label: 'Automated', copy: 'Programmable, repeatable disinfection cycles', icon: Sparkles },
  { label: 'EPA 2(c)', copy: 'Registered botanical disinfectant formula', icon: Sparkles },
];

const systems = [
  { name: 'InRoomMist', image: inroom },
  { name: 'HVACMist', image: hvacMist },
  { name: 'Compact Mist', image: compact },
  { name: 'MobileMist', image: mobileMist },
  { name: 'AgriGuard', image: agri },
  { name: 'PortableMist', image: portableMist },
];

const badges = ['EPA 2(c) Registered', 'Made in the USA', 'Patent-Pending Formula', '150+ Plant Actives', 'Residual Clean Efficacy'];

const testimonials = [
  { quote: "Using BAC Ag has been a huge success in our show pig operation! We went from having sow health issues to bringing in new sows and not having any issues!", name: 'Keaton Kitson', role: 'Owner, Kitson Show Pigs', image: farmer1 },
  { quote: 'I did a trial where I treated one barn with BAC Ag and not the other. The treated barn had 30% less deads, 30% less culls, and went to market 10 pounds heavier.', name: 'Southwest Iowa Pig Farmer', role: 'Pork Producer', image: farmer2 },
  { quote: "It's been a game changer for us — not only taking away the terrible smell in the barns, but healthier lambs, no coughing or diarrhea that you see in heated barns.", name: 'David Sark', role: 'Farmer', image: farmer3 },
];

const switchReasons = [
  'True whole-room disinfection, not just wiped surfaces',
  'Automated, remote-capable operation cuts labor dependence',
  'Environmentally neutral — no residue, no humidity shift',
  'One platform across HVAC, in-room, medical, and ag use',
];

const recentPosts = posts.slice(0, 3);

// Nav splits around the centred logo, so the menus split too.
const leftMenus = megaMenus.filter((m) => ['Human', 'HVAC', 'Ag'].includes(m.label));
const rightMenus = megaMenus.filter((m) => ['Resources', 'About Us'].includes(m.label));
---

<BaseLayout
  title="Secure Logic | Test Homepage (Blueland style)"
  description="Design test: Secure Logic's real homepage content restyled after blueland.com — bold pill CTAs, royal-blue palette, and trust-band layout."
>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700;800&display=swap');

    .bl {
      --bl-blue: #1d3fd6;
      --bl-blue-dark: #142e9e;
      --bl-ink: #10204a;
      --bl-sky: #e3edff;
      font-family: 'Poppins', ui-sans-serif, system-ui, sans-serif;
      color: var(--bl-ink);
    }

    .bl h1,
    .bl h2,
    .bl h3 {
      font-family: 'Poppins', ui-sans-serif, system-ui, sans-serif;
      font-weight: 700;
      letter-spacing: -0.01em;
    }

    .bl-pill {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      border-radius: 999px;
      background: var(--bl-blue);
      color: #fff;
      font-weight: 700;
      font-size: 0.8rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      padding: 0.9rem 1.9rem;
      transition: background 0.2s ease, transform 0.2s ease;
      white-space: nowrap;
    }

    .bl-pill:hover {
      background: var(--bl-blue-dark);
      transform: translateY(-1px);
    }

    .bl-pill-outline {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      border-radius: 999px;
      background: #fff;
      color: var(--bl-blue);
      font-weight: 700;
      font-size: 0.75rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      padding: 0.8rem 1.7rem;
      box-shadow: 0 1px 2px rgb(16 32 74 / 0.08);
      transition: background 0.2s ease;
    }

    .bl-pill-outline:hover {
      background: var(--bl-sky);
    }

    .bl-badge {
      display: inline-flex;
      align-items: center;
      border-radius: 999px;
      border: 1.5px solid var(--bl-blue);
      color: var(--bl-blue-dark);
      font-weight: 700;
      font-size: 0.75rem;
      letter-spacing: 0.02em;
      padding: 0.55rem 1.1rem;
      background: #fff;
    }
  </style>

  <div class="bl bg-white">
    <!-- Announcement bar -->
    <div class="flex items-center justify-center gap-6 px-4 py-2.5 text-center text-xs font-semibold uppercase tracking-[0.08em] text-white" style="background: var(--bl-blue);">
      <ChevronLeft class="h-4 w-4 opacity-60" aria-hidden="true" />
      <span>Automated, Whole-Room Disinfection &nbsp;|&nbsp; <a href="/get-a-quote/" class="underline decoration-white/50 underline-offset-2">Get A Quote →</a></span>
      <ChevronRight class="h-4 w-4 opacity-60" aria-hidden="true" />
    </div>

    <!-- Header — `relative` anchors the mega-menu panel (it uses top-full). -->
    <header
      class="relative z-50 border-b border-slate-100 bg-white"
      style="--mm-accent: var(--bl-blue); --mm-ink: var(--bl-ink); --mm-tile-bg: var(--bl-sky); --mm-tile-hover-bg: #d3e0ff; --mm-foot-bg: #f7faff; --mm-row-hover-bg: #f7faff; --mm-border: #e5ecfa; --mm-trigger-size: 14px;"
    >
      <div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-6 py-5">
        <MegaMenu menus={leftMenus} class="font-semibold" />
        <a href="/" class="flex items-center gap-2" aria-label="Secure Logic home">
          <Image src={logo} alt="Secure Logic logo" class="h-10 w-auto object-contain" widths={[120, 180]} sizes="120px" />
        </a>
        <div class="flex items-center gap-4">
          <MegaMenu menus={rightMenus} class="font-semibold" />
          <a href="/get-a-quote/" class="bl-pill">Get A Quote</a>
        </div>
      </div>
      <div class="hidden justify-center gap-8 border-t border-slate-100 py-3 text-sm font-semibold lg:flex" style="background: var(--bl-sky); color: var(--bl-ink);">
        <a href="/human/" class="hover:opacity-70">Human</a>
        <a href="/hvac/" class="hover:opacity-70">HVAC</a>
        <a href="/ag/" class="hover:opacity-70">Ag</a>
        <a href="/genesis360mistingsystems/" class="hover:opacity-70">Genesis 360</a>
        <a href="/botanimax/" class="hover:opacity-70">BotaniMax</a>
        <a href="/resources/" class="hover:opacity-70">Resources</a>
      </div>
    </header>

    <!-- Hero — ported from the live homepage (index.astro): crossfading video
         bed, mist blooms, and the typed "Environments." headline. Subhead and
         CTA are kept from this page's original hero. -->
    <section class="relative isolate overflow-visible bg-canopy text-white">
      <div class="absolute inset-0">
        <video
          class="absolute inset-0 h-full w-full object-cover opacity-95 transition-opacity duration-1000 ease-in-out"
          src={farmVideo}
          autoplay
          muted
          loop
          playsinline
          preload="auto"
          aria-hidden="true"
          data-hero-slide="0"
        ></video>
        <video
          class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-1000 ease-in-out"
          src={cannabisVideo}
          muted
          loop
          playsinline
          preload="metadata"
          aria-hidden="true"
          data-hero-slide="1"
        ></video>
        <video
          class="absolute bottom-0 left-0 h-full w-full object-cover opacity-0 transition-opacity duration-1000 ease-in-out"
          src={gymVideo}
          muted
          loop
          playsinline
          preload="metadata"
          aria-hidden="true"
          data-hero-slide="2"
        ></video>
        <video
          class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-1000 ease-in-out"
          src={cowsVideo}
          muted
          loop
          playsinline
          preload="metadata"
          aria-hidden="true"
          data-hero-slide="3"
        ></video>
      </div>
      <div class="absolute inset-0 bg-[linear-gradient(0deg,hsl(160_34%_14%/.85)_0%,hsl(160_34%_14%/.55)_46%,hsl(160_34%_14%/.35)_100%)]"></div>
      <div class="pointer-events-none absolute inset-0 overflow-hidden">
        <div class="absolute -bottom-24 left-0 h-96 w-3/4 rounded-full bg-botanical-300/10 blur-3xl motion-safe:animate-[mist_18s_ease-in-out_infinite_alternate]"></div>
        <div class="absolute -right-28 top-4 h-96 w-2/3 rounded-full bg-white/10 blur-3xl motion-safe:animate-[mist_24s_ease-in-out_infinite_alternate]"></div>
      </div>
      <div class="container-page relative grid min-h-[min(92vh,820px)] place-items-center py-20 text-center">
        <div>
          <h1 class="mx-auto max-w-[16ch] text-[clamp(2.75rem,6.5vw,5.75rem)] font-bold leading-[1.05] tracking-tight text-white">
            <span class="sr-only">Engineering Better Environments.</span>
            <span aria-hidden="true">
              Engineering Better
              <span class="typed-hero-shell mx-auto block" aria-hidden="true">
                <span class="typed-hero-reserve" aria-hidden="true">Environments.</span>
                <span class="typed-hero-word" data-typed-hero-word>Environments.</span>
              </span>
            </span>
          </h1>
          <p class="mx-auto mt-6 max-w-xl text-lg font-medium text-white/90">Automated dry-mist disinfection engineered for facilities that can't afford inconsistency.</p>
          <a href="/get-a-quote/" class="bl-pill mt-8">Get A Quote</a>
        </div>
      </div>
      <CurveDivider class="-bottom-px text-white" />
    </section>

    <!-- Shop by category -->
    <section class="px-6 py-20">
      <div class="mx-auto max-w-6xl text-center">
        <h2 class="text-3xl sm:text-4xl">Explore By Application</h2>
        <p class="mx-auto mt-3 max-w-xl text-slate-600">Every Genesis 360 and BotaniMax deployment, organized by where it's used.</p>
      </div>
      <div class="mx-auto mt-12 grid max-w-6xl gap-6 sm:grid-cols-3 lg:grid-cols-5">
        {categories.map(({ title, href, image, copy, photo }) => (
          <a href={href} class="group text-left">
            <div class="overflow-hidden rounded-2xl bg-slate-100">
              <Image
                src={image}
                alt=""
                class:list={['aspect-square w-full transition duration-300 group-hover:scale-105', photo ? 'object-cover' : 'object-contain p-6']}
                widths={[200, 320]}
                sizes="220px"
              />
            </div>
            <p class="mt-4 inline-flex items-center gap-1.5 text-base font-bold" style="color: var(--bl-blue);">
              {title} <ArrowRight class="h-4 w-4 transition group-hover:translate-x-1" />
            </p>
            <p class="mt-1 text-sm leading-6 text-slate-600">{copy}</p>
          </a>
        ))}
      </div>
      <div class="mt-12 text-center">
        <a href="/genesis360mistingsystems/" class="bl-pill">See The Full Platform</a>
      </div>
    </section>

    <!-- Trust band -->
    <section class="px-6 py-20" style="background: var(--bl-sky);">
      <div class="mx-auto max-w-5xl text-center">
        <h2 class="text-3xl sm:text-4xl">Engineered for Facilities That Can't Afford Inconsistency.</h2>
        <div class="mt-12 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
          {trustStats.map(({ label, copy, icon: Icon }) => (
            <div>
              <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-white" style="color: var(--bl-blue);">
                <Icon class="h-7 w-7" aria-hidden="true" />
              </div>
              <p class="mt-4 text-xl font-extrabold" style="color: var(--bl-blue);">{label}</p>
              <p class="mt-2 text-sm leading-6 text-slate-600">{copy}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Platform grid ("Bestsellers") -->
    <section class="px-6 py-20">
      <div class="mx-auto max-w-6xl text-center">
        <h2 class="text-3xl sm:text-4xl">The Genesis 360 Platform</h2>
        <p class="mx-auto mt-3 max-w-xl text-slate-600">One family of automated misting systems, built on the same core technology.</p>
      </div>
      <div class="mx-auto mt-12 grid max-w-6xl gap-6 sm:grid-cols-3 lg:grid-cols-6">
        {systems.map(({ name, image }) => (
          <div class="rounded-2xl bg-slate-100 p-4 text-center">
            <Image src={image} alt={name} class="mx-auto aspect-square w-full object-contain" widths={[160, 240]} sizes="140px" />
            <p class="mt-3 text-sm font-bold" style="color: var(--bl-ink);">{name}</p>
          </div>
        ))}
      </div>
      <div class="mt-12 text-center">
        <a href="/genesis360mistingsystems/" class="bl-pill">Shop All Systems</a>
      </div>
    </section>

    <!-- Certifications strip -->
    <section class="px-6 py-14" style="background: var(--bl-sky);">
      <div class="mx-auto max-w-5xl text-center">
        <p class="text-xs font-bold uppercase tracking-[0.16em]" style="color: var(--bl-blue);">Certifications &amp; Compliance</p>
        <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
          {badges.map((badge) => (
            <span class="bl-badge">{badge}</span>
          ))}
        </div>
      </div>
    </section>

    <!-- Split feature: BotaniMax -->
    <section class="px-6 py-24">
      <div class="mx-auto grid max-w-6xl items-center gap-14 lg:grid-cols-2">
        <div class="order-2 grid place-items-center rounded-2xl bg-slate-100 p-10 lg:order-1">
          <Image src={botanimaxLogo} alt="BotaniMax logo" class="h-24 w-24 object-contain" widths={[160, 240]} sizes="120px" />
          <Image src={botanimaxBottle} alt="BotaniMax bottle" class="mt-6 h-64 object-contain" widths={[260, 420]} sizes="260px" />
        </div>
        <div class="order-1 lg:order-2">
          <p class="text-xs font-bold uppercase tracking-[0.16em]" style="color: var(--bl-blue);">Botanical Disinfectant</p>
          <h2 class="mt-3 text-3xl sm:text-4xl">A Clean the Planet Can Feel Good About.</h2>
          <p class="mt-5 text-base leading-7 text-slate-600">BotaniMax is crafted from 150+ plant actives — a patent-pending, EPA-registered disinfectant that controls bacteria, viruses, and fungi without harsh synthetics.</p>
          <a href="/botanimax/" class="bl-pill mt-8">Shop BotaniMax</a>
        </div>
      </div>
    </section>

    <!-- Testimonials (deep blue band) -->
    <section class="px-6 py-24 text-white" style="background: var(--bl-ink);">
      <div class="mx-auto max-w-4xl text-center">
        <h2 class="text-3xl text-white sm:text-4xl">Trusted By The People Who Depend On It.</h2>
        <div class="mt-12 grid gap-8 sm:grid-cols-3">
          {testimonials.map(({ quote, name, role }) => (
            <figure class="rounded-2xl bg-white/10 p-6 text-left">
              <Quote class="h-5 w-5 text-white/50" aria-hidden="true" />
              <blockquote class="mt-4 text-sm leading-6 text-white/85">{quote}</blockquote>
              <figcaption class="mt-5 text-sm font-bold text-white">{name}<span class="block font-medium text-white/60">{role}</span></figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section class="px-6 py-24">
      <div class="mx-auto grid max-w-6xl items-center gap-14 lg:grid-cols-2">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.16em]" style="color: var(--bl-blue);">How It Works</p>
          <h2 class="mt-3 text-3xl sm:text-4xl">Droplet Behavior Defines Performance.</h2>
          <p class="mt-5 text-base leading-7 text-slate-600">Every nozzle produces a uniform stream of sub-10 µm dry-mist droplets — small enough to stay airborne, light enough to behave like a vapor, and engineered to surround airborne and surface-bound particles with measurable consistency.</p>
          <a href="/genesis360mistingsystems/" class="bl-pill mt-8">See How It Works</a>
        </div>
        <div class="rounded-2xl bg-slate-100 p-10">
          <Image src={physics} alt="Physics-based precision misting icon" class="mx-auto h-48 w-48 object-contain" widths={[200, 320]} sizes="200px" />
        </div>
      </div>
    </section>

    <!-- Why switch checklist -->
    <section class="px-6 py-24" style="background: var(--bl-sky);">
      <div class="mx-auto grid max-w-6xl items-center gap-14 lg:grid-cols-2">
        <div class="rounded-2xl bg-white p-10">
          <Image src={compact} alt="Genesis Compact misting system" class="mx-auto h-56 w-56 object-contain" widths={[200, 320]} sizes="220px" />
        </div>
        <div>
          <h2 class="text-3xl sm:text-4xl">Why Facilities Switch To Genesis 360.</h2>
          <ul class="mt-6 grid gap-4">
            {switchReasons.map((reason) => (
              <li class="flex items-start gap-3 text-base leading-7 text-slate-700">
                <span class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full text-white" style="background: var(--bl-blue);">
                  <svg viewBox="0 0 20 20" fill="none" class="h-3 w-3" stroke="currentColor" stroke-width="2.5"><path d="M4 10l4 4 8-8" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </span>
                {reason}
              </li>
            ))}
          </ul>
          <a href="/genesis360mistingsystems/" class="bl-pill mt-8">Learn About The Platform</a>
        </div>
      </div>
    </section>

    <!-- From the field (blog teaser) -->
    <section class="px-6 py-24">
      <div class="mx-auto max-w-6xl text-center">
        <h2 class="text-3xl sm:text-4xl">From The Field</h2>
        <p class="mx-auto mt-3 max-w-xl text-slate-600">Insights on botanical disinfectants, misting systems, and indoor air quality.</p>
      </div>
      <div class="mx-auto mt-12 grid max-w-5xl gap-6 sm:grid-cols-3">
        {recentPosts.map((post) => (
          <a href={`/blogs/${post.slug}/`} class="group overflow-hidden rounded-2xl bg-slate-100">
            <Image src={post.image} alt={post.imageAlt} class="aspect-square w-full object-cover transition duration-300 group-hover:scale-105" widths={[280, 420]} sizes="280px" />
          </a>
        ))}
      </div>
      <div class="mt-10 text-center">
        <a href="/blogs/" class="bl-pill-outline" style="border: 1.5px solid var(--bl-blue);">Read The Blog</a>
      </div>
    </section>

    <!-- Final CTA (mist clouds) -->
    <section class="relative overflow-hidden px-6 py-28 text-center" style="background: var(--bl-sky);">
      <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
        <div class="absolute -bottom-16 left-[8%] h-40 w-40 rounded-full bg-white/70 blur-2xl"></div>
        <div class="absolute -bottom-10 left-[28%] h-28 w-28 rounded-full bg-white/60 blur-2xl"></div>
        <div class="absolute -bottom-20 right-[15%] h-48 w-48 rounded-full bg-white/70 blur-2xl"></div>
        <div class="absolute -bottom-8 right-[35%] h-24 w-24 rounded-full bg-white/60 blur-2xl"></div>
      </div>
      <div class="relative">
        <h2 class="text-3xl sm:text-4xl" style="color: var(--bl-blue-dark);">Start Protecting Your Facility.</h2>
        <a href="/get-a-quote/" class="bl-pill mt-8">Get A Quote</a>
      </div>
    </section>

    <!-- Footer -->
    <footer class="px-6 py-16 text-white" style="background: var(--bl-blue);">
      <div class="mx-auto grid max-w-6xl gap-10 md:grid-cols-[1.3fr_1fr_1fr_1fr]">
        <div>
          <h3 class="text-2xl text-white">Even Our Reports Are Clean.</h3>
          <p class="mt-3 max-w-sm text-sm leading-6 text-white/75">Ask for a facility walkthrough and coverage plan — no spam, no pressure, just a straight answer on fit.</p>
          <a href="/get-a-quote/" class="bl-pill mt-5" style="background: #fff; color: var(--bl-blue);">Get A Quote</a>
        </div>
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.16em] text-white/70">Shop</p>
          <div class="mt-4 grid gap-2 text-sm text-white/85">
            <a href="/human/" class="hover:text-white">Human</a>
            <a href="/hvac/" class="hover:text-white">HVAC</a>
            <a href="/ag/" class="hover:text-white">Ag</a>
            <a href="/genesis360mistingsystems/" class="hover:text-white">Genesis 360</a>
            <a href="/botanimax/" class="hover:text-white">BotaniMax</a>
          </div>
        </div>
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.16em] text-white/70">About</p>
          <div class="mt-4 grid gap-2 text-sm text-white/85">
            <a href="/about-us/" class="hover:text-white">About Us</a>
            <a href="/about-us/technology/" class="hover:text-white">Technology</a>
            <a href="/blogs/" class="hover:text-white">Blog</a>
            <a href="/resources/faqs/" class="hover:text-white">FAQs</a>
          </div>
        </div>
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.16em] text-white/70">Help</p>
          <div class="mt-4 grid gap-2 text-sm text-white/85">
            <a href="/contact-us/" class="inline-flex items-center gap-2 hover:text-white"><Phone class="h-4 w-4" />1-888-997-4310</a>
