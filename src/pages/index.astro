---
// INTERIM LANDING PAGE (single page).
//
// Marty asked to pull the old securelogicusa.com site down because its
// messaging no longer matches what the company is putting out, and to stand up
// one page covering who we are, what we do, and what's coming — with a direct
// line back to him while the full site is finished.
//
// Deliberate choices, so this is easy to undo:
//   1. The full homepage is parked at `_home-full.astro`. Astro ignores files
//      prefixed with `_`, so it stops building but stays in the repo. Restoring
//      is a two-file swap.
//   2. This page carries its own header and footer instead of importing
//      Header.astro / Footer.astro, because both link into interior pages that
//      are currently gated. Those two components are untouched and ready to go
//      back into service.
//   3. Every interior page still builds. They're made unreachable by 302s in
//      netlify.toml — delete that block and the whole site is live again.
//
// Copy here is drawn from the company's own about-us and homepage decks, not
// invented, so nothing on this page contradicts the existing material.
import { Mail, Phone } from '@lucide/astro';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import logo from '../assets/images/logo-tight.png';
import logoIconNoWords from '../assets/images/logo-icon-no-words.png';
import farmVideo from '../assets/videos/farm.mp4';
import farmPoster from '../assets/images/hero-farm-poster.jpg';
import nozzles from '../assets/images/nozzles.png';
import botanimaxBottle from '../assets/images/botanimax-bottle.png';

// Marty's own address, confirmed by Joshua 2026-09-01 — enquiries from this
// page route straight to him rather than the general info@ inbox, because the
// whole point of the page is to catch people who are confused by the old
// messaging and get them to a decision-maker.
const CONTACT_EMAIL = 'marty@securelogicusa.com';
const CONTACT_PHONE = '1-888-997-4310';
const CONTACT_PHONE_HREF = 'tel:+18889974310';

// What we do. Three environments, stated without linking anywhere, because the
// market pages are gated for now.
const environments = [
  {
    name: 'Human',
    copy: 'Schools, clinics, gyms, locker rooms, childcare — the shared spaces where people learn, train, recover, and gather.',
  },
  {
    name: 'HVAC',
    copy: 'The coils, ducts, and air pathways that quietly decide the indoor air quality of an entire building.',
  },
  {
    name: 'Agriculture',
    copy: 'Barns, greenhouses, and grow environments, where repeatable biosecurity protects both the herd and the margin.',
  },
];

// Who we are. Pulled verbatim in substance from the about-us page.
const founders = [
  {
    name: 'Marty Boquet',
    role: 'Co-Founder & CEO',
    copy: 'Spent 23 years running one of the Gulf Coast’s largest restoration and infection-control firms, working inside hospitals, schools, and government buildings.',
  },
  {
    name: 'Josh Morvant',
    role: 'Co-Founder & COO',
    copy: 'Brings more than 20 years of experience across construction, engineering, and systems design.',
  },
];
---

<BaseLayout
  title="Secure Logic | Automated Dry-Mist Disinfection"
  description="Secure Logic is a micro-droplet fumigation technology company building automated systems that control and improve indoor environments. Our new site is on the way — call 1-888-997-4310."
>
  <div class="bl bg-white">
    <!-- Minimal chrome. No nav, because there is nowhere to navigate to yet —
         just the mark and the two ways to reach a human. -->
    <header class="sticky top-0 z-50 border-b border-brand-100 bg-white/95 backdrop-blur">
      <div class="container-page flex h-20 items-center justify-between gap-4">
        <a href="/" class="flex items-center" aria-label="Secure Logic home">
          <Image src={logo} alt="Secure Logic" class="h-9 w-auto object-contain" widths={[120, 180]} sizes="120px" />
        </a>
        <div class="flex items-center gap-3 sm:gap-6">
          <a
            href={CONTACT_PHONE_HREF}
            class="inline-flex items-center gap-2 text-sm font-bold text-brand-900 transition hover:text-brand-600"
          >
            <Phone class="h-4 w-4 text-brand-600" aria-hidden="true" />
            <span class="hidden sm:inline">{CONTACT_PHONE}</span>
            <span class="sr-only sm:hidden">Call {CONTACT_PHONE}</span>
          </a>
          <a href={`mailto:${CONTACT_EMAIL}`} class="bl-pill hidden text-[0.7rem] sm:inline-flex">Email Us</a>
        </div>
      </div>
    </header>

    <main>
      <!-- HERO -->
      <section class="relative isolate overflow-hidden text-white">
        <video
          class="absolute inset-0 h-full w-full object-cover"
          src={farmVideo}
          poster={farmPoster.src}
          autoplay
          muted
          loop
          playsinline
          preload="auto"
          aria-hidden="true"
        ></video>
        <div
          class="absolute inset-0"
          style="background: linear-gradient(0deg, hsl(236 78% 16% / .95) 0%, hsl(229 76% 26% / .84) 48%, hsl(221 82% 22% / .78) 100%);"
        ></div>

        <div class="container-page relative grid min-h-[min(86vh,760px)] place-items-center py-24 text-center">
          <div class="mx-auto max-w-3xl">
            <p class="bl-eyebrow" style="--bl-eyebrow-color: var(--bl-lime);">Secure Logic</p>
            <h1 class="mt-5 text-balance text-4xl leading-[1.05] sm:text-5xl lg:text-6xl">
              Engineering Better Environments.
            </h1>
            <p class="mx-auto mt-6 max-w-lg text-balance text-lg font-medium leading-8 text-white/75 sm:text-xl sm:leading-9">
              Automated dry-mist disinfection engineered for facilities that can’t afford inconsistency.
            </p>
            <p class="mx-auto mt-7 max-w-xl text-balance text-base leading-7 text-white/60">
              We’re rebuilding our website around where the company is today. In the meantime, this page covers who we
              are and what we do — and the fastest way to get a real answer is to call or email us directly.
            </p>
            <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row sm:gap-4">
              <a href={CONTACT_PHONE_HREF} class="bl-pill bl-pill-invert">
                <Phone class="h-4 w-4" aria-hidden="true" />{CONTACT_PHONE}
              </a>
              <a
                href={`mailto:${CONTACT_EMAIL}`}
                class="inline-flex items-center gap-2 border-b border-white/45 pb-1 text-sm font-bold uppercase tracking-[0.1em] text-white transition hover:border-white"
              >
                <Mail class="h-4 w-4" aria-hidden="true" />Email Us
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- WHO WE ARE -->
      <section class="bg-white py-20 sm:py-24">
        <div class="container-page grid gap-14 lg:grid-cols-[1.15fr_.85fr] lg:items-center">
          <div>
            <p class="bl-eyebrow">Who We Are</p>
            <h2 class="bl-h2 mt-4 text-balance">Reimagining How the World Disinfects.</h2>
            <div class="mt-7 space-y-6 text-base leading-8 text-brand-body sm:text-lg">
              <p>
                Secure Logic is a micro-droplet fumigation technology company inventing automated systems that control
                and improve indoor environments.
              </p>
              <p>
                We started from a problem our founders kept watching repeat inside hospitals, schools, and government
                buildings: even when the disinfectant worked, people still had to do the spraying. That meant
                inconsistency, higher cost, and results nobody could predict.
              </p>
              <p class="border-l-4 border-botanical-500 bg-brand-50 py-4 pl-6 pr-4 text-lg font-medium leading-8 text-brand-900">
                If you want consistent results, you cannot depend on inconsistent processes.
              </p>
            </div>

            <div class="mt-9 grid gap-6 sm:grid-cols-2">
              {founders.map(({ name, role, copy }) => (
                <div class="border-t-2 border-brand-100 pt-5">
                  <p class="text-base font-bold text-brand-900">{name}</p>
                  <p class="bl-eyebrow mt-1">{role}</p>
                  <p class="mt-3 text-sm leading-6 text-brand-muted">{copy}</p>
                </div>
              ))}
            </div>
          </div>

          <div class="relative">
            <Image
              src={nozzles}
              alt="Two Genesis 360 nozzles spraying a fine dry mist toward each other"
              class="w-full rounded-2xl shadow-deep"
              widths={[520, 760, 1040]}
              sizes="(min-width: 1024px) 40vw, 100vw"
            />
          </div>
        </div>
      </section>

      <!-- WHAT WE DO -->
      <section
        class="relative overflow-hidden py-20 text-white sm:py-24"
        style="--bl-eyebrow-color: var(--bl-lime); background: linear-gradient(160deg, var(--bl-ink) 0%, var(--bl-ink-mid) 58%, var(--bl-ink-deep) 100%);"
      >
        <div
          class="pointer-events-none absolute inset-0 opacity-60"
          aria-hidden="true"
          style="background: radial-gradient(circle at 84% 8%, rgb(82 194 76 / 0.14), transparent 44%), radial-gradient(circle at 6% 92%, rgb(62 103 232 / 0.4), transparent 46%);"
        ></div>

        <div class="container-page relative">
          <div class="mx-auto max-w-3xl text-center">
            <p class="bl-eyebrow">What We Do</p>
            <h2 class="bl-h2 mt-4 text-balance text-white">Two Products. One Job: Consistency.</h2>
          </div>

          <div class="mx-auto mt-14 grid max-w-5xl gap-10 lg:grid-cols-2 lg:gap-14">
            <div class="border-t-2 border-lime-400/70 pt-7">
              <h3 class="text-2xl text-white sm:text-3xl">Genesis 360™</h3>
              <p class="mt-4 text-base leading-8 text-white/75">
                A physics-driven misting platform that converts liquid into an ultra-dry, sub-10-micron mist. It fills a
                space, wraps 360 degrees around every surface, and does it the same way every time — automatically,
                without staff in the room.
              </p>
              <p class="mt-4 text-base leading-8 text-white/75">
                It is a modular family of systems rather than a single device, built on shared physics so a hospital
                wing and a grow-finish barn run on the same logic.
              </p>
            </div>

            <div class="border-t-2 border-lime-400/70 pt-7">
              <h3 class="text-2xl text-white sm:text-3xl">BotaniMax®</h3>
              <p class="mt-4 text-base leading-8 text-white/75">
                Our EPA-registered botanical disinfectant, formulated to pair with the platform. Dry mist leaves no
                residue and doesn’t shift a room’s humidity or temperature, which keeps sensitive equipment and surfaces
                out of harm’s way.
              </p>
              <div class="mt-6">
                <Image
                  src={botanimaxBottle}
                  alt="BotaniMax botanical disinfectant bottle"
                  class="h-32 w-auto object-contain"
                  widths={[160, 320]}
                  sizes="160px"
                />
              </div>
            </div>
          </div>

          <div class="mx-auto mt-16 max-w-5xl border-t border-white/15 pt-12">
            <p class="text-center text-sm font-bold uppercase tracking-[0.16em] text-white/55">
              Built For Three Environments
            </p>
            <div class="mt-8 grid gap-8 sm:grid-cols-3">
              {environments.map(({ name, copy }) => (
                <div>
                  <p class="text-xl font-bold text-lime-400">{name}</p>
                  <p class="mt-3 text-sm leading-6 text-white/70">{copy}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- WHAT'S COMING -->
      <section class="bg-brand-50 py-20 sm:py-24">
        <div class="container-page">
          <div class="mx-auto max-w-3xl text-center">
            <p class="bl-eyebrow">What’s Coming</p>
            <h2 class="bl-h2 mt-4 text-balance">Genesis 360 Is Our First Platform. It Won’t Be Our Last.</h2>
            <p class="mx-auto mt-6 max-w-2xl text-balance text-base leading-8 text-brand-body sm:text-lg">
              Pathogens are evolving and expectations around indoor air and surface quality are rising. We’re pushing
              misting and environmental control technology forward so buildings of every size can reach the same level
              of intelligent protection.
            </p>
          </div>

          <div class="mx-auto mt-12 max-w-3xl rounded-2xl bg-white p-8 shadow-lift sm:p-10">
            <p class="text-base leading-8 text-brand-body sm:text-lg">
              A full site is in progress — product detail for every Genesis 360 configuration, the science behind the
              droplet, certifications and compliance documentation, and market-specific coverage plans for human, HVAC,
              and agricultural facilities.
            </p>
            <p class="mt-5 text-base font-semibold leading-8 text-brand-900 sm:text-lg">
              Until it’s live, talk to us directly. Nothing on the roadmap is a secret — we’d rather answer your
              question in a five-minute call than have you guess from a web page.
            </p>
          </div>
        </div>
      </section>

      <!-- CONTACT -->
      <section id="contact" class="bg-white py-20 sm:py-24">
        <div class="container-page">
          <div class="mx-auto max-w-3xl text-center">
            <p class="bl-eyebrow">Talk To Us</p>
            <h2 class="bl-h2 mt-4 text-balance">Get A Straight Answer.</h2>
            <p class="mx-auto mt-5 max-w-xl text-balance text-base leading-8 text-brand-body sm:text-lg">
              Questions about a facility, a product, timing, or partnership all land in the same place. Call the office
              line or send an email and we’ll come back to you.
            </p>
          </div>

          <div class="mx-auto mt-12 grid max-w-3xl gap-5 sm:grid-cols-2">
            <a
              href={CONTACT_PHONE_HREF}
              class="group flex flex-col items-center rounded-2xl border border-brand-100 bg-brand-50 p-9 text-center transition hover:border-brand-200 hover:bg-brand-100"
            >
              <span class="flex h-14 w-14 items-center justify-center rounded-2xl bg-white shadow-lift">
                <Phone class="h-6 w-6 text-brand-600" aria-hidden="true" />
              </span>
              <span class="bl-eyebrow mt-5">Office Line</span>
              <span class="mt-2 text-2xl font-bold text-brand-900">{CONTACT_PHONE}</span>
            </a>

            <a
              href={`mailto:${CONTACT_EMAIL}`}
              class="group flex flex-col items-center rounded-2xl border border-brand-100 bg-brand-50 p-9 text-center transition hover:border-brand-200 hover:bg-brand-100"
            >
              <span class="flex h-14 w-14 items-center justify-center rounded-2xl bg-white shadow-lift">
                <Mail class="h-6 w-6 text-brand-600" aria-hidden="true" />
              </span>
              <span class="bl-eyebrow mt-5">Email</span>
              <span class="mt-2 break-all text-lg font-bold text-brand-900">{CONTACT_EMAIL}</span>
            </a>
          </div>
        </div>
      </section>
    </main>

    <!-- Minimal footer. Same gradient and mark as the sitewide footer, without
         the link columns that point at gated pages. -->
    <footer
      class="relative isolate overflow-hidden px-5 py-14 text-white sm:px-6 lg:px-8"
      style="background: linear-gradient(180deg, #14297f 0%, #132676 16%, #11215f 44%, #0d1a52 74%, #0b1057 100%);"
    >
      <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
        <Image
          src={logoIconNoWords}
          alt=""
          class="absolute -bottom-36 -right-16 w-[38rem] max-w-none opacity-[0.035] blur-[0.2px] brightness-0 invert"
          widths={[480, 640]}
          sizes="608px"
        />
      </div>

      <div class="relative mx-auto flex max-w-6xl flex-col items-center gap-7 text-center">
        <Image
          src={logo}
          alt="Secure Logic"
          class="h-10 w-auto object-contain brightness-0 invert"
          widths={[120, 180]}
          sizes="140px"
        />
        <div class="flex flex-col items-center gap-3 text-sm text-white/75 sm:flex-row sm:gap-8">
          <a href={CONTACT_PHONE_HREF} class="inline-flex items-center gap-2 transition hover:text-white">
            <Phone class="h-4 w-4" aria-hidden="true" />{CONTACT_PHONE}
          </a>
          <a href={`mailto:${CONTACT_EMAIL}`} class="inline-flex items-center gap-2 transition hover:text-white">
            <Mail class="h-4 w-4" aria-hidden="true" />{CONTACT_EMAIL}
          </a>
        </div>
        <div class="flex gap-3">
          <a
            href="http://facebook.com/SecureLogicUSA"
            aria-label="Facebook"
            class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-white/10 text-white/75 transition hover:bg-white/20 hover:text-white"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14 8.5V6.75c0-.5.1-.85.32-1.06.21-.22.57-.33 1.08-.33H17V2.2C16.23 2.1 15.49 2 14.78 2c-1.53 0-2.75.45-3.65 1.34-.9.9-1.35 2.16-1.35 3.79V8.5H7v3.55h2.78V22h4.03v-9.95h2.98l.46-3.55H14Z"/></svg>
          </a>
          <a
            href="https://www.instagram.com/securelogicusa/"
            aria-label="Instagram"
            class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-white/10 text-white/75 transition hover:bg-white/20 hover:text-white"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none"/></svg>
          </a>
          <a
            href="https://www.youtube.com/@SecureLogic-Genesis360"
            aria-label="YouTube"
            class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-white/10 text-white/75 transition hover:bg-white/20 hover:text-white"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.58 7.2a3 3 0 0 0-2.11-2.12C17.61 4.58 12 4.58 12 4.58s-5.61 0-7.47.5A3 3 0 0 0 2.42 7.2 31.3 31.3 0 0 0 1.92 12c0 1.64.17 3.26.5 4.8a3 3 0 0 0 2.11 2.12c1.86.5 7.47.5 7.47.5s5.61 0 7.47-.5a3 3 0 0 0 2.11-2.12c.33-1.54.5-3.16.5-4.8 0-1.64-.17-3.26-.5-4.8ZM10 15.5v-7l6 3.5-6 3.5Z"/></svg>
          </a>
        </div>
        <div class="w-full border-t border-white/20 pt-6 text-xs text-white/55">
          <p>Copyright 2026 © Secure Logic</p>
        </div>
      </div>
    </footer>
  </div>
</BaseLayout>
