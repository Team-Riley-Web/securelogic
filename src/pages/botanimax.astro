---
// BotaniMax product page. Regulatory and contact-time claims come from the
// EPA master label / product label. The page does not claim the label approves
// fogging or misting, and it does not use a disputed FIFRA category code.
import { ArrowRight, Citrus, FileCheck, Leaf, ShieldCheck, Timer } from '@lucide/astro';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProductHero from '../components/product/ProductHero.astro';
import DifferenceGrid from '../components/sector/DifferenceGrid.astro';
import SectorCta from '../components/sector/SectorCta.astro';
import bottle from '../assets/images/botanimax-bottle.png';
import logo from '../assets/images/botanimax-logo-trim.png';
import label from '../assets/images/botanimax-label.png';
import thyme from '../assets/images/blog-thymol-vs-thyme.png';
import fogScene from '../assets/images/human-d1-gym.png';

// Sources: BotaniMax EPA master label, product label, SDS, and promo sheet.
const proof = [
  { value: 'EPA Registered', copy: 'Reg. No. 92089-2-103661', icon: FileCheck },
  { value: '100% Botanical', copy: 'Formula described in the product materials', icon: Leaf },
  { value: '3 Named Oils', copy: 'Thyme, wintergreen, and citrus extracts', icon: Citrus },
];

const ingredients = [
  { name: 'Thyme Oil', copy: 'A botanical oil containing a complex mix of naturally occurring compounds.' },
  { name: 'Wintergreen Oil', copy: 'A plant-derived oil used in the broader botanical formula.' },
  { name: 'Citrus Extracts', copy: 'Citrus-derived compounds complete the named botanical blend.' },
];

// Source: EPA master label organism list and required wet-contact times.
const labelClaims = [
  { time: '90 sec', title: 'SARS-CoV-2', copy: 'Label contact time on pre-cleaned, hard, non-porous surfaces.' },
  { time: '5 min', title: 'Human coronavirus & virus surrogates', copy: 'Includes Human Coronavirus 229E, a norovirus surrogate, and Poliovirus Type 1.' },
  { time: '10 min', title: 'Bacteria', copy: 'Includes Staphylococcus aureus, Pseudomonas aeruginosa, and Salmonella enterica.' },
  { time: '10 min', title: 'Fungicidal use', copy: 'Label claim for Trichophyton mentagrophytes on hard, non-porous surfaces.' },
];
---

<BaseLayout title="Genesis360 | BotaniMax" description="BotaniMax is an EPA-registered botanical cleaner, disinfectant, and deodorizer made with thyme oil, wintergreen oil, and citrus extracts.">
  <div class="bl bg-white" x-data x-init="document.documentElement.classList.add('reveal-enabled')">
    <Header />
    <main>
      <ProductHero
        headline={['Botanical By Design.', 'Registered To Perform.']}
        copy="An EPA-registered botanical cleaner, disinfectant, and deodorizer built from a multi-modal blend of plant-derived ingredients."
        image={bottle}
        imageAlt="Clear spray bottle of BotaniMax botanical disinfectant"
        logo={logo}
        logoAlt="BotaniMax"
        tone="green"
        media="float"
        cta={{ href: '#label-performance', label: 'See Label Performance' }}
        secondaryCta={{ href: '/resources/documentation/', label: 'View Documentation' }}
      />

      <section class="relative z-10 -mt-1 bg-white py-12 shadow-[0_-18px_50px_rgb(17_40_89/.08)]">
        <div class="container-page grid gap-5 md:grid-cols-3">
          {proof.map(({ value, copy, icon: Icon }) => (
            <div class="reveal flex items-start gap-4 rounded-2xl bg-brand-50 p-6" x-intersect.once="$el.classList.add('is-visible')">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-botanical-50 text-botanical-600"><Icon class="h-5 w-5" aria-hidden="true" /></span>
              <div><p class="font-bold text-brand-900">{value}</p><p class="mt-1 text-sm leading-6 text-brand-body">{copy}</p></div>
            </div>
          ))}
        </div>
      </section>

      <!-- 50-50, full bleed: the thyme photo runs edge to edge in the left
           half with the bottle standing on it; the copy column is capped at
           half the page container so its left edge lines up with the rest. -->
      <section class="grid bg-white lg:grid-cols-2">
        <div class="relative min-h-[28rem] overflow-hidden sm:min-h-[34rem] lg:min-h-[44rem]">
          <Image src={thyme} alt="" class="absolute inset-0 h-full w-full object-cover" widths={[640, 960, 1280]} sizes="(min-width: 1024px) 50vw, 100vw" />
          <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_55%,rgb(255_255_255/.55),transparent_58%),linear-gradient(180deg,rgb(16_32_74/.05),rgb(16_32_74/.35))]" aria-hidden="true"></div>
          <Image src={bottle} alt="BotaniMax bottle showing its botanical disinfectant label" class="absolute inset-x-0 bottom-[6%] mx-auto h-[82%] w-full object-contain object-bottom drop-shadow-[0_30px_40px_rgb(0_0_0/.35)]" widths={[360, 540, 760]} sizes="(min-width: 1024px) 30vw, 70vw" />
        </div>
        <div class="flex items-center px-5 py-16 sm:px-6 sm:py-20 lg:px-16 lg:py-24">
          <div class="reveal w-full max-w-[36rem]" x-intersect.once="$el.classList.add('is-visible')">
            <p class="bl-eyebrow">The Botanical Blend</p>
            <h2 class="bl-h2 mt-4">Three Named Ingredients. More Than A Single Mode Of Action.</h2>
            <p class="mt-6 text-base leading-8 text-brand-body">BotaniMax product materials name thyme oil, wintergreen oil, and citrus extracts. Together they form a complex botanical blend rather than relying on one synthetic-style mechanism.</p>
            <div class="mt-8 grid gap-4">
              {ingredients.map(({ name, copy }, index) => (
                <article class="flex gap-5 rounded-2xl bg-brand-50 p-5">
                  <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-botanical-100 text-sm font-bold text-botanical-700">0{index + 1}</span>
                  <div><h3 class="text-lg text-brand-900">{name}</h3><p class="mt-2 text-sm leading-6 text-brand-body">{copy}</p></div>
                </article>
              ))}
            </div>
            <p class="mt-5 text-xs leading-5 text-brand-muted">Sources: BotaniMax SDS, promo sheet, and “A Unique EPA Registration” product sheet.</p>
          </div>
        </div>
      </section>

      <!-- Fog photo from /human/athletics/ behind a navy scrim, everything
           centred. The eyebrow is set light grey here: the default brand blue
           all but disappears on this ground. -->
      <section id="label-performance" class="relative isolate scroll-mt-28 overflow-hidden bg-brand-900 py-20 text-white sm:py-24" style="--bl-eyebrow-color: rgb(255 255 255 / 0.72);">
        <Image src={fogScene} alt="" class="absolute inset-0 -z-10 h-full w-full object-cover" widths={[960, 1440, 1920]} sizes="100vw" />
        <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,hsl(226_64%_12%/.86)_0%,hsl(228_68%_14%/.78)_45%,hsl(230_70%_10%/.92)_100%)]" aria-hidden="true"></div>
        <div class="container-page">
          <div class="reveal mx-auto max-w-3xl text-center" x-intersect.once="$el.classList.add('is-visible')">
            <p class="bl-eyebrow">Label-Backed Performance</p>
            <h2 class="mt-4 text-3xl leading-tight sm:text-4xl">Contact Time Is Part Of The Claim.</h2>
            <p class="mt-6 text-base leading-8 text-white/70 sm:text-lg">The product label ties each organism claim to a surface type, preparation method, and wet-contact time. Those conditions matter as much as the organism name.</p>
          </div>
          <div class="mt-12 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
            {labelClaims.map(({ time, title, copy }) => (
              <article class="reveal rounded-2xl border border-white/15 bg-white/[.08] p-6 text-center backdrop-blur-sm" x-intersect.once="$el.classList.add('is-visible')">
                <Timer class="mx-auto h-6 w-6 text-lime-400" aria-hidden="true" />
                <p class="mt-6 text-3xl font-bold text-lime-400">{time}</p>
                <h3 class="mt-3 text-lg text-white">{title}</h3>
                <p class="mt-3 text-sm leading-6 text-white/65">{copy}</p>
              </article>
            ))}
          </div>
          <div class="mx-auto mt-8 flex max-w-3xl gap-4 rounded-2xl bg-white p-6 text-left text-brand-body sm:items-start">
            <ShieldCheck class="mt-0.5 h-6 w-6 shrink-0 text-botanical-600" aria-hidden="true" />
            <p class="text-sm leading-6"><strong class="text-brand-900">Use the label, not a summary, as the instruction.</strong> Pre-clean where directed, use only on labeled surfaces, keep the surface visibly wet for the required contact time, and follow all precautionary statements.</p>
          </div>
        </div>
      </section>

      <DifferenceGrid
        eyebrow="Why BotaniMax"
        heading="Cleaning Chemistry With A Botanical Starting Point."
        lede="The differentiator is not a vague natural claim. It is a registered product with named ingredients, labeled uses, and directions that define how performance is achieved."
        points={[
          { icon: 'shield', title: 'Multi-Modal Formula', copy: 'The botanical blend is described as acting through multiple mechanisms rather than a single pathway.' },
          { icon: 'coverage', title: 'Multiple Labeled Roles', copy: 'The label covers cleaner, disinfectant, deodorizer, bactericide, virucide, fungicide, and fungistat uses.' },
          { icon: 'cycle', title: 'Ready-To-Use Path', copy: 'For labeled disinfecting uses on hard, non-porous surfaces, the product is applied ready to use and kept wet for the stated time.' },
        ]}
        closing={{ lead: 'The formula matters. The directions make it perform.', aside: 'BotaniMax carries the signal word CAUTION. Avoid eye contact, wear protective eyewear, and never mix it with bleach or mildew stain removers.' }}
      />

      <section class="bg-white py-20 sm:py-24">
        <div class="container-page grid gap-10 lg:grid-cols-[1.15fr_.85fr] lg:items-center">
          <div class="reveal" x-intersect.once="$el.classList.add('is-visible')">
            <p class="bl-eyebrow">Read The Source</p>
            <h2 class="bl-h2 mt-4">Registration, Safety Data, And Test Reports Belong Beside The Product.</h2>
            <p class="mt-6 max-w-2xl text-base leading-8 text-brand-body">Review the master label, Safety Data Sheet, efficacy reports, and supporting papers before building a facility protocol.</p>
            <a href="/resources/documentation/" class="bl-pill mt-8">Open Documentation <ArrowRight class="h-4 w-4" aria-hidden="true" /></a>
          </div>
          <div class="reveal overflow-hidden rounded-2xl bg-brand-50 p-5 shadow-lift" x-intersect.once="$el.classList.add('is-visible')">
            <Image src={label} alt="BotaniMax product label with directions, registration number, ingredients, and precautionary statements" class="w-full rounded-xl object-contain" widths={[640, 960, 1280]} sizes="(min-width: 1024px) 38vw, 100vw" />
          </div>
        </div>
      </section>

      <SectorCta
        eyebrow="Your Facility. Your Protocol."
        heading="Start With The Surfaces And Organisms That Matter."
        copy="Tell us what you are treating and how the space operates. We will help you connect the product documentation to a practical facility plan."
        href="/get-a-quote/"
      />
    </main>
    <Footer />
  </div>
</BaseLayout>
