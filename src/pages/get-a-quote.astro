---
// src/pages/get-a-quote.astro
// Spec: docs/superpowers/specs/2026-09-17-resources-utility-design.md
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SectorHero from '../components/sector/SectorHero.astro';
import ContactBlock from '../components/ContactBlock.astro';
import walkthroughVideo from '../assets/videos/facility-walkthrough.mp4';
import walkthroughPoster from '../assets/images/hero-facility-walkthrough-poster.jpg';
---

<BaseLayout title="Genesis360 | Get A Quote" description="Request a quote to evaluate Genesis360 botanical disinfection and automated dry fog systems for your facility.">
  <div class="bl bg-white" x-data x-init="document.documentElement.classList.add('reveal-enabled')">
    <Header />
    <main>
      <SectorHero
        eyebrow="Get A Quote"
        headline={['Get A Quote For', 'Your Facility.']}
        support="Tell us about the space and we'll map the right Genesis360 configuration."
        poster={walkthroughPoster}
        video={walkthroughVideo}
        cta={{ href: '#quote', label: 'Start Below' }}
      />

      <ContactBlock
        id="quote"
        eyebrow="Every Quote Starts With A Walkthrough"
        heading="Tell Us About Your Facility."
        body="Every quote starts with a facility walkthrough and a coverage plan, not a guess. Share what you need to protect and how the space operates, and we'll map the right fixed, portable, or HVAC-integrated approach."
      />
    </main>
    <Footer />
  </div>
</BaseLayout>
