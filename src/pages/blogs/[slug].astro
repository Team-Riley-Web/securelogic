---
import { ArrowLeft, ArrowRight } from '@lucide/astro';
import { Image } from 'astro:assets';
import ArticleAudio from '../../components/ArticleAudio.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { posts } from '../../data/blog-posts';

export function getStaticPaths() {
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const more = posts.filter((p) => p.slug !== post.slug).slice(0, 3);
---

<BaseLayout title={`Secure Logic | ${post.title}`} description={post.description}>
  <Header />
  <main>
    <article>
      <section class="relative overflow-hidden bg-white">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_20%_20%,hsl(104_48%_89%/.55),transparent_34%),radial-gradient(circle_at_80%_0%,hsl(211_92%_92%/.7),transparent_30%)]"></div>
        <div class="container-page relative py-20 sm:py-24">
          <a href="/blogs/" class="inline-flex items-center gap-2 text-sm font-semibold text-primary-700">
            <ArrowLeft class="h-4 w-4" /> All articles
          </a>
          <h1 class="mt-6 max-w-4xl text-4xl font-semibold tracking-normal text-slate-900 sm:text-5xl">{post.title}</h1>
          <div class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-2">
            <time datetime={post.isoDate} class="text-sm font-semibold text-slate-500">{post.date}</time>
            {post.tags.map((tag) => (
              <span class="rounded-full bg-botanical-50 px-3 py-1 text-xs font-semibold text-botanical-700 ring-1 ring-botanical-200">
                {tag}
              </span>
            ))}
          </div>
        </div>
      </section>

      <section class="bg-white pb-20">
        <div class="container-page">
          <Image
            src={post.image}
            alt={post.imageAlt}
            class="aspect-[16/9] w-full rounded-lg object-cover shadow-deep"
            widths={[640, 960, 1280, 1600]}
            sizes="(min-width: 1024px) 80vw, 100vw"
            loading="eager"
          />
          <div class="mx-auto mt-12 max-w-3xl">
            <ArticleAudio src={`/audio/${post.slug}.mp3`} />
          </div>
          <div class="post-body mx-auto mt-12 max-w-3xl" set:html={post.body} />
        </div>
      </section>

      <section class="bg-slate-100 py-20">
        <div class="container-page">
          <h2 class="section-title">Keep reading</h2>
          <div class="mt-10 grid gap-8 md:grid-cols-3">
            {more.map((related) => (
              <a href={`/blogs/${related.slug}/`} class="card group flex flex-col overflow-hidden">
                <Image
                  src={related.image}
                  alt={related.imageAlt}
                  class="aspect-[16/9] w-full object-cover"
                  widths={[420, 640, 860]}
                  sizes="(min-width: 768px) 33vw, 100vw"
                />
                <div class="flex flex-1 flex-col p-6">
                  <time datetime={related.isoDate} class="text-xs font-semibold uppercase tracking-[0.16em] text-botanical-600">
                    {related.date}
                  </time>
                  <h3 class="mt-3 text-lg font-semibold leading-7 text-slate-900">{related.title}</h3>
                  <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-primary-700">
                    Read article <ArrowRight class="h-4 w-4 transition group-hover:translate-x-1" />
                  </span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>

      <section class="bg-white py-20">
        <div class="container-page"><QuoteForm /></div>
      </section>
    </article>
  </main>
  <Footer />
</BaseLayout>
