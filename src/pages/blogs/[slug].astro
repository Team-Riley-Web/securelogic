---
import { ArrowLeft, ArrowRight } from '@lucide/astro';
import { Image } from 'astro:assets';
import ArticleAudio from '../../components/ArticleAudio.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { posts } from '../../data/blog-posts';

export function getStaticPaths() {
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const more = posts.filter((p) => p.slug !== post.slug).slice(0, 3);
---

<BaseLayout title={`Secure Logic | ${post.title}`} description={post.description}>
  <Header />
  <main>
    <article>
      <section class="relative overflow-hidden bg-slate-900 px-6 pb-24 pt-32 text-white sm:px-10 sm:pt-40">
        <Image
          src={post.image}
          alt=""
          class="absolute inset-0 h-full w-full object-cover object-center"
          widths={[640, 960, 1280, 1600]}
          sizes="100vw"
          loading="eager"
          aria-hidden="true"
        />
        <div class="absolute inset-0 bg-slate-900/75" aria-hidden="true"></div>
        <div class="relative mx-auto max-w-[1040px] text-center">
          <a href="/blogs/" class="inline-flex items-center gap-2 text-sm font-semibold text-botanical-200 transition hover:text-white">
            <ArrowLeft class="h-4 w-4" /> All articles
          </a>
          <h1 class="mx-auto mt-8 max-w-4xl text-4xl font-bold leading-tight tracking-tight sm:text-5xl">{post.title}</h1>
          <div class="mt-7 flex flex-wrap items-center justify-center gap-x-3 gap-y-2">
            <time datetime={post.isoDate} class="text-sm font-semibold text-white/70">{post.date}</time>
            {post.tags.map((tag) => (
              <span class="rounded-full bg-white/10 px-3 py-1 text-xs font-semibold text-botanical-100 ring-1 ring-white/20">
                {tag}
              </span>
            ))}
          </div>
        </div>
      </section>

      <section class="bg-white py-20">
        <div class="container-page">
          <div class="mx-auto max-w-3xl">
            <ArticleAudio src={`/audio/${post.slug}.mp3`} />
          </div>
          <div class="post-body mx-auto mt-12 max-w-3xl" set:html={post.body} />
        </div>
      </section>

      <section class="bg-white pb-20">
        <div class="container-page"><div class="mx-auto max-w-3xl"><QuoteForm /></div></div>
      </section>

      <section class="bg-slate-100 py-20">
        <div class="container-page">
          <h2 class="section-title">Keep reading</h2>
          <div class="mt-10 grid gap-8 md:grid-cols-3">
            {more.map((related) => (
              <a href={`/blogs/${related.slug}/`} class="card group flex flex-col overflow-hidden">
                <Image
                  src={related.image}
                  alt={related.imageAlt}
                  class="aspect-[16/9] w-full object-cover"
                  widths={[420, 640, 860]}
                  sizes="(min-width: 768px) 33vw, 100vw"
                />
                <div class="flex flex-1 flex-col p-6">
                  <time datetime={related.isoDate} class="text-xs font-semibold uppercase tracking-[0.16em] text-botanical-600">
                    {related.date}
                  </time>
                  <h3 class="mt-3 text-lg font-semibold leading-7 text-slate-900">{related.title}</h3>
                  <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-primary-700">
                    Read article <ArrowRight class="h-4 w-4 transition group-hover:translate-x-1" />
                  </span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    </article>
  </main>
  <Footer />
</BaseLayout>
