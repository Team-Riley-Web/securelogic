          <a href={`/blogs/${slug}/`} class="reveal group overflow-hidden rounded-lg bg-white shadow-[0_18px_40px_-28px_rgb(16_32_74/.45),0_2px_8px_rgb(16_32_74/.08)] ring-1 ring-slate-900/5 transition hover:-translate-y-1 hover:shadow-[0_26px_50px_-28px_rgb(16_32_74/.55),0_3px_10px_rgb(16_32_74/.1)] max-md:w-[min(24rem,85vw)] max-md:shrink-0 max-md:snap-start" style={`transition-delay: ${index * 80}ms`} x-intersect.once="$el.classList.add('is-visible')">
            <div class="overflow-hidden">
              <Image src={image} alt={imageAlt} class="aspect-[16/10] w-full object-cover transition-transform duration-200" style="transform: scale(1.04);" data-scroll-scale-image widths={[360, 520, 700]} sizes="(min-width: 768px) 33vw, 85vw" />
            </div>
            <div class="p-5">
              <p class="text-xs font-semibold uppercase tracking-[0.14em] text-slate-500">{date}</p>
              <h3 class="mt-3 text-base font-semibold leading-6" style="color: var(--bl-ink);">{title}</h3>
              <span class="mt-5 inline-flex items-center gap-2 text-sm font-bold" style="color: var(--bl-blue);">Read more <ArrowRight class="h-4 w-4 transition group-hover:translate-x-1" /></span>
            </div>
          </a>
        ))}
      </div>
      <div class="mt-10 text-center">
        <a href="/blogs/" class="bl-pill-outline" style="border: 1.5px solid var(--bl-blue);">View All Posts <ArrowRight class="h-4 w-4" /></a>
      </div>
    </section>

    <!-- Final CTA (mist clouds) -->
    <section class="relative overflow-hidden px-6 py-24 text-center" style="background: var(--bl-sky);">
      <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
        <div class="absolute -bottom-16 left-[8%] h-40 w-40 rounded-full bg-white/70 blur-2xl"></div>
        <div class="absolute -bottom-10 left-[28%] h-28 w-28 rounded-full bg-white/60 blur-2xl"></div>
        <div class="absolute -bottom-20 right-[15%] h-48 w-48 rounded-full bg-white/70 blur-2xl"></div>
        <div class="absolute -bottom-8 right-[35%] h-24 w-24 rounded-full bg-white/60 blur-2xl"></div>
      </div>
      <div class="reveal relative mx-auto max-w-3xl" x-intersect.once="$el.classList.add('is-visible')">
        <p class="text-xs font-bold uppercase tracking-[0.16em]" style="color: var(--bl-blue);">Your Facility. Your Coverage Plan.</p>
        <h2 class="mt-4 text-3xl sm:text-4xl" style="color: var(--bl-blue-dark);">Start Protecting Your Facility.</h2>
        <p class="mx-auto mt-5 max-w-2xl text-base leading-7 text-slate-600">Tell us what you need to protect and how the space operates. Our team will help map the right fixed, portable, or HVAC-integrated approach, then build a practical coverage plan around your facility.</p>
        <a href="/get-a-quote/" class="bl-pill mt-8">Get A Quote</a>
      </div>
    </section>

    <!-- Footer -->
    <footer class="relative overflow-hidden px-6 py-16 text-white" style="background: radial-gradient(circle at 12% -10%, rgb(117 167 255 / 0.58) 0%, transparent 34%), radial-gradient(circle at 88% 115%, rgb(7 12 72 / 0.92) 0%, transparent 46%), linear-gradient(125deg, #2b58ef 0%, #1d3fd6 36%, #1734b0 62%, #0b1057 100%);">
      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <Image src={logoFull} alt="" class="absolute -left-28 -top-24 w-[26rem] max-w-none brightness-0 invert opacity-[0.065] blur-[0.2px] sm:-left-20 sm:w-[30rem]" widths={[420, 600]} sizes="480px" />
        <div class="absolute -left-40 -top-52 h-[32rem] w-[32rem] rounded-full border-[2rem] border-white/[0.06]"></div>
        <div class="absolute -bottom-64 right-[8%] h-[38rem] w-[38rem] rounded-full border-[4rem] border-white/[0.04]"></div>
      </div>
      <div class="relative mx-auto grid max-w-6xl gap-10 md:grid-cols-[1.3fr_1fr_1fr_1fr]">
        <div>
          <h3 class="text-2xl text-white">Even Our Reports Are Clean.</h3>
          <p class="mt-3 max-w-sm text-sm leading-6 text-white/75">Ask for a facility walkthrough and coverage plan — no spam, no pressure, just a straight answer on fit.</p>
          <a href="/get-a-quote/" class="bl-pill mt-5" style="background: #fff; color: var(--bl-blue);">Get A Quote</a>
        </div>
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.16em] text-white/70">Shop</p>
          <div class="mt-4 grid gap-2 text-sm text-white/85">
            <a href="/human/" class="hover:text-white">Human</a>
            <a href="/hvac/" class="hover:text-white">HVAC</a>
            <a href="/ag/" class="hover:text-white">Ag</a>
            <a href="/genesis360mistingsystems/" class="hover:text-white">Genesis 360</a>
            <a href="/botanimax/" class="hover:text-white">BotaniMax</a>
          </div>
        </div>
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.16em] text-white/70">About</p>
          <div class="mt-4 grid gap-2 text-sm text-white/85">
            <a href="/about-us/" class="hover:text-white">About Us</a>
            <a href="/about-us/technology/" class="hover:text-white">Technology</a>
            <a href="/blogs/" class="hover:text-white">Blog</a>
            <a href="/resources/faqs/" class="hover:text-white">FAQs</a>
          </div>
        </div>
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.16em] text-white/70">Help</p>
          <div class="mt-4 grid gap-2 text-sm text-white/85">
            <a href="/contact-us/" class="inline-flex items-center gap-2 hover:text-white"><Phone class="h-4 w-4" />1-888-997-4310</a>
            <a href="mailto:info@securelogicUSA.com" class="inline-flex items-center gap-2 hover:text-white"><Mail class="h-4 w-4" />info@securelogicUSA.com</a>
            <a href="/privacy-policy/" class="hover:text-white">Privacy Policies</a>
          </div>
        </div>
      </div>
      <div class="relative mx-auto mt-12 flex max-w-6xl flex-col gap-3 border-t border-white/20 pt-6 text-xs text-white/70 sm:flex-row sm:items-center sm:justify-between">
        <p>Copyright 2026 © Secure Logic</p>
        <p class="sm:text-right">Crafted with care by Team Riley</p>
      </div>
    </footer>
  </div>
</BaseLayout>

<script>
  const announcementSlides = Array.from(document.querySelectorAll<HTMLElement>('[data-announcement-slide]'));
  const announcementPrevious = document.querySelector<HTMLButtonElement>('[data-announcement-prev]');
  const announcementNext = document.querySelector<HTMLButtonElement>('[data-announcement-next]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const applicationVideos = Array.from(document.querySelectorAll<HTMLVideoElement>('[data-application-video]'));

  if (reduceMotion) {
    applicationVideos.forEach((video) => video.pause());
  } else if ('IntersectionObserver' in window) {
    const applicationVideoObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const video = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) {
            video.play().catch(() => {});
          } else {
            video.pause();
          }
        });
      },
      { rootMargin: '160px 0px', threshold: 0.08 },
    );

    applicationVideos.forEach((video) => applicationVideoObserver.observe(video));
  }

  let announcementIndex = 0;
  let announcementTimer: number | undefined;

  function showAnnouncement(index: number) {
    announcementIndex = (index + announcementSlides.length) % announcementSlides.length;
    announcementSlides.forEach((slide, slideIndex) => {
      const isActive = slideIndex === announcementIndex;
      slide.classList.toggle('is-active', isActive);
      slide.setAttribute('aria-hidden', String(!isActive));
    });
  }

  function startAnnouncementRotation() {
    if (reduceMotion || announcementSlides.length < 2) return;
    window.clearInterval(announcementTimer);
    announcementTimer = window.setInterval(() => showAnnouncement(announcementIndex + 1), 5200);
  }

  announcementPrevious?.addEventListener('click', () => {
    showAnnouncement(announcementIndex - 1);
    startAnnouncementRotation();
  });

  announcementNext?.addEventListener('click', () => {
    showAnnouncement(announcementIndex + 1);
    startAnnouncementRotation();
  });

  startAnnouncementRotation();

  const heroSlides = Array.from(document.querySelectorAll<HTMLVideoElement>('[data-hero-slide]'));
  let heroIndex = 0;
  let heroTimer: number | undefined;

  function selectHero(index: number) {
    heroIndex = index;

    heroSlides.forEach((slide) => {
      const isSelected = slide.getAttribute('data-hero-slide') === String(index);
      slide.classList.toggle('opacity-95', isSelected);
      slide.classList.toggle('opacity-0', !isSelected);

      if (isSelected && slide.paused) {
        slide.play().catch(() => {});
      }
    });

    // Keep the outgoing video playing through the cross-fade, then pause it.
    window.setTimeout(() => {
      heroSlides.forEach((slide) => {
        if (slide.getAttribute('data-hero-slide') !== String(heroIndex) && !slide.paused) {
          slide.pause();
        }
      });
    }, 1000);
  }

  function startHeroCarousel() {
    window.clearInterval(heroTimer);
    heroTimer = window.setInterval(() => {
      selectHero((heroIndex + 1) % heroSlides.length);
    }, 5200);
  }

  if (heroSlides.length) startHeroCarousel();

  const typedHeroWord = document.querySelector<HTMLElement>('[data-typed-hero-word]');
  const typedWords = ['Environments.'];
  const prefersReducedMotion = reduceMotion;
  let typedWordIndex = 0;
  let typedLetterIndex = typedWords[0].length;
  let typedDirection: 'typing' | 'deleting' | 'holding' = 'holding';

  function cycleTypedHeroWord() {
    if (!typedHeroWord) return;

    const currentWord = typedWords[typedWordIndex];
    const setTypedWord = (value: string) => {
      typedHeroWord.textContent = value || ' ';
    };

    if (typedDirection === 'holding') {
      typedDirection = 'deleting';
      window.setTimeout(cycleTypedHeroWord, 1600);
      return;
    }

    if (typedDirection === 'deleting') {
      typedLetterIndex -= 1;
      setTypedWord(currentWord.slice(0, typedLetterIndex));

      if (typedLetterIndex <= 0) {
        typedWordIndex = (typedWordIndex + 1) % typedWords.length;
        typedDirection = 'typing';
        window.setTimeout(cycleTypedHeroWord, 320);
        return;
      }

      window.setTimeout(cycleTypedHeroWord, 55);
      return;
    }

    const nextWord = typedWords[typedWordIndex];
    typedLetterIndex += 1;
    setTypedWord(nextWord.slice(0, typedLetterIndex));

    if (typedLetterIndex >= nextWord.length) {
      typedDirection = 'holding';
      window.setTimeout(cycleTypedHeroWord, 2200);
      return;
    }

    window.setTimeout(cycleTypedHeroWord, 92);
  }

  if (typedHeroWord && !prefersReducedMotion) {
    window.setTimeout(cycleTypedHeroWord, 2200);
  }

  const testimonialTrack = document.querySelector<HTMLElement>('[data-alt-testimonial-track]');
  const testimonialPrevious = document.querySelector<HTMLButtonElement>('[data-alt-testimonial-prev]');
  const testimonialNext = document.querySelector<HTMLButtonElement>('[data-alt-testimonial-next]');

  if (testimonialTrack) {
    const cardStep = () => {
      const card = testimonialTrack.querySelector<HTMLElement>('[data-alt-testimonial-card]');
      return card ? card.getBoundingClientRect().width + 20 : testimonialTrack.clientWidth;
    };

    const loopWidth = () => testimonialTrack.scrollWidth / 2;

    const normalizeTestimonials = () => {
      const width = loopWidth();
      if (testimonialTrack.scrollLeft >= width) {
        testimonialTrack.scrollLeft -= width;
      } else if (testimonialTrack.scrollLeft < 0) {
        testimonialTrack.scrollLeft += width;
      }
    };

    const showNextTestimonial = () => {
      normalizeTestimonials();
      testimonialTrack.scrollBy({ left: cardStep(), behavior: 'smooth' });
    };

    const showPreviousTestimonial = () => {
      if (testimonialTrack.scrollLeft <= 1) {
        testimonialTrack.scrollLeft += loopWidth();
      }
      testimonialTrack.scrollBy({ left: -cardStep(), behavior: 'smooth' });
    };

    let testimonialTimer: number | undefined;

    const startTestimonialAutoplay = () => {
      window.clearInterval(testimonialTimer);
      if (reduceMotion) return;
      testimonialTimer = window.setInterval(showNextTestimonial, 4500);
    };

    const stopTestimonialAutoplay = () => window.clearInterval(testimonialTimer);

    testimonialNext?.addEventListener('click', () => {
      showNextTestimonial();
      startTestimonialAutoplay();
    });

    testimonialPrevious?.addEventListener('click', () => {
      showPreviousTestimonial();
      startTestimonialAutoplay();
    });

    if ('onscrollend' in window) {
      testimonialTrack.addEventListener('scrollend', normalizeTestimonials);
    } else {
      let scrollSettleTimer: number | undefined;
      testimonialTrack.addEventListener(
        'scroll',
        () => {
          window.clearTimeout(scrollSettleTimer);
          scrollSettleTimer = window.setTimeout(normalizeTestimonials, 120);
        },
        { passive: true },
      );
    }

    testimonialTrack.addEventListener('mouseenter', stopTestimonialAutoplay);
    testimonialTrack.addEventListener('mouseleave', startTestimonialAutoplay);
    testimonialTrack.addEventListener('touchstart', stopTestimonialAutoplay, { passive: true });
    testimonialTrack.addEventListener('touchend', startTestimonialAutoplay, { passive: true });

    startTestimonialAutoplay();
  }
</script>
