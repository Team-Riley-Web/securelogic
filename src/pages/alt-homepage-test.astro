---
// TEST PAGE — not linked in nav. Recreates the real homepage's content using
// Blueland.com's visual language (bold rounded-pill CTAs, saturated royal-blue
// palette, light-blue trust bands, deep-blue testimonial + footer blocks,
// centered hero over full-bleed photography).
import { ArrowLeft, ArrowRight, ChevronLeft, ChevronRight, Droplets, Info, Mail, Orbit, Phone, Quote, ShieldCheck, Star, TimerReset } from '@lucide/astro';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CertMark from '../components/CertMark.astro';
import MegaMenu from '../components/MegaMenu.astro';
import { posts } from '../data/blog-posts';
import { megaMenus } from '../data/mega-menus';
import logo from '../assets/images/logo.png';
import logoFull from '../assets/images/logo-full.png';
import farmVideo from '../assets/videos/farm.mp4';
import cannabisVideo from '../assets/videos/cannabis.mp4';
import gymVideo from '../assets/videos/gym.mp4';
import cowsVideo from '../assets/videos/cows.mp4';
import applicationHumanVideo from '../assets/videos/application-human.mp4';
import applicationHvacVideo from '../assets/videos/application-hvac.mp4';
import applicationAgricultureVideo from '../assets/videos/application-agriculture.mp4';
import botanimaxBottle from '../assets/images/botanimax-bottle.png';
import botanimaxLogo from '../assets/images/botanimax-logo.png';
import compact from '../assets/images/genesis-compact.png';
import genesisWallMountedGym from '../assets/images/genesis360-wall-mounted-gym.jpg';
import portableMist from '../assets/images/portable-mist.png';
import farmer1 from '../assets/images/farmer1.png';
import farmer2 from '../assets/images/farmer2.png';
import farmer3 from '../assets/images/farmer3.png';
import medical from '../assets/images/medical.png';
import biofilmHvac from '../assets/images/blog-biofilm-hvac.png';
import greenhouse from '../assets/images/blog-greenhouse.png';
import fitnessAthletics from '../assets/images/fitness-athletics-lineup.jpg';

const categories = [
  { title: 'Human', href: '/human/', image: medical, video: applicationHumanVideo, copy: 'Protect the shared spaces where people learn, train, recover, and gather.' },
  { title: 'HVAC', href: '/hvac/', image: biofilmHvac, video: applicationHvacVideo, copy: 'Treat the hidden coils, ducts, and air pathways that shape indoor air quality.' },
  { title: 'Agriculture', href: '/ag/', image: greenhouse, video: applicationAgricultureVideo, copy: 'Build repeatable biosecurity into barns, greenhouses, and grow environments.' },
];

const trustStats = [
  { label: 'Sub-10 μm', copy: 'Dry-mist droplet size that behaves like a vapor', icon: Droplets },
  { label: '360°', copy: 'Air and surface coverage, every cycle', icon: Orbit },
  { label: 'Automated', copy: 'Programmable, repeatable disinfection cycles', icon: TimerReset },
  { label: 'EPA 2(c)', copy: 'Registered botanical disinfectant formula', icon: ShieldCheck },
];

const systems = [
  { name: 'InRoomMist', eyebrow: 'Whole-Room Coverage', copy: 'A discreet fixed system for automated, repeatable air and surface treatment.', image: genesisWallMountedGym, imageAlt: 'Genesis 360 InRoomMist system mounted on the wall of a fitness facility' },
  { name: 'Compact Mist', eyebrow: 'Flexible Deployment', copy: 'Core Genesis 360 performance in a smaller, adaptable footprint.', image: compact },
  { name: 'PortableMist', eyebrow: 'Targeted Response', copy: 'A portable option for fast, focused deployment across the facility.', image: portableMist },
];

const certMarks: { kind: 'epa' | 'evp' | 'usa' | 'patent' | 'botanical'; caption: string }[] = [
  { kind: 'epa', caption: 'EPA Registered Disinfectant' },
  { kind: 'evp', caption: 'Emerging Viral Pathogen Claim' },
  { kind: 'botanical', caption: '150+ Plant-Derived Actives' },
  { kind: 'patent', caption: 'Patent-Pending Formula' },
  { kind: 'usa', caption: 'Made in the USA' },
];

const testimonials = [
  { quote: "Using BAC Ag has been a huge success in our show pig operation! We went from having sow health issues to bringing in new sows and not having any issues!", name: 'Keaton Kitson', role: 'Owner, Kitson Show Pigs', image: farmer1 },
  { quote: 'I did a trial where I treated one barn with BAC Ag and not the other. The treated barn had 30% less deads, 30% less culls, and went to market 10 pounds heavier.', name: 'Southwest Iowa Pig Farmer', role: 'Pork Producer', image: farmer2 },
  { quote: "It's been a game changer for us — not only taking away the terrible smell in the barns, but healthier lambs, no coughing or diarrhea that you see in heated barns.", name: 'David Sark', role: 'Farmer', image: farmer3 },
];

const switchReasons = [
  'True whole-room disinfection, not just wiped surfaces',
  'Automated, remote-capable operation cuts labor dependence',
  'Environmentally neutral — no residue, no humidity shift',
  'One platform across HVAC, in-room, medical, and ag use',
];

const recentPosts = posts.slice(0, 3);

// Nav splits around the centred logo, so the menus split too.
const leftMenus = megaMenus.filter((m) => ['Human', 'HVAC', 'Ag'].includes(m.label));
const rightMenus = megaMenus.filter((m) => ['Resources', 'About Us'].includes(m.label));
---

<BaseLayout
  title="Secure Logic | Alternate Homepage Test (Blueland style)"
  description="Design test: Secure Logic's real homepage content restyled after blueland.com — bold pill CTAs, royal-blue palette, and trust-band layout."
>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700;800&display=swap');

    .bl {
      --bl-blue: #1d3fd6;
      --bl-blue-dark: #142e9e;
      --bl-ink: #10204a;
      --bl-sky: #e3edff;
      font-family: 'Poppins', ui-sans-serif, system-ui, sans-serif;
      color: var(--bl-ink);
    }

    .bl h1,
    .bl h2,
    .bl h3 {
      font-family: 'Poppins', ui-sans-serif, system-ui, sans-serif;
      font-weight: 700;
      letter-spacing: -0.01em;
    }

    .bl-pill {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      border-radius: 999px;
      background: var(--bl-blue);
      color: #fff;
      font-weight: 700;
      font-size: 0.8rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      padding: 0.9rem 1.9rem;
      transition: background 0.2s ease, transform 0.2s ease;
      white-space: nowrap;
    }

    .bl-pill:hover {
      background: var(--bl-blue-dark);
      transform: translateY(-1px);
    }

    .bl-pill-outline {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      border-radius: 999px;
      background: #fff;
      color: var(--bl-blue);
      font-weight: 700;
      font-size: 0.75rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      padding: 0.8rem 1.7rem;
      box-shadow: 0 1px 2px rgb(16 32 74 / 0.08);
      transition: background 0.2s ease;
    }

    .bl-pill-outline:hover {
      background: var(--bl-sky);
    }

    .announcement-slide {
      grid-column: 1;
      grid-row: 1;
      opacity: 0;
      transform: translateY(0.35rem);
      transition: opacity 0.35s ease, transform 0.35s ease;
      pointer-events: none;
    }

    .announcement-slide.is-active {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }

    .h2o-stage {
      position: relative;
      isolation: isolate;
      width: min(29rem, 82vw);
      aspect-ratio: 1.08;
      perspective: 900px;
      transform-style: preserve-3d;
    }

    .h2o-stage::before {
      content: '';
      position: absolute;
      inset: 8%;
      border-radius: 999px;
      background:
        repeating-conic-gradient(from 15deg, rgb(255 255 255 / 0.28) 0 0.3deg, transparent 0.3deg 7deg),
        radial-gradient(circle, rgb(29 63 214 / 0.14), transparent 68%);
      filter: blur(0.25px);
      opacity: 0.72;
    }

    .h2o-formula {
      position: absolute;
      left: 3%;
      top: 3%;
      z-index: 8;
      color: var(--bl-blue-dark);
      font-size: clamp(1.1rem, 3vw, 1.5rem);
      font-weight: 800;
      letter-spacing: -0.04em;
    }

    .h2o-formula sub {
      position: relative;
      bottom: -0.18em;
      font-size: 0.58em;
    }

    .h2o-aura {
      position: absolute;
      left: 50%;
      top: 48%;
      z-index: -1;
      width: 72%;
      aspect-ratio: 1;
      border-radius: 999px;
      background: radial-gradient(circle, rgb(116 166 255 / 0.38), rgb(111 202 103 / 0.12) 48%, transparent 72%);
      filter: blur(18px);
      transform: translate(-50%, -50%);
      animation: h2o-aura-pulse 4.8s ease-in-out infinite alternate;
    }

    .h2o-orbit-field {
      position: absolute;
      inset: 1%;
      z-index: 1;
      width: 98%;
      height: 98%;
      overflow: visible;
    }

    .h2o-ring-track,
    .h2o-ring-glow,
    .h2o-ring-runner {
      fill: none;
      vector-effect: non-scaling-stroke;
    }

    .h2o-ring-track,
    .h2o-ring-glow {
      stroke: currentColor;
      stroke-dasharray: 21 2.5;
      stroke-width: 1.35;
    }

    .h2o-ring-track { opacity: 0.46; }

    .h2o-ring-glow {
      opacity: 0.32;
      filter: blur(2.4px);
      stroke-width: 4;
    }

    .h2o-ring-runner {
      stroke: currentColor;
      stroke-dasharray: 1 99;
      stroke-linecap: round;
      stroke-width: 7;
      filter: drop-shadow(0 0 3px currentColor) drop-shadow(0 0 6px rgb(255 255 255 / 0.75));
      animation: h2o-ring-orbit var(--ring-speed, 4.8s) linear infinite;
      animation-delay: var(--ring-delay, 0s);
    }

    .h2o-ring-blue {
      --ring-speed: 4.8s;
      --ring-delay: 0s;
      color: #4772ea;
    }

    .h2o-ring-green {
      --ring-speed: 6.4s;
      --ring-delay: -2.1s;
      color: #52a94d;
    }

    .h2o-ring-sky {
      --ring-speed: 5.6s;
      --ring-delay: -3.7s;
      color: #76a7ff;
    }

    .h2o-ring-green .h2o-ring-runner { animation-direction: reverse; }

    .h2o-orbit-core {
      fill: #4772ea;
      filter: drop-shadow(0 0 12px rgb(71 114 234 / 0.68));
      opacity: 0.3;
      transform-box: fill-box;
      transform-origin: center;
      animation: h2o-core-pulse 2.8s ease-in-out infinite alternate;
    }

    .h2o-orbit-shadow {
      fill: #10204a;
      filter: blur(7px);
      opacity: 0.12;
    }

    .h2o-molecule {
      position: absolute;
      inset: 8% 6% 12%;
      z-index: 3;
      transform-style: preserve-3d;
      animation: h2o-molecule-float 6s ease-in-out infinite alternate;
      will-change: transform;
    }

    .h2o-bond {
      position: absolute;
      left: 50%;
      top: 50%;
      z-index: 2;
      width: 37%;
      height: 0.72rem;
      border-radius: 999px;
      background: linear-gradient(180deg, #fff, #a9c5ff 35%, #2f5de2 62%, #10204a);
      box-shadow: 0 8px 18px -8px rgb(16 32 74 / 0.68), inset 0 1px 1px rgb(255 255 255 / 0.85);
      transform-origin: 0 50%;
    }

    .h2o-bond-left { transform: rotate(142.25deg); }
    .h2o-bond-right { transform: rotate(37.75deg); }

    .h2o-atom {
      --atom-edge-color: rgb(71 114 234 / 0.72);
      --atom-pulse-delay: 0s;
      position: absolute;
      z-index: 4;
      display: grid;
      aspect-ratio: 1;
      place-items: center;
      border: 1px solid rgb(255 255 255 / 0.7);
      border-radius: 999px;
      color: #fff;
      font-weight: 800;
      line-height: 1;
      text-shadow: 0 1px 2px rgb(5 14 47 / 0.5);
      transform: translate(-50%, -50%) translateZ(2rem);
    }

    .h2o-atom::before {
      content: '';
      position: absolute;
      inset: -9%;
      z-index: -1;
      border: 1.5px solid var(--atom-edge-color);
      border-radius: inherit;
      box-shadow: 0 0 16px var(--atom-edge-color), inset 0 0 10px var(--atom-edge-color);
      opacity: 0.34;
      animation: h2o-atom-edge-pulse 2.2s ease-in-out var(--atom-pulse-delay) infinite alternate;
    }

    .h2o-atom::after {
      content: '';
      position: absolute;
      inset: 9%;
      border-radius: inherit;
      background: linear-gradient(145deg, rgb(255 255 255 / 0.28), transparent 44%);
      box-shadow: inset -12px -16px 24px rgb(5 14 47 / 0.18);
    }

    .h2o-oxygen {
      --atom-edge-color: rgb(71 114 234 / 0.72);
      --atom-pulse-delay: -0.8s;
      left: 50%;
      top: 50%;
      width: 27%;
      background: radial-gradient(circle at 31% 27%, #fff 0 3%, #a9c5ff 7%, #4772ea 27%, #1d3fd6 62%, #10204a 100%);
      box-shadow: 0 28px 44px -24px rgb(16 32 74 / 0.85), 0 0 34px rgb(29 63 214 / 0.34);
      font-size: clamp(1.75rem, 6vw, 2.75rem);
    }

    .h2o-hydrogen {
      --atom-edge-color: rgb(82 194 76 / 0.68);
      top: 73%;
      width: 17%;
      background: radial-gradient(circle at 31% 27%, #fff 0 5%, #e8f9ce 10%, #a6d960 36%, #52a94d 68%, #205538 100%);
      box-shadow: 0 22px 34px -22px rgb(32 85 56 / 0.88), 0 0 26px rgb(82 194 76 / 0.3);
      font-size: clamp(1.1rem, 4vw, 1.75rem);
    }

    .h2o-hydrogen-left {
      --atom-pulse-delay: -1.4s;
      left: 20%;
    }

    .h2o-hydrogen-right {
      --atom-pulse-delay: -0.3s;
      left: 80%;
    }

    .h2o-angle {
      position: absolute;
      bottom: 2%;
      left: 50%;
      z-index: 8;
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      border: 1px solid rgb(29 63 214 / 0.16);
      border-radius: 999px;
      background: rgb(255 255 255 / 0.76);
      padding: 0.45rem 0.8rem;
      color: var(--bl-blue-dark);
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      transform: translateX(-50%);
      backdrop-filter: blur(8px);
      white-space: nowrap;
    }

    .h2o-angle::before {
      content: '';
      width: 1.1rem;
      height: 0.55rem;
      border-top: 2px solid #52a94d;
      border-right: 2px solid #52a94d;
      border-radius: 0 999px 0 0;
    }

    .h2o-angle-info {
      display: inline-grid;
      width: 1.25rem;
      height: 1.25rem;
      margin-left: 0.1rem;
      place-items: center;
      border: 1px solid rgb(29 63 214 / 0.24);
      border-radius: 999px;
      background: rgb(29 63 214 / 0.08);
      color: var(--bl-blue);
      transition: background-color 160ms ease, color 160ms ease, transform 160ms ease;
    }

    .h2o-angle-info:hover,
    .h2o-angle-info:focus-visible {
      background: var(--bl-blue);
      color: #fff;
      outline: none;
      transform: translateY(-1px);
    }

    .h2o-angle-info:focus-visible { box-shadow: 0 0 0 3px rgb(29 63 214 / 0.2); }

    .h2o-angle-tooltip {
      position: absolute;
      bottom: calc(100% + 0.75rem);
      left: 50%;
      width: min(18rem, calc(82vw - 2rem));
      border-radius: 0.85rem;
      background: #10204a;
      padding: 0.8rem 0.9rem;
      color: rgb(255 255 255 / 0.88);
      font-size: 0.73rem;
      font-weight: 500;
      letter-spacing: 0;
      line-height: 1.55;
      text-align: left;
      text-transform: none;
      box-shadow: 0 18px 36px -18px rgb(16 32 74 / 0.72), 0 2px 6px rgb(16 32 74 / 0.22);
      opacity: 0;
      visibility: hidden;
      transform: translate(-50%, 0.3rem);
      transition: opacity 160ms ease, transform 160ms ease, visibility 160ms ease;
      white-space: normal;
      pointer-events: none;
    }

    .h2o-angle-tooltip::after {
      content: '';
      position: absolute;
      top: 100%;
      left: 50%;
      border: 0.38rem solid transparent;
      border-top-color: #10204a;
      transform: translateX(-50%);
    }

    .h2o-angle-info:hover + .h2o-angle-tooltip,
    .h2o-angle-info:focus + .h2o-angle-tooltip {
      opacity: 1;
      visibility: visible;
      transform: translate(-50%, 0);
    }

    @keyframes h2o-ring-orbit {
      0% { stroke-dashoffset: 0; stroke-width: 7; }
      50% { stroke-width: 4; }
      100% { stroke-dashoffset: -100; stroke-width: 7; }
    }

    @keyframes h2o-core-pulse {
      from { opacity: 0.18; transform: scale(0.82); }
      to { opacity: 0.42; transform: scale(1.18); }
    }

    @keyframes h2o-molecule-float {
      0% { transform: translateY(0.4rem) rotateX(4deg) rotateY(-7deg); }
      50% { transform: translateY(-0.3rem) rotateX(-2deg) rotateY(3deg); }
      100% { transform: translateY(-0.65rem) rotateX(5deg) rotateY(8deg); }
    }

    @keyframes h2o-atom-edge-pulse {
      from { opacity: 0.2; transform: scale(0.9); }
      to { opacity: 0.72; transform: scale(1.13); }
    }

    @keyframes h2o-aura-pulse {
      from { opacity: 0.56; transform: translate(-50%, -50%) scale(0.92); }
      to { opacity: 0.88; transform: translate(-50%, -50%) scale(1.08); }
    }

    @media (prefers-reduced-motion: reduce) {
      .announcement-slide { transition: none; }
      .h2o-aura,
      .h2o-ring-runner,
      .h2o-orbit-core,
      .h2o-molecule,
      .h2o-atom::before { animation: none; }

      .h2o-molecule { transform: rotateX(3deg) rotateY(-4deg); }
      [data-botanimax-parallax] { transform: translate3d(0, 130px, 0) scale(1.12) !important; }
    }
  </style>

  <div
    class="bl bg-white"
    x-data="{
      reducedMotion: window.matchMedia('(prefers-reduced-motion: reduce)').matches,
      updateScrollScaleImages() {
        if (this.reducedMotion) return;

        const viewportHeight = window.innerHeight;

        document.querySelectorAll('[data-scroll-scale-image]').forEach((image) => {
          const frame = image.parentElement;
          if (!frame) return;

          const rect = frame.getBoundingClientRect();
          if (rect.bottom < 0 || rect.top > viewportHeight) return;

          const progress = Math.min(1, Math.max(0, (viewportHeight - rect.top) / (viewportHeight + rect.height)));
          image.style.transform = `scale(${1.04 + progress * 0.16})`;
        });
      },
      updateBotaniMaxParallax() {
        if (this.reducedMotion) return;

        const viewportHeight = window.innerHeight;

        document.querySelectorAll('[data-botanimax-parallax]').forEach((image) => {
          const frame = image.parentElement;
          if (!frame) return;

          const rect = frame.getBoundingClientRect();
          if (rect.bottom < 0 || rect.top > viewportHeight) return;

          const progress = Math.min(1, Math.max(0, (viewportHeight - rect.top) / (viewportHeight + rect.height)));
          const translateY = 240 - progress * 160;
          image.style.transform = `translate3d(0, ${translateY}px, 0) scale(1.12)`;
        });
      }
    }"
    x-init="
      document.documentElement.classList.add('reveal-enabled');
      updateScrollScaleImages();
      updateBotaniMaxParallax();
      if (!reducedMotion) {
        window.addEventListener('scroll', () => requestAnimationFrame(() => { updateScrollScaleImages(); updateBotaniMaxParallax(); }), { passive: true });
        window.addEventListener('resize', () => requestAnimationFrame(() => { updateScrollScaleImages(); updateBotaniMaxParallax(); }), { passive: true });
      }
    "
  >
    <!-- Announcement bar -->
    <div class="flex min-h-10 items-center justify-center gap-3 px-4 py-2 text-center text-xs font-semibold uppercase tracking-[0.08em] text-white sm:gap-6" style="background: var(--bl-blue);">
      <button type="button" class="rounded-full p-1 opacity-60 transition hover:bg-white/10 hover:opacity-100 focus:outline-none focus:ring-2 focus:ring-white/70" data-announcement-prev aria-label="Previous announcement">
        <ChevronLeft class="h-4 w-4" aria-hidden="true" />
      </button>
      <div class="grid min-w-0 flex-1 place-items-center overflow-hidden" aria-live="polite">
        <p class="announcement-slide is-active" data-announcement-slide aria-hidden="false">
          Automated, Whole-Room Disinfection &nbsp;|&nbsp; <a href="/get-a-quote/" class="underline decoration-white/50 underline-offset-2">Get A Quote →</a>
        </p>
        <p class="announcement-slide" data-announcement-slide aria-hidden="true">
          Sub-10 μm Dry-Mist Precision &nbsp;|&nbsp; <a href="/about-us/technology/" class="underline decoration-white/50 underline-offset-2">See How It Works →</a>
        </p>
        <p class="announcement-slide" data-announcement-slide aria-hidden="true">
          Botanical Chemistry, Built for Precision &nbsp;|&nbsp; <a href="/botanimax/" class="underline decoration-white/50 underline-offset-2">Explore BotaniMax →</a>
        </p>
      </div>
      <button type="button" class="rounded-full p-1 opacity-60 transition hover:bg-white/10 hover:opacity-100 focus:outline-none focus:ring-2 focus:ring-white/70" data-announcement-next aria-label="Next announcement">
        <ChevronRight class="h-4 w-4" aria-hidden="true" />
      </button>
    </div>

    <!-- Header — `relative` anchors the mega-menu panel (it uses top-full). -->
    <header
      class="relative z-50 border-b border-slate-100 bg-white"
      style="--mm-accent: var(--bl-blue); --mm-ink: var(--bl-ink); --mm-tile-bg: var(--bl-sky); --mm-tile-hover-bg: #d3e0ff; --mm-foot-bg: #f7faff; --mm-row-hover-bg: #f7faff; --mm-border: #e5ecfa; --mm-trigger-size: 14px;"
    >
      <div class="mx-auto grid min-h-20 max-w-7xl grid-cols-[1fr_auto_1fr] items-center gap-6 px-6">
        <MegaMenu menus={leftMenus} class="col-start-1 justify-self-start font-semibold" />
        <a href="/" class="col-start-2 flex items-center justify-self-center" aria-label="Secure Logic home">
          <Image src={logo} alt="Secure Logic logo" class="h-10 w-auto object-contain" widths={[120, 180]} sizes="120px" />
        </a>
        <div class="col-start-3 flex items-center justify-self-end gap-4">
          <MegaMenu menus={rightMenus} class="font-semibold" />
          <a href="/get-a-quote/" class="bl-pill">Get A Quote</a>
        </div>
      </div>
    </header>
    <div class="relative z-40 hidden justify-center gap-8 border-t border-slate-100 py-3 text-sm font-semibold lg:flex" style="background: var(--bl-sky); color: var(--bl-ink);">
      <a href="/genesis360mistingsystems/" class="hover:opacity-70">Genesis 360</a>
      <a href="/botanimax/" class="hover:opacity-70">BotaniMax</a>
      <a href="#shop" class="hover:opacity-70">Shop All</a>
    </div>

    <!-- Hero — matched to the live homepage (index.astro). -->
    <section
      class="relative isolate overflow-visible bg-canopy text-white"
    >
      <div class="absolute inset-0">
        <video
          class="absolute inset-0 h-full w-full object-cover opacity-95 transition-opacity duration-1000 ease-in-out"
          src={farmVideo}
          autoplay
          muted
          loop
          playsinline
          preload="auto"
          aria-hidden="true"
          data-hero-slide="0"
