---
// Poultry — promoted out of the shared ag/[slug].astro template onto its own
// static route so it can carry the same video-hero treatment as
// /ag/hogs-livestock/ and /ag/indoor-growing/. Astro gives a static route
// precedence over the dynamic [slug] one, so this file shadows the template for
// this market.
//
// NOTE: with this page, all three ag markets now have static routes, so
// ag/[slug].astro no longer renders anything reachable. It is left in place
// rather than deleted — see TASKS.md.
//
// Structure mirrors the other two: the hero stays at one line of support so the
// footage keeps its legibility, and the longer argument sits in a band below on
// a solid ground instead of fighting the video for contrast.
//
// Body copy reads from `market.heroCopy` so src/data/ag-markets.ts stays the
// single source of truth for the wording.
import AgCta from '../../components/AgCta.astro';
import AgPostsRow from '../../components/AgPostsRow.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import SectorHero from '../../components/sector/SectorHero.astro';
import CoverageMap from '../../components/sector/CoverageMap.astro';
import OtherMarkets from '../../components/sector/OtherMarkets.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Bird, Wrench, Wind, Wheat, Feather, Truck, User, Droplet, ShieldCheck } from '@lucide/astro';
import { agMarkets } from '../../data/ag-markets';
import { posts } from '../../data/blog-posts';
import poultryVideo from '../../assets/videos/chickens-alt.mp4';
import poultryPoster from '../../assets/images/hero-poultry-poster.jpg';
import poultryBarnCoverage from '../../assets/images/poultry-barn-coverage.png';

const market = agMarkets.find((m) => m.slug === 'poultry')!;

// Source: reference-files/brochures/Livestock Barn Visual Presentation.pdf,
// p.6 "Biosecurity: Disease Can Enter From Many Pathways" — 8 numbered entry
// points (Birds, People, Vehicles, Equipment, Feed, Water, Wild Birds, Air) —
// and p.8 "Complete Coverage. Healthier Flocks." (the Encapsulate / Inactivate
// / Reduce framework, referenced in the mobile card copy below). Art is the
// best available poultry-house interior render (not a literal cutaway, per
// this task's brief); anchors are percentages over that render, tuned from
// screenshots in this task's QA step.
// The anchors below were tuned with the art at 68% of the stage. At that size
// the photo ran under the left-hand labels and the hover detail spilled onto
// it, so the art now renders at ART_WIDTH and every anchor is scaled about the
// stage centre by the same factor -- the dots stay on their features without
// re-tuning each one. Change ART_WIDTH, not the numbers.
// The stage is also taller than when tuned (aspect 1.95, was 2.25) so an
// expanded hover detail clears the callout below it; the art's share of the
// stage height changes with it, hence the separate vertical factor.
const ART_WIDTH = 56;
const STAGE_ASPECT = 1.95;
const TUNED_AT = { width: 68, aspect: 2.25 };
const sx = ART_WIDTH / TUNED_AT.width;
const sy = (ART_WIDTH * STAGE_ASPECT) / (TUNED_AT.width * TUNED_AT.aspect);
const tunedPathways = [
  // Ordered top-to-bottom to match where each feature actually sits in the
  // photograph, so every callout sits level with its own anchor dot. The art
  // is a real barn interior rather than a labelled cutaway, so the pairing
  // has to come from that alignment.
  { key: 'equipment', label: 'Equipment', sub: 'Pathway', icon: Wrench, side: 'left' as const,
    copy: "Shared tools, carts and machinery move pathogens from house to house when they aren't cleaned between uses.",
    callout: { x: 1.5, y: 10 }, anchor: { x: 45, y: 14 } },
  { key: 'air', label: 'Air', sub: 'Pathway', icon: Wind, side: 'left' as const,
    copy: 'Exhaust fans and open ventilation exchange the air inside the house with whatever the air outside is carrying.',
    callout: { x: 1.5, y: 36 }, anchor: { x: 26, y: 44 } },
  { key: 'birds', label: 'Birds', sub: 'Pathway', icon: Bird, side: 'left' as const,
    copy: 'New or returning birds can carry pathogens the rest of the flock has never been exposed to.',
    callout: { x: 1.5, y: 62 }, anchor: { x: 40, y: 68 } },
  { key: 'feed', label: 'Feed', sub: 'Pathway', icon: Wheat, side: 'left' as const,
    copy: 'Contaminated feed or feed ingredients introduce pathogens directly into the house.',
    callout: { x: 1.5, y: 88 }, anchor: { x: 31, y: 83 } },
  { key: 'wild-birds', label: 'Wild Birds', sub: 'Pathway', icon: Feather, side: 'right' as const,
    copy: 'Wild birds roosting near vents and feed storage carry pathogens close enough for the flock to catch.',
    callout: { x: 98.5, y: 10 }, anchor: { x: 66, y: 12 } },
  { key: 'vehicles', label: 'Vehicles', sub: 'Pathway', icon: Truck, side: 'right' as const,
    copy: 'Feed trucks, haulers and service vehicles carry contamination between farms on tires and undercarriages.',
    callout: { x: 98.5, y: 36 }, anchor: { x: 61, y: 40 } },
  { key: 'people', label: 'People', sub: 'Pathway', icon: User, side: 'right' as const,
    copy: 'Workers and visitors moving between houses track pathogens in on boots, hands and clothing.',
    callout: { x: 98.5, y: 62 }, anchor: { x: 57, y: 58 } },
  { key: 'water', label: 'Water', sub: 'Pathway', icon: Droplet, side: 'right' as const,
    copy: 'Untreated water lines deliver pathogens straight to every drinker the flock uses.',
    callout: { x: 98.5, y: 88 }, anchor: { x: 50, y: 79 } },
];
const biosecurityPathways = tunedPathways.map((p) => ({
  ...p,
  anchor: { x: 50 + (p.anchor.x - 50) * sx, y: 50 + (p.anchor.y - 50) * sy },
}));

// Same ordering rule as the other two ag pages: this market's own posts lead,
// then the ag press release, then whatever other ag posts fill the row.
const PRESS_RELEASE = 'secure-logic-newfields-ag-botanical-disinfection-partnership';
const agSlugs = new Set(agMarkets.flatMap((m) => m.postSlugs));
const relatedRank = (slug: string) =>
  market.postSlugs.includes(slug) ? 0 : slug === PRESS_RELEASE ? 1 : 2;
const relatedPosts = posts
  .filter((p) => market.postSlugs.includes(p.slug) || p.slug === PRESS_RELEASE || agSlugs.has(p.slug))
  .sort((a, b) => relatedRank(a.slug) - relatedRank(b.slug))
  .slice(0, 3);

const otherMarkets = agMarkets.filter((m) => m.slug !== market.slug);
---

<BaseLayout
  title="Genesis360 | Agriculture | Poultry"
  description={market.summary}
>
  <div class="bl bg-white" x-data x-init="document.documentElement.classList.add('reveal-enabled')">
    <Header />

    <main>
      <!-- MODULE 1 — hero. Same treatment as the hog and indoor-growing pages. -->
      <SectorHero
        layout="center"
        eyebrow="Poultry"
        headline={['Complete Coverage.', 'Healthy Flocks.']}
        support="Proactive pathogen control at every stage of every flock cycle."
        poster={poultryPoster}
        video={poultryVideo}
        cta={{ href: '/get-a-quote/', label: 'Get A Quote' }}
      />

      <!-- MODULE 2 — the argument, on a solid ground. Mirrors the hog page's
           "The Reality In Every Barn" band. -->
      <section class="bg-brand-100 py-20 sm:py-24">
        <div class="container-page">
          <div class="mx-auto max-w-3xl text-center">
            <p class="bl-eyebrow">The Reality In Every House</p>
            <h2 class="bl-h2 mt-4 text-balance">A Flock Doesn’t Get A Warning.</h2>
            <p class="mx-auto mt-7 text-balance text-base leading-7 text-brand-body sm:text-lg">
              {market.heroCopy}
            </p>
          </div>
        </div>
      </section>

      <!-- MODULE 2.5 — biosecurity coverage map, new source material (see the
           source comment above biosecurityPathways). Sits after the argument
           band and before the related-posts row. -->
      <CoverageMap
        eyebrow="Biosecurity"
        heading="Disease Can Enter From Many Pathways."
        lede="One goal: keep pathogens out. Every entry point the flock doesn't control is one the system does."
        art={poultryBarnCoverage}
        artAlt="Interior of a Genesis360-equipped poultry house with rows of chickens, feed and water lines, exhaust fans and a wall-mounted Genesis360 AgriGuard unit"
        mobileHeading="8 Pathways. One System."
        mobileCopy="Genesis360 encapsulates, inactivates and reduces pathogens across the air space, surfaces and waste room — every day."
        mobileIcon={ShieldCheck}
        points={biosecurityPathways}
        stageAspect={STAGE_ASPECT}
        artWidth={ART_WIDTH}
      />

      <AgPostsRow posts={relatedPosts} />


      <AgCta
        eyebrow="Your Houses. Your Coverage Plan."
        heading="Start With The Houses Most Exposed."
        copy="Tell us how the operation runs — breeder, brooder, grow-out, or all of it — and our team will map the right fixed, compact, or custom deployment and build a coverage plan around it."
      />

      <OtherMarkets heading="Other Agriculture Markets" basePath="/ag/" markets={otherMarkets} />
    </main>

    <Footer />
  </div>
</BaseLayout>
