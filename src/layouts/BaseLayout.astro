---
import '../styles/global.css';
import socialShare from '../assets/images/social-share.png';

interface Props {
  title?: string;
  description?: string;
  // Per-page social card. Defaults to the sitewide social-share.png; pass an
  // imported image (not a string path) to override it for one page.
  image?: ImageMetadata;
}

const {
  title = 'Secure Logic | Precision Misting and Botanical Disinfection',
  description = 'Secure Logic designs Genesis 360 automated misting systems and BotaniMax botanical disinfectant for precise whole-room environmental coverage.',
  image = socialShare,
} = Astro.props;

// Open Graph and Twitter both require ABSOLUTE urls — every scraper silently
// ignores a relative og:image, which is the usual reason a share preview comes
// out blank. Astro.site is `site` in astro.config.mjs, so that has to stay set.
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(image.src, Astro.site);

const SITE_NAME = 'Secure Logic';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph. Facebook, LinkedIn, Slack, iMessage and WhatsApp all read
         these. Width and height are emitted so a scraper can lay the card out
         on first pass without waiting to fetch and measure the image. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:width" content={String(image.width)} />
    <meta property="og:image:height" content={String(image.height)} />
    <meta property="og:image:alt" content={title} />

    <!-- Twitter/X reads its own namespace and falls back to og: for anything
         missing. summary_large_image is what gets the full-width card. -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap"
    />
    <title>{title}</title>
  </head>
  <body class="min-h-screen">
    <slot />
  </body>
</html>
