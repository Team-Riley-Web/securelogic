---
import '../styles/global.css';
import socialShare from '../assets/images/social-share.png';

interface Props {
  title?: string;
  description?: string;
  // Per-page social card. Defaults to the sitewide social-share.png; pass an
  // imported image (not a string path) to override it for one page.
  image?: ImageMetadata;
}

const {
  title = 'Genesis 360 | Precision Misting and Botanical Disinfection',
  description = 'Genesis 360 builds automated misting systems and BotaniMax botanical disinfectant for precise whole-room environmental coverage.',
  image = socialShare,
} = Astro.props;

// Open Graph and Twitter both require ABSOLUTE urls — every scraper silently
// ignores a relative og:image, which is the usual reason a share preview comes
// out blank. Astro.site is `site` in astro.config.mjs, so that has to stay set.
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(image.src, Astro.site);

const SITE_NAME = 'Genesis 360';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href={canonicalURL} />

    <!-- First-touch attribution. document.referrer only ever names the page
         viewed immediately before this one, so by the time someone browses to
         the contact form the referrer is our own domain and the original
         source (Google, LinkedIn) is gone. Capturing it once on first landing
         and holding it in a cookie survives that internal navigation; the
         Pipedrive form reads the cookie into a hidden field on submit.

         First-party, no PII, no cross-site tracking, so no consent banner is
         required. `is:inline` keeps Astro from bundling and deferring it -
         this has to run before the visitor can navigate away. -->
    <script is:inline>
      (function () {
        var NAME = 'g360_first_touch';
        var DAYS = 90;
        try {
          // First touch wins. Never overwrite a source already captured.
          if (document.cookie.indexOf(NAME + '=') !== -1) return;

          var utm = new URLSearchParams(window.location.search).get('utm_source');
          var here = window.location.hostname.replace(/^www\./, '');
          var value = 'direct';

          if (utm) {
            value = utm;
          } else if (document.referrer) {
            var from = new URL(document.referrer).hostname.replace(/^www\./, '');
            // An internal referrer means we missed the real entry point, so
            // record 'direct' rather than crediting ourselves for the lead.
            if (from && from !== here) value = from;
          }

          value = value.replace(/[^a-zA-Z0-9._-]/g, '').slice(0, 60) || 'direct';

          document.cookie =
            NAME + '=' + value +
            ';path=/;max-age=' + DAYS * 86400 + ';SameSite=Lax' +
            (window.location.protocol === 'https:' ? ';Secure' : '');
        } catch (e) {
          // Attribution is best effort. It must never break the page.
        }
      })();
    </script>

    <!-- Open Graph. Facebook, LinkedIn, Slack, iMessage and WhatsApp all read
         these. Width and height are emitted so a scraper can lay the card out
         on first pass without waiting to fetch and measure the image. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:width" content={String(image.width)} />
    <meta property="og:image:height" content={String(image.height)} />
    <meta property="og:image:alt" content={title} />

    <!-- Twitter/X reads its own namespace and falls back to og: for anything
         missing. summary_large_image is what gets the full-width card. -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />

    <!-- TeX Gyre Heros is self-hosted (see the @font-face block in
         global.css), so there is no font CDN to preconnect to. Preloading the
         two faces the chrome always paints in stops the swap flash on first
         view; the italics load on demand. -->
    <link rel="preload" href="/fonts/texgyreheros-regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/texgyreheros-bold.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
  </head>
  <body class="min-h-screen">
    <slot />
  </body>
</html>
