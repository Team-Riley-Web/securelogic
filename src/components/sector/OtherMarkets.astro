---
// src/components/sector/OtherMarkets.astro
// Sibling-market strip at the very bottom of every market page — after the
// closing CTA, just above the footer. Compact linked cards on white with a
// hairline top border: light, so it separates from the dark footer below it,
// and small, so it reads as navigation rather than another content section.
// (Was a dark pill row that ran straight into the footer; the ag pages had
// their own full-size white card grid. Every market page now uses this.)
// Dumbbell is a value import (not `import type`) because `typeof Dumbbell` needs the runtime binding.
import { ArrowRight, Dumbbell } from '@lucide/astro';

interface Props {
  heading: string;
  basePath: string;
  markets: { slug: string; title: string; summary: string; icon: typeof Dumbbell }[];
}

const { heading, basePath, markets } = Astro.props;
---

<section class="border-t border-brand-100 bg-white py-12 sm:py-14">
  <div class="container-page">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <div>
        <p class="bl-eyebrow">Other Markets</p>
        <h2 class="mt-2 text-2xl font-bold text-brand-900">{heading}</h2>
      </div>
    </div>

    <div class:list={['mt-6 grid gap-4 sm:grid-cols-2', markets.length >= 3 && 'lg:grid-cols-3']}>
      {markets.map(({ icon: Icon, slug, title, summary }) => (
        <a
          href={`${basePath}${slug}/`}
          class="group flex items-start gap-4 rounded-2xl border border-brand-200/70 bg-white p-5 transition hover:-translate-y-0.5 hover:border-brand-300 hover:shadow-lift"
        >
          <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-brand-100 text-brand-600 transition group-hover:bg-brand-600 group-hover:text-white">
            <Icon class="h-5 w-5" aria-hidden="true" />
          </span>
          <span class="min-w-0 flex-1">
            <span class="flex items-center justify-between gap-3">
              <span class="text-base font-bold text-brand-900">{title}</span>
              <ArrowRight class="h-4 w-4 shrink-0 text-brand-600 transition group-hover:translate-x-1" aria-hidden="true" />
            </span>
            <span class="mt-1 block text-sm leading-6 text-brand-body">{summary}</span>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>
