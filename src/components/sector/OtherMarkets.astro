---
// src/components/sector/OtherMarkets.astro
// Sibling-market strip at the very bottom of a sector page — after the
// closing CTA, just above the footer. A compact dark pill row rather than a
// card grid, so it reads as footer-adjacent navigation instead of another
// content section competing with the CTA above it.
// Dumbbell is a value import (not `import type`) because `typeof Dumbbell` needs the runtime binding.
import { Dumbbell } from '@lucide/astro';

interface Props {
  heading: string;
  basePath: string;
  markets: { slug: string; title: string; summary: string; icon: typeof Dumbbell }[];
}

const { heading, basePath, markets } = Astro.props;
---

<section class="relative overflow-hidden py-12 text-white sm:py-14" style="background: linear-gradient(160deg, var(--bl-ink) 0%, var(--bl-ink-mid) 58%, var(--bl-ink-deep) 100%);">
  <div class="container-page relative">
    <p class="bl-eyebrow" style="--bl-eyebrow-color: var(--bl-lime);">Other Markets</p>
    <h2 class="mt-2 text-2xl font-bold text-white">{heading}</h2>

    <div class="mt-6 flex flex-wrap gap-3">
      {markets.map(({ icon: Icon, slug, title }) => (
        <a
          href={`${basePath}${slug}/`}
          class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/[0.06] px-5 py-3 text-sm font-bold text-white transition hover:bg-white/[0.12]"
        >
          <Icon class="h-4 w-4" aria-hidden="true" />
          {title}
        </a>
      ))}
    </div>
  </div>
</section>
