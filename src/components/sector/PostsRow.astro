---
// src/components/sector/PostsRow.astro
// Related-reading row shared by every sector page. Extracted from
// AgPostsRow.astro (which now wraps this) so the Human and HVAC sections
// render the identical block. Heading is a prop because the ag pages say
// "From The Field" and other sectors will not.
import { ArrowRight } from '@lucide/astro';
import { Image } from 'astro:assets';
import type { BlogPost } from '../../data/blog-posts';

interface Props {
  posts: BlogPost[];
  heading?: string;
  /** Small line above the heading. */
  eyebrow?: string;
  /** Shown when there is more to read than the three shown here. */
  showReadMore?: boolean;
}

const { posts, heading = 'From The Field', eyebrow = 'Related Reading', showReadMore = true } = Astro.props;
---

{/* Its own band: navy, so related reading reads as a distinct aside rather
    than one more white section. Tighter padding than a content section, with
    Read More in the header row instead of a centred pill under the cards --
    that pill plus two sections' worth of padding was the gap people noticed
    between this and whatever followed. */}
{posts.length > 0 && (
  <section class="relative overflow-hidden bg-brand-900 py-16 text-white sm:py-20" style="--bl-eyebrow-color: var(--bl-lime);">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true" style="background: radial-gradient(circle at 88% 0%, rgb(62 103 232 / 0.32), transparent 42%), radial-gradient(circle at 6% 100%, rgb(82 194 76 / 0.12), transparent 40%);"></div>
    <div class="container-page relative">
      <div class="reveal flex flex-wrap items-end justify-between gap-6" x-intersect.once="$el.classList.add('is-visible')">
        <div>
          <p class="bl-eyebrow">{eyebrow}</p>
          <h2 class="bl-h2 mt-3 text-white">{heading}</h2>
        </div>
        {showReadMore && (
          <a href="/blogs/" class="hidden items-center gap-2 rounded-full border border-white/30 px-5 py-2.5 text-xs font-bold uppercase tracking-[0.12em] text-white transition hover:bg-white/10 sm:inline-flex">
            Read More <ArrowRight class="h-4 w-4" aria-hidden="true" />
          </a>
        )}
      </div>

      <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <a
            href={`/blogs/${post.slug}/`}
            class="group flex flex-col overflow-hidden rounded-2xl bg-white text-brand-900 shadow-lift-dark transition hover:-translate-y-1"
          >
            <div class="overflow-hidden">
              <Image
                src={post.image}
                alt={post.imageAlt}
                class="aspect-[16/9] w-full object-cover transition duration-500 group-hover:scale-[1.03]"
                widths={[420, 640, 860]}
                sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
              />
            </div>
            <div class="flex flex-1 flex-col p-6">
              <time datetime={post.isoDate} class="text-xs font-bold uppercase tracking-[0.14em] text-brand-muted">
                {post.date}
              </time>
              <h3 class="mt-3 text-lg leading-7">{post.title}</h3>
              <span class="mt-auto inline-flex items-center gap-2 pt-6 text-sm font-bold text-brand-600">
                Read article <ArrowRight class="h-4 w-4 transition group-hover:translate-x-1" aria-hidden="true" />
              </span>
            </div>
          </a>
        ))}
      </div>

      {showReadMore && (
        <div class="mt-8 text-center sm:hidden">
          <a href="/blogs/" class="inline-flex items-center gap-2 rounded-full border border-white/30 px-5 py-2.5 text-xs font-bold uppercase tracking-[0.12em] text-white">
            Read More <ArrowRight class="h-4 w-4" aria-hidden="true" />
          </a>
        </div>
      )}
    </div>
  </section>
)}
