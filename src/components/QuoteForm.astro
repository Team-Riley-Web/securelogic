---
import { Check, Mail, Phone } from '@lucide/astro';
import PipedriveForm from './PipedriveForm.astro';

interface Props {
  title?: string;
  compact?: boolean;
}

const { title = 'Get A Quote', compact = false } = Astro.props;

const points = [
  'Response within one business day',
  'Facility walkthrough and coverage plan',
  'Fixed, portable, or HVAC-integrated options',
];

---

<div class="@container">
  <div
    class:list={[
      'overflow-hidden rounded-2xl bg-white',
      compact ? 'shadow-lift ring-1 ring-slate-900/5' : 'grid shadow-deep ring-1 ring-slate-900/5 @4xl:grid-cols-[minmax(0,.85fr)_minmax(0,1.15fr)]',
    ]}
  >
    {!compact && (
      <aside class="relative overflow-hidden bg-canopy p-8 @2xl:p-10">
        <div
          class="absolute inset-0 bg-[radial-gradient(circle_at_15%_15%,hsl(104_40%_67%/.22),transparent_46%),radial-gradient(circle_at_85%_90%,hsl(211_80%_72%/.18),transparent_44%)]"
          aria-hidden="true"
        >
        </div>
        <div class="relative">
          <p class="eyebrow text-botanical-300">Get Started Today</p>
          <h2 class="mt-4 text-3xl font-bold tracking-tight text-white">{title}</h2>
          <p class="mt-5 text-base leading-8 text-emerald-50/70">
            Tell us which product you are evaluating and where it will be used. Our team can help scope the right
            configuration for your facility.
          </p>
          <div class="mt-8 grid gap-3">
            {points.map((point) => (
              <div class="flex items-start gap-3 text-sm font-semibold leading-6 text-white">
                <Check class="mt-0.5 h-5 w-5 shrink-0 text-botanical-300" />
                <span>{point}</span>
              </div>
            ))}
          </div>
          <div class="mt-8 grid gap-3 border-t border-white/15 pt-8">
            <a
              href="tel:18889974310"
              class="inline-flex items-center gap-3 text-sm font-semibold text-white transition hover:text-botanical-200"
            >
              <Phone class="h-4 w-4 text-botanical-300" /> 1-888-997-4310
            </a>
            <a
              href="mailto:info@securelogicUSA.com"
              class="inline-flex items-center gap-3 text-sm font-semibold text-white transition hover:text-botanical-200"
            >
              <Mail class="h-4 w-4 text-botanical-300" /> info@securelogicUSA.com
            </a>
          </div>
        </div>
      </aside>
    )}

    <div class:list={['content-start p-6', compact ? '@lg:p-8' : '@2xl:p-10']}>
      {compact && (
        <div class="mb-6">
          <p class="eyebrow">Genesis 360</p>
          <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900">{title}</h2>
        </div>
      )}

      <PipedriveForm />
    </div>
  </div>
</div>
