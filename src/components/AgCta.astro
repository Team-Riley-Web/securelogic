---
// src/components/AgCta.astro
// Thin wrapper kept so the ag pages do not change. The block itself lives in
// sector/SectorCta.astro and is shared with the Human and HVAC sections.
//
// NOTE: the deck asked for two iconographic actions here ("call or email your
// sales representative" / "place an order now"). Reduced to a single Get A
// Quote at the client's request while /get-a-quote/ is unfinished.
import SectorCta from './sector/SectorCta.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  eyebrow: string;
  heading: string;
  copy: string;
  // Pages open during the soft launch pass '/#contact' so the CTA lands on the landing page's contact block instead of the gated /get-a-quote/.
  href?: string;
  // Passed straight through to SectorCta; see that component for what they do.
  variant?: 'default' | 'photo';
  image?: ImageMetadata;
  imageAlt?: string;
}

const { eyebrow, heading, copy, href = '/get-a-quote/', variant, image, imageAlt } = Astro.props;
---

<SectorCta eyebrow={eyebrow} heading={heading} copy={copy} href={href} variant={variant} image={image} imageAlt={imageAlt} />
