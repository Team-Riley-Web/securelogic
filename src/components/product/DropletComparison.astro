---
// Source: reference-files/brochures/Technology Explainer.pdf, page 1.
// The values and air-behavior descriptions are reproduced without extending
// them into an efficacy or safety comparison.
interface Props {
  eyebrow?: string;
  heading?: string;
  copy?: string;
  /** Centre the heading block, the table columns and the mobile cards. */
  center?: boolean;
  /** `dark`: navy ground, white type, glassy table. */
  theme?: 'light' | 'dark';
}

const {
  eyebrow = 'Droplet Behavior',
  heading = 'Size Changes How A Droplet Moves.',
  center = false,
  theme = 'light',
  copy = 'Conventional application methods deposit liquid quickly. Genesis360 is engineered below ten microns so the mist remains suspended and moves with the room instead.',
} = Astro.props;

const rows = [
  { technology: 'Pump Sprayers', size: '80–300 µm', behavior: 'Falls immediately' },
  { technology: 'ULV Foggers', size: '20–50 µm', behavior: 'Falls within seconds' },
  { technology: 'Electrostatic Sprayers', size: '40–80 µm', behavior: 'Rapid surface deposition' },
  { technology: 'Genesis360', size: 'Sub-10 µm', behavior: 'Suspended aerosol behavior', featured: true },
];
const dark = theme === 'dark';
---

<section
  class:list={['relative overflow-hidden py-20 sm:py-24', dark ? 'bg-brand-900 text-white' : 'bg-brand-100']}
  style={dark ? '--bl-eyebrow-color: var(--bl-lime);' : undefined}
>
  <div
    class="pointer-events-none absolute inset-0 opacity-70"
    aria-hidden="true"
    style={dark
      ? 'background: radial-gradient(circle at 86% 4%, rgb(62 103 232 / 0.35), transparent 45%), radial-gradient(circle at 2% 96%, rgb(82 194 76 / 0.16), transparent 42%);'
      : 'background: radial-gradient(circle at 86% 4%, rgb(29 63 214 / 0.1), transparent 45%), radial-gradient(circle at 2% 96%, rgb(82 194 76 / 0.09), transparent 42%);'}
  ></div>
  <div class="container-page relative">
    <div class:list={['reveal max-w-3xl', center && 'mx-auto text-center']} x-intersect.once="$el.classList.add('is-visible')">
      <p class="bl-eyebrow">{eyebrow}</p>
      <h2 class:list={['bl-h2 mt-4', dark && 'text-white']}>{heading}</h2>
      <p class:list={['mt-5 text-base leading-7 sm:text-lg', dark ? 'text-white/70' : 'text-brand-body']}>{copy}</p>
    </div>

    <div
      class:list={[
        'reveal mt-12 hidden overflow-hidden rounded-2xl md:block',
        dark ? 'border border-white/15 bg-white/[.06] backdrop-blur-sm' : 'bg-white shadow-lift',
      ]}
      x-intersect.once="$el.classList.add('is-visible')"
    >
      <div class:list={['grid grid-cols-[1.1fr_.7fr_1.2fr] px-7 py-4 text-xs font-bold uppercase tracking-[.16em]', dark ? 'border-b border-white/15 bg-white/[.06] text-white/60' : 'bg-brand-900 text-white/70', center && 'text-center']}>
        <span>Technology</span><span>Typical size</span><span>Air behavior</span>
      </div>
      {rows.map((row) => (
        <div
          class:list={[
            'grid grid-cols-[1.1fr_.7fr_1.2fr] items-center px-7 py-6',
            center && 'text-center',
            row.featured
              ? (dark ? 'bg-lime-400/10' : 'bg-primary-50')
              : (dark ? 'border-b border-white/10 last:border-0' : 'border-b border-brand-100 last:border-0'),
          ]}
        >
          <span class:list={['font-semibold', dark ? 'text-white' : (row.featured ? 'text-primary-800' : 'text-brand-900')]}>{row.technology}</span>
          <span class:list={['text-2xl font-bold', row.featured ? (dark ? 'text-lime-400' : 'text-botanical-600') : (dark ? 'text-white/85' : 'text-brand-700')]}>{row.size}</span>
          <span class:list={['text-sm leading-6', dark ? 'text-white/65' : 'text-brand-body']}>{row.behavior}</span>
        </div>
      ))}
    </div>

    <div class="mt-10 grid gap-4 md:hidden">
      {rows.map((row) => (
        <article
          class:list={[
            'rounded-2xl p-6 shadow-sm',
            center && 'text-center',
            dark
              ? (row.featured ? 'bg-lime-400/10 ring-1 ring-lime-400/40' : 'border border-white/15 bg-white/[.06]')
              : (row.featured ? 'bg-primary-50 ring-1 ring-primary-200' : 'bg-white'),
          ]}
        >
          <p class:list={['text-sm font-semibold', dark ? 'text-white' : 'text-brand-900']}>{row.technology}</p>
          <p class:list={['mt-3 text-3xl font-bold', row.featured ? (dark ? 'text-lime-400' : 'text-botanical-600') : (dark ? 'text-white/85' : 'text-brand-700')]}>{row.size}</p>
          <p class:list={['mt-2 text-sm leading-6', dark ? 'text-white/65' : 'text-brand-body']}>{row.behavior}</p>
        </article>
      ))}
    </div>

    <p class:list={['mt-6 text-xs leading-5', dark ? 'text-white/50' : 'text-brand-muted', center && 'text-center']}>Source: Genesis360 Technology Explainer. Values describe typical droplet size and air behavior, not comparative disinfection performance.</p>
  </div>
</section>
