---
// Source: reference-files/brochures/Technology Explainer.pdf, page 1.
// The values and air-behavior descriptions are reproduced without extending
// them into an efficacy or safety comparison.
interface Props {
  eyebrow?: string;
  heading?: string;
  copy?: string;
}

const {
  eyebrow = 'Droplet Behavior',
  heading = 'Size Changes How A Droplet Moves.',
  copy = 'Conventional application methods deposit liquid quickly. Genesis360 is engineered below ten microns so the mist remains suspended and moves with the room instead.',
} = Astro.props;

const rows = [
  { technology: 'Pump Sprayers', size: '80–300 µm', behavior: 'Falls immediately' },
  { technology: 'ULV Foggers', size: '20–50 µm', behavior: 'Falls within seconds' },
  { technology: 'Electrostatic Sprayers', size: '40–80 µm', behavior: 'Rapid surface deposition' },
  { technology: 'Genesis360', size: 'Sub-10 µm', behavior: 'Suspended aerosol behavior', featured: true },
];
---

<section class="relative overflow-hidden bg-brand-100 py-20 sm:py-24">
  <div class="pointer-events-none absolute inset-0 opacity-70" aria-hidden="true" style="background: radial-gradient(circle at 86% 4%, rgb(29 63 214 / 0.1), transparent 45%), radial-gradient(circle at 2% 96%, rgb(82 194 76 / 0.09), transparent 42%);"></div>
  <div class="container-page relative">
    <div class="reveal max-w-3xl" x-intersect.once="$el.classList.add('is-visible')">
      <p class="bl-eyebrow">{eyebrow}</p>
      <h2 class="bl-h2 mt-4">{heading}</h2>
      <p class="mt-5 text-base leading-8 text-brand-body sm:text-lg">{copy}</p>
    </div>

    <div class="reveal mt-12 hidden overflow-hidden rounded-2xl bg-white shadow-lift md:block" x-intersect.once="$el.classList.add('is-visible')">
      <div class="grid grid-cols-[1.1fr_.7fr_1.2fr] bg-brand-900 px-7 py-4 text-xs font-bold uppercase tracking-[.16em] text-white/70">
        <span>Technology</span><span>Typical size</span><span>Air behavior</span>
      </div>
      {rows.map((row) => (
        <div class:list={['grid grid-cols-[1.1fr_.7fr_1.2fr] items-center px-7 py-6', row.featured ? 'bg-primary-50' : 'border-b border-brand-100 last:border-0']}>
          <span class:list={['font-semibold', row.featured ? 'text-primary-800' : 'text-brand-900']}>{row.technology}</span>
          <span class:list={['text-2xl font-bold', row.featured ? 'text-botanical-600' : 'text-brand-700']}>{row.size}</span>
          <span class="text-sm leading-6 text-brand-body">{row.behavior}</span>
        </div>
      ))}
    </div>

    <div class="mt-10 grid gap-4 md:hidden">
      {rows.map((row) => (
        <article class:list={['rounded-2xl p-6 shadow-sm', row.featured ? 'bg-primary-50 ring-1 ring-primary-200' : 'bg-white']}>
          <p class="text-sm font-semibold text-brand-900">{row.technology}</p>
          <p class:list={['mt-3 text-3xl font-bold', row.featured ? 'text-botanical-600' : 'text-brand-700']}>{row.size}</p>
          <p class="mt-2 text-sm leading-6 text-brand-body">{row.behavior}</p>
        </article>
      ))}
    </div>

    <p class="mt-6 text-xs leading-5 text-brand-muted">Source: Genesis360 Technology Explainer. Values describe typical droplet size and air behavior, not comparative disinfection performance.</p>
  </div>
</section>
