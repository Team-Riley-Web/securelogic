---
// src/components/ImageZoom.astro
// A thumbnail that opens its image full-size in a modal. Built on the native
// <dialog>: Esc closes it, focus is trapped and returned by the browser, and
// the page behind is inert while it is open. A click on the backdrop (outside
// the figure) or the close button also closes it.
//
//   <ImageZoom src={label} alt="…" caption="BotaniMax product label" />
//
// The full-size copy is lazy, so a page pays for it only when someone opens it.
import { Maximize2, X } from '@lucide/astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Shown under the image in the modal, and as the button's label. */
  caption?: string;
  /** Classes for the thumbnail <img>. */
  class?: string;
  widths?: number[];
  sizes?: string;
}

const { src, alt, caption, class: imgClass = 'w-full rounded-xl object-contain', widths = [640, 960, 1280], sizes = '100vw' } = Astro.props;
const label = caption ? `Enlarge: ${caption}` : 'Enlarge image';
---

<div class="image-zoom">
  <button type="button" class="group relative block w-full cursor-zoom-in" data-image-zoom-open aria-label={label} aria-haspopup="dialog">
    <Image src={src} alt={alt} class={imgClass} widths={widths} sizes={sizes} />
    <!-- Below the image, not over it: on a label or a diagram any corner
         badge sits on top of text someone is trying to read. -->
    <span class="pointer-events-none mt-3 flex items-center justify-center gap-2 text-[.68rem] font-bold uppercase tracking-[.14em] text-brand-600 transition group-hover:text-brand-900 group-focus-visible:text-brand-900">
      <Maximize2 class="h-3.5 w-3.5" aria-hidden="true" /> Click To Enlarge
    </span>
  </button>

  <dialog class="image-zoom-dialog" aria-label={caption ?? alt}>
    <figure class="relative mx-auto flex max-h-full w-full max-w-6xl flex-col items-center" data-image-zoom-figure>
      <button type="button" class="absolute -top-2 right-0 z-10 grid h-11 w-11 -translate-y-full place-items-center rounded-full bg-white text-brand-900 shadow-lift transition hover:bg-brand-100" data-image-zoom-close aria-label="Close">
        <X class="h-5 w-5" aria-hidden="true" />
      </button>
      <Image src={src} alt={alt} class="max-h-[80vh] w-auto max-w-full rounded-xl bg-white object-contain shadow-deep" widths={[1280, 1920, 2560]} sizes="min(72rem, 94vw)" loading="lazy" />
      {caption && <figcaption class="mt-4 text-center text-sm font-semibold text-white/80">{caption}</figcaption>}
    </figure>
  </dialog>
</div>

<style is:global>
  .image-zoom-dialog {
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    margin: 0;
    padding: 4.5rem 1rem 2rem;
    background: transparent;
    border: 0;
    overflow: auto;
  }
  .image-zoom-dialog:not([open]) { display: none; }
  .image-zoom-dialog[open] { display: flex; align-items: center; justify-content: center; }
  .image-zoom-dialog::backdrop { background: rgb(7 16 47 / 0.88); backdrop-filter: blur(4px); }
  @media (prefers-reduced-motion: no-preference) {
    .image-zoom-dialog[open] [data-image-zoom-figure] { animation: image-zoom-in 180ms ease-out; }
  }
  @keyframes image-zoom-in { from { opacity: 0; transform: scale(.97); } to { opacity: 1; transform: none; } }
</style>

<script>
  // One delegated listener set for every ImageZoom on the page.
  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    const opener = target.closest<HTMLElement>('[data-image-zoom-open]');
    if (opener) {
      opener.closest('.image-zoom')?.querySelector<HTMLDialogElement>('dialog')?.showModal();
      return;
    }
    const dialog = target.closest<HTMLDialogElement>('.image-zoom-dialog');
    if (!dialog) return;
    // Close on the X, or on any click that is not on the image itself.
    if (target.closest('[data-image-zoom-close]') || !target.closest('img')) dialog.close();
  });
</script>
