  .sh-mobile-phone:hover {
    background: #d3e0ff;
    color: var(--bl-ink);
  }

  @media (min-width: 1024px) {
    .sh-phone,
    .sh-burger,
    .sh-mobile-nav { display: none !important; }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header-main,
    .site-header-sub,
    .header-logo-mark { transition: none; }

    /* The sweep is decoration. Stopping it parks the gradient at 0% 50%, which
       is exactly the logo's own green-to-blue — so the mark still looks right,
       it just holds still. */
    .header-logo-mark {
      animation: none;
      background-position: 0% 50%;
    }

    /* The arrows still work under reduced motion, so the slides still change —
       they just cross-fade in place instead of travelling. Opacity has to come
       back here: with the travel removed, all three would otherwise sit on top
       of each other at translateX(0) and render at once. */
    .announcement-slide,
    .sh-announce.is-reversed .announcement-slide,
    .sh-announce.is-reversed .announcement-slide.is-exit {
      transform: none;
      opacity: 0;
      transition: opacity 0.2s ease;
    }

    .announcement-slide.is-active,
    .sh-announce.is-reversed .announcement-slide.is-active {
      opacity: 1;
    }
  }
</style>

<script>
  const announcementSlides = Array.from(document.querySelectorAll<HTMLElement>('[data-announcement-slide]'));
  const announcementPrevious = document.querySelector<HTMLButtonElement>('[data-announcement-prev]');
  const announcementNext = document.querySelector<HTMLButtonElement>('[data-announcement-next]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const mobileAnnouncement = window.matchMedia('(max-width: 639px)');

  let announcementIndex = 0;
  let announcementTimer: number | undefined;

  const announcementBar = document.querySelector<HTMLElement>('.sh-announce');
  const SLIDE_MS = 600;

  // A slide that has finished exiting has to get back to the entry side to be
  // reusable. Moving it there with the transition live would drag it back
  // across the bar in full view, so kill transitions for one frame. Reading
  // offsetWidth between the two class changes is what forces the browser to
  // commit the jump before animation is allowed again.
  function parkAnnouncement(slide: HTMLElement) {
    if (slide.classList.contains('is-active')) return;
    slide.classList.add('no-anim');
    slide.classList.remove('is-exit');
    void slide.offsetWidth;
    slide.classList.remove('no-anim');
  }

  // Direction lives on the bar, not the slide, because it has to flip the
  // resting position of every parked slide at once — otherwise the incoming one
  // would still be waiting on the right during a backwards move.
  //
  // Flipping it has to be instant. These slides transition their transform, so
  // toggling the class with animation live sends every parked slide gliding
  // from one side to the other in full view — a message that is not involved in
  // the change sails across the bar. Suppress, flip, flush, restore.
  function setAnnouncementDirection(back: boolean) {
    if (!announcementBar) return;
    if (announcementBar.classList.contains('is-reversed') === back) return;
    announcementSlides.forEach((slide) => slide.classList.add('no-anim'));
    announcementBar.classList.toggle('is-reversed', back);
    void announcementBar.offsetWidth;
    announcementSlides.forEach((slide) => slide.classList.remove('no-anim'));
  }

  function showAnnouncement(index: number, back = false) {
    const total = announcementSlides.length;
    const previousIndex = announcementIndex;
    announcementIndex = (index + total) % total;
    if (announcementIndex === previousIndex) return;

    // Before anything moves, so the incoming slide starts from the correct side.
    setAnnouncementDirection(back);

    announcementSlides.forEach((slide, slideIndex) => {
      const isActive = slideIndex === announcementIndex;
      slide.setAttribute('aria-hidden', String(!isActive));
      // Parked slides are only hidden by the wrapper's clip, so their links stay
      // in the tab order. Tabbing into one makes the browser scroll the clipped
      // box to reveal it, which shoves the visible message out of the bar.
      slide.inert = !isActive;

      if (isActive) {
        slide.classList.remove('is-exit');
        slide.classList.add('is-active');
      } else if (slideIndex === previousIndex) {
        slide.classList.remove('is-active');
        slide.classList.add('is-exit');
        window.setTimeout(() => parkAnnouncement(slide), SLIDE_MS);
      } else {
        slide.classList.remove('is-active');
      }
    });
  }

  function startAnnouncementRotation() {
    if (reduceMotion || announcementSlides.length < 2) return;
    window.clearInterval(announcementTimer);
    // Time to read the message, not just to see it. 5200 desktop was too quick
    // to finish the line and take in the link before it moved on.
    const rotationDelay = mobileAnnouncement.matches ? 10400 : 8200;
    announcementTimer = window.setInterval(() => showAnnouncement(announcementIndex + 1), rotationDelay);
  }

  announcementPrevious?.addEventListener('click', () => {
    showAnnouncement(announcementIndex - 1, true);
    startAnnouncementRotation();
  });

  announcementNext?.addEventListener('click', () => {
    showAnnouncement(announcementIndex + 1);
    startAnnouncementRotation();
  });

  // Set the initial inert state; showAnnouncement maintains it from here.
  announcementSlides.forEach((slide, slideIndex) => {
    slide.inert = slideIndex !== announcementIndex;
  });

  // Backstop for browsers without inert: if anything does manage to scroll the
  // track, snap it straight back. The bar has no legitimate scroll of its own.
  const announcementTrack = document.querySelector<HTMLElement>('[data-announcement-track]');
  announcementTrack?.addEventListener('scroll', () => {
    if (announcementTrack.scrollLeft !== 0) announcementTrack.scrollLeft = 0;
  });

  startAnnouncementRotation();
</script>
