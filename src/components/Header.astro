---
// Site-wide header, adopted from the alternate-homepage design test.
//
// Three stacked pieces, all self-contained so any page can drop in <Header />:
//   1. Announcement bar — rotating, outside the sticky stack on purpose.
//   2. Pinned logo row — split mega-menu around a centred wordmark + CTA.
//   3. Secondary nav — hangs below the pinned row and peeks back on scroll-up.
// Below 1024px the mega-menus hide themselves, so the row swaps to a hamburger
// that opens an accordion drawer covering the same taxonomy.
import { ChevronDown, ChevronLeft, ChevronRight, Menu, Phone, X } from '@lucide/astro';
import MegaMenu from './MegaMenu.astro';
import { megaMenus } from '../data/mega-menus';

interface Props {
  // `minimal` strips every link that points at an interior page and leaves the
  // chrome otherwise identical, for use while the site is gated behind the
  // interim landing page. The full header is the default, so no other page
  // changes. Delete the `minimal` usage in index.astro to restore navigation.
  minimal?: boolean;
}

const { minimal = false } = Astro.props;

// Tap-to-call on the landing page, parked 2026-09-03 at Joshua's request —
// "remove the phone icon from the home page for just right now". Flip to true to
// bring it back. Only affects the `minimal` header; the interior-page icon in
// the left column is untouched. `.sh-phone` is mobile-only either way, so this
// changes nothing at lg and up.
const SHOW_LANDING_PHONE = false;

// Nav splits around the centred logo, so the menus split too.
const leftMenus = megaMenus.filter((m) => ['Human', 'HVAC', 'Ag'].includes(m.label));
const rightMenus = megaMenus
  .filter((m) => ['Resources', 'About Us'].includes(m.label))
  .map((m) => (m.label === 'About Us' ? { ...m, label: 'About' } : m));

const secondaryLinks = [
  { label: 'Genesis 360', href: '/genesis360mistingsystems/' },
  { label: 'BotaniMax', href: '/botanimax/' },
  { label: 'Shop All', href: '#shop' },
];
---

<div
  class="sh"
  x-data="{
    scrolled: false,
    navPeek: true,
    mobileOpen: false,
    lastScrollY: 0,
    headerFrame: null,
    updateHeaderState() {
      const y = Math.max(0, window.scrollY);

      // Separate enter/exit thresholds. Collapsing the bars shortens the page,
      // so a single boundary let the header flip back and forth on the
      // smallest scroll — the gap between 72 and 16 absorbs that.
      if (!this.scrolled && y > 72) this.scrolled = true;
      else if (this.scrolled && y < 16) this.scrolled = false;

      // Secondary nav stays reachable: it peeks back out on a deliberate
      // upward scroll and slides away again on the way down. lastScrollY only
      // moves when the threshold is crossed, so jitter accumulates to nothing.
      if (y <= 16) {
        this.navPeek = true;
        this.lastScrollY = y;
        return;
      }

      const delta = y - this.lastScrollY;
      if (delta > 14) {
        this.navPeek = false;
        this.lastScrollY = y;
      } else if (delta < -14) {
        this.navPeek = true;
        this.lastScrollY = y;
      }
    },
    scheduleHeaderState() {
      if (this.headerFrame !== null) return;

      this.headerFrame = requestAnimationFrame(() => {
        this.headerFrame = null;
        this.updateHeaderState();
      });
    }
  }"
  x-init="
    updateHeaderState();
    window.addEventListener('scroll', () => scheduleHeaderState(), { passive: true });
  "
  x-effect="document.documentElement.classList.toggle('mobile-nav-open', mobileOpen)"
  x-on:keydown.escape.window="mobileOpen = false"
>
  <!-- Announcement bar. Deliberately outside the sticky stack: it scrolls away
       on its own and returns at the top of the page, so the header never
       changes the document height mid-scroll. -->
  <div class:list={['sh-announce flex min-h-10 items-center justify-center gap-3 px-4 py-2 text-center text-xs font-semibold uppercase tracking-[0.08em] text-white sm:gap-6', minimal && 'sh-announce-compact']}>
    <button type="button" class="rounded-full p-1 opacity-60 transition hover:bg-white/10 hover:opacity-100 focus:outline-none focus:ring-2 focus:ring-white/70" data-announcement-prev aria-label="Previous announcement">
      <ChevronLeft class="h-4 w-4" aria-hidden="true" />
    </button>
    <!-- On the landing page every one of these links collapsed to the same
         "Contact Us", which turned the rotation into the same call to action
         three times over, next to the Contact Us pill in the row below. The
         minimal build shows the message alone. -->
    <div class="grid min-w-0 flex-1 place-items-center overflow-hidden" aria-live="polite" data-announcement-track>
      <p class="announcement-slide is-active" data-announcement-slide aria-hidden="false">
        <span>Automated, Whole-Room Disinfection</span>{!minimal && (<><span class="announcement-separator"> &nbsp;|&nbsp; </span><a href="/get-a-quote/" class="announcement-link underline decoration-white/50 underline-offset-2">Get A Quote →</a></>)}
      </p>
      <p class="announcement-slide" data-announcement-slide aria-hidden="true">
        <span>Sub-10 <span class="normal-case">μm</span> Dry-Mist Precision</span>{!minimal && (<><span class="announcement-separator"> &nbsp;|&nbsp; </span><a href="/about-us/technology/" class="announcement-link underline decoration-white/50 underline-offset-2">See How It Works →</a></>)}
      </p>
      <p class="announcement-slide" data-announcement-slide aria-hidden="true">
        <span>Botanical Chemistry, Built for Precision</span>{!minimal && (<><span class="announcement-separator"> &nbsp;|&nbsp; </span><a href="/botanimax/" class="announcement-link underline decoration-white/50 underline-offset-2">Explore BotaniMax →</a></>)}
      </p>
    </div>
    <button type="button" class="rounded-full p-1 opacity-60 transition hover:bg-white/10 hover:opacity-100 focus:outline-none focus:ring-2 focus:ring-white/70" data-announcement-next aria-label="Next announcement">
      <ChevronRight class="h-4 w-4" aria-hidden="true" />
    </button>
  </div>

  <!-- Sticky stack: the logo row pins at a constant height; the secondary nav
       hangs off it absolutely and slides in and out behind it. -->
  <div class="site-header" x-bind:class="scrolled && 'is-scrolled'">
    <!-- Header — `relative` anchors the mega-menu panel (it uses top-full). -->
    <header
      class="site-header-main relative z-50 border-b border-slate-100"
      style="--mm-accent: var(--bl-blue); --mm-ink: var(--bl-ink); --mm-tile-bg: var(--bl-sky); --mm-tile-hover-bg: #d3e0ff; --mm-foot-bg: #f7faff; --mm-row-hover-bg: #f7faff; --mm-border: #e5ecfa; --mm-trigger-size: 0.78rem; --mm-trigger-weight: 700; --mm-trigger-transform: uppercase; --mm-trigger-tracking: 0.07em;"
    >
      <!-- Three columns on the full site so the logo sits centred between the
           two nav clusters. The landing page has no left cluster, which left
           the centred logo hanging over empty space — so `minimal` drops to two
           columns and anchors the logo at the left edge instead. -->
      <div class:list={['site-header-row mx-auto grid max-w-7xl items-center gap-6 px-6', minimal ? 'grid-cols-[auto_1fr]' : 'grid-cols-[1fr_auto_1fr]']}>
        {!minimal && <MegaMenu menus={leftMenus} class="col-start-1 row-start-1 justify-self-start font-semibold" />}
        {!minimal && (
          <a href="tel:18889974310" class="sh-phone col-start-1 row-start-1 justify-self-start" aria-label="Call Genesis 360 at 1-888-997-4310">
            <Phone class="h-5 w-5" aria-hidden="true" />
          </a>
        )}
        {!minimal && (
          <button
            type="button"
            class="sh-burger col-start-3 row-start-1 justify-self-end"
            x-on:click="mobileOpen = !mobileOpen"
            x-bind:aria-expanded="mobileOpen.toString()"
            aria-controls="sh-mobile-nav"
            aria-label="Toggle navigation"
          >
            <Menu class="h-6 w-6" x-show="!mobileOpen" />
            <X class="h-6 w-6" x-show="mobileOpen" x-cloak />
          </button>
        )}
        <a href="/" class:list={['row-start-1 flex items-center', minimal ? 'col-start-1 justify-self-start' : 'col-start-2 justify-center justify-self-center']} aria-label="Genesis 360 home">
          <span class="header-logo-mark animated-text">Genesis360</span>
        </a>
        <div class:list={['row-start-1 items-center justify-self-end gap-4', minimal ? 'col-start-2 flex' : 'col-start-3 hidden lg:flex']}>
          {!minimal && <MegaMenu menus={rightMenus} class="font-semibold" />}
          {/* The tap-to-call icon rides with the CTA here rather than sitting in
              the left column, which the logo now occupies. `.sh-phone` still
              hides itself at lg and up, so this is the mobile affordance only. */}
          {minimal && SHOW_LANDING_PHONE && (
            <a href="tel:18889974310" class="sh-phone" aria-label="Call Genesis 360 at 1-888-997-4310">
              <Phone class="h-5 w-5" aria-hidden="true" />
            </a>
          )}
          <a href={minimal ? '#contact' : '/get-a-quote/'} class="bl-pill">{minimal ? 'Contact Us' : 'Get A Quote'}</a>
        </div>
      </div>

      <!-- Mobile drawer. Inside the pinned row so it stays reachable while the
           page scrolls; the mega-menus above are desktop-only. -->
      {!minimal && (
        <nav
          id="sh-mobile-nav"
          class="sh-mobile-nav"
          x-show="mobileOpen"
          x-transition:enter="transition ease-out duration-300"
          x-transition:enter-start="-translate-y-4 opacity-0"
          x-transition:enter-end="translate-y-0 opacity-100"
          x-transition:leave="transition ease-in duration-200"
          x-transition:leave-start="translate-y-0 opacity-100"
          x-transition:leave-end="-translate-y-4 opacity-0"
          x-cloak
          aria-label="Mobile navigation"
        >
          <div class="mx-auto max-w-7xl px-5 py-5 sm:px-6">
            <div class="sh-mobile-menu-stack">
            {megaMenus.map((menu) => (
              <div x-data="{ open: false }" class="sh-mobile-group">
                <div class="sh-mobile-primary">
                  <a href={menu.href} class="sh-mobile-primary-link" x-on:click="mobileOpen = false">
                    {menu.label}
                  </a>
                  <button
                    type="button"
                    class="sh-mobile-toggle"
                    x-on:click="open = !open"
                    x-bind:aria-expanded="open.toString()"
                    aria-label={`Show ${menu.label} links`}
                  >
                    <ChevronDown class="h-4 w-4 transition duration-200" x-bind:class="open && 'rotate-180'" aria-hidden="true" />
                  </button>
                </div>
                <div
                  class="sh-mobile-submenu"
                  x-show="open"
                  x-transition:enter="transition ease-out duration-200"
                  x-transition:enter-start="-translate-y-1 opacity-0"
                  x-transition:enter-end="translate-y-0 opacity-100"
                  x-cloak
                >
                  {menu.items.map(({ icon: Icon, title, href }) => (
                    <a href={href} class="sh-mobile-sublink" x-on:click="mobileOpen = false">
                      <Icon class="h-4 w-4 shrink-0" aria-hidden="true" />
                      <span>{title}</span>
                    </a>
                  ))}
                </div>
              </div>
            ))}
            </div>

            <div class="sh-mobile-secondary">
              {secondaryLinks.map(({ label, href }) => (
                <a href={href} class="sh-mobile-secondary-link" x-on:click="mobileOpen = false">{label}</a>
              ))}
            </div>

            <a href="/get-a-quote/" class="bl-pill mt-5 w-full" x-on:click="mobileOpen = false">Get A Quote</a>
            <a href="tel:18889974310" class="sh-mobile-phone">
              <Phone class="h-4 w-4 shrink-0" aria-hidden="true" />
              <span>1-888-997-4310</span>
            </a>
          </div>
        </nav>
      )}

    </header>

    {!minimal && (
      <div class="site-header-sub" x-bind:class="!navPeek && 'is-tucked'" x-bind:inert="!navPeek">
        <div class="hidden justify-center gap-8 border-t border-slate-100 py-3 lg:flex">
          {secondaryLinks.map(({ label, href }) => (
            <a href={href} class="sub-link">{label}</a>
          ))}
        </div>
      </div>
    )}
  </div>
</div>

<style>
  /* The wrapper only carries tokens and Alpine state — it must not generate a
     box, or the sticky row below would be trapped inside its short height and
     scroll away on interior pages. */
  .sh {
    display: contents;
    font-family: 'TeX Gyre Heros', ui-sans-serif, system-ui, sans-serif;
    color: var(--bl-ink);
  }

  .sh-announce {
    background: var(--bl-blue);
  }

  /* Secondary nav matches the CTA's weight and case; the mega-menu triggers get
     the same treatment through its --mm-trigger-* tokens. */
  .site-header-sub a {
    font-weight: 700;
    transition: color 0.2s ease;
    font-size: 0.78rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .sub-link:hover {
    color: var(--bl-blue);
  }

  .site-header-sub > div {
    background: var(--bl-sky);
    color: var(--bl-ink);
    /* Small drop shadow so the bar reads as a layer sitting above the page when
       it peeks back in on an upward scroll. Offset downward and tightly
       feathered: the pinned row sits at a higher z-index and paints over
       anything cast upward, so only the bottom edge is ever seen. It rides on
       this inner div rather than the positioned wrapper because this is the
       element that carries the background, and it is display:none below lg —
       which is what keeps the shadow off mobile, where the bar never shows. */
    box-shadow: 0 8px 14px -8px rgb(16 32 74 / 0.22);
  }

  /* Sticky header. The whole stack pins; the announcement bar and secondary
     nav collapse on scroll so only the logo row stays, then expand again at
     the top of the page. */
  /* Nothing in here may change the document height while scrolling: an earlier
     version collapsed the bars in-flow, the page got shorter, and Chrome's
     scroll anchoring pushed the scroll position back across the threshold —
     which re-opened the bars, and flickered forever. The row is now a fixed
     height and the secondary nav is out of flow. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    overflow-anchor: none;
  }

  .site-header-main {
    position: relative;
    z-index: 2;
    background: #fff;
    transition: background 0.32s ease, color 0.32s ease, border-color 0.32s ease, box-shadow 0.32s ease;
  }

  .site-header-row {
    min-height: 5rem;
  }

  :global(html.mobile-nav-open) {
    overflow: hidden;
  }

  /* Hangs below the pinned row and slides up behind it, so it peeks back out
     on an upward scroll without touching layout. */
  .site-header-sub {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    z-index: 1;
    transition: transform 0.38s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.24s ease;
  }

  .site-header-sub.is-tucked {
    transform: translateY(-100%);
    opacity: 0;
    pointer-events: none;
  }

  /* Scrolled state: the pinned row flips to brand dark blue with the wordmark
     inverted to white; the CTA flips to white-on-blue to stay readable. */
  .site-header.is-scrolled .site-header-main {
    background: var(--bl-ink);
    color: #fff;
    border-bottom-color: rgb(255 255 255 / 0.08);
    box-shadow: 0 16px 36px -24px rgb(8 21 86 / 0.7);
  }

  /* On the dark bar the wordmark reads mostly white, with the brand gradient
     passing through it at intervals rather than tinting it the whole time.
     White dominates the ramp and the two colour stops sit in the middle third,
     so with background-size 300% the visible window is white at rest and the
     colour band sweeps across as the animation carries it. Both ends of the
     ramp are white, so the loop has no seam.
     Overriding background-image and -size only; the clip and the animation
     still come from .animated-text. `color` is the fallback for anything
     without background-clip: text — white, to match the resting state. */
  .site-header.is-scrolled .header-logo-mark {
    background-image: linear-gradient(
      90deg,
      #fff 0%,
      #fff 16%,
      var(--bl-brand-green-light) 33%,
      var(--bl-brand-blue-light) 50%,
      #fff 67%,
      #fff 100%
    );
    background-size: 300% 100%;
    color: #fff;
  }

  .site-header.is-scrolled .site-header-main .bl-pill {
    background: #fff;
    color: var(--bl-ink);
  }

  .site-header.is-scrolled .site-header-main .bl-pill:hover {
    background: var(--bl-sky);
    color: var(--bl-blue-dark);
  }

  /* The wordmark is live text now, not a bitmap. TeX Gyre Heros Bold is a
     near-exact match for the logo's letterforms (compared glyph by glyph
     against Genesis360-full-logo.png). 33px lands the cap height at ~25px, the
     same ink height the bitmap had, so swapping to text moved nothing in the
     row.
     letter-spacing is -0.005em, fitted not guessed: rendered the wordmark at a
     grid of tracking values, scaled each to the logo's cap height, aligned
     baselines and scored pixel overlap against the artwork. -0.005em peaks at
     0.87 IoU across "Genesis" and falls off cleanly either side (0 -> 0.82,
     -0.01em -> 0.81). It was +0.012em before, which was fitted to total width
     and so came out too loose — see the note in TASKS.md about the digits.
     No synthetic weight: the stems already match. Measured vertical stem as a
     share of cap height, the logo is 0.1866 and Heros Bold 0.1848, 1% apart.
     Adding -webkit-text-stroke on top would overshoot. */
  .header-logo-mark {
    font-family: 'TeX Gyre Heros', ui-sans-serif, system-ui, sans-serif;
    font-size: 33px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.005em;
    white-space: nowrap;
    /* Paints if background-clip: text is unsupported, and is the colour the
       scrolled state overrides. */
    color: #225a8f;
    transition: color 0.32s ease;
  }

  /* Between lg and xl the two nav clusters and the CTA leave the centred
     wordmark only ~28px of air on its right. Step it down so it reads as a
     logo with room around it rather than something wedged into the gap. */
  @media (min-width: 1024px) and (max-width: 1279px) {
    .header-logo-mark {
      font-size: 29px;
    }
  }

  /* Travels like a slider: the outgoing message leaves to the left, the
     incoming one arrives from the right. All three slides sit in the same grid
     cell and the wrapper clips them, so only the active one is ever on screen.
     width: 100% matters more than it looks — the grid is justify-items: center,
     so without it each <p> would be only as wide as its own text and
     translateX(100%) would move it by that text width, leaving it still partly
     inside the wrapper. Filling the cell makes 100% mean "exactly one bar
     across". */
  /* From sm up the track stops stretching and becomes a compact centred
     window. It was flex-1, so it spanned the full bar — 1312px at 1440 for a
     message that only needs ~450 — and because the slides fill the track, that
     was also the distance each one had to travel. 34rem clears the longest of
     the three messages (451px measured) with enough slack that none of them
     wraps to a second line, and the two arrows close in to sit either side of
     it instead of being pinned to the edges of the screen.
     Below sm the track keeps stretching: the message is meant to wrap there and
     the bar is already sized for two lines plus the link. */
  @media (min-width: 640px) {
    [data-announcement-track] {
      flex: 0 1 auto;
      width: 34rem;
      max-width: 100%;
    }
  }

  .announcement-slide {
    grid-column: 1;
    grid-row: 1;
    width: 100%;
    text-align: center;
    /* Position only, no fade. Cross-fading a slider leaves a beat where the
       outgoing message has faded out and the incoming one has not arrived, and
       the bar reads empty mid-travel. Slides stay fully opaque and the
       wrapper's overflow clip is what hides the parked ones. */
    transform: translateX(100%);
    transition: transform 0.55s cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: none;
  }

  .announcement-slide.is-active {
    transform: translateX(0);
    pointer-events: auto;
  }

  /* The one being replaced, mid-exit. Parked slides sit off to the right
     waiting to come in; this is the only one on the left. */
  .announcement-slide.is-exit {
    transform: translateX(-100%);
  }

  /* Prev button: the whole thing runs the other way, so the exiting slide
     leaves right and the arriving one comes from the left. */
  .sh-announce.is-reversed .announcement-slide {
    transform: translateX(-100%);
  }

  .sh-announce.is-reversed .announcement-slide.is-active {
    transform: translateX(0);
  }

  .sh-announce.is-reversed .announcement-slide.is-exit {
    transform: translateX(100%);
  }

  /* Set for one frame while a spent slide is moved back to the entry side, so
     it teleports instead of sliding back across the bar in view. */
  .announcement-slide.no-anim {
    transition: none;
  }

  @media (max-width: 639px) {
    /* Tall enough for the message to wrap with its link on a line of its own.
       The landing page has no link, so it keeps the base single-line height. */
    .sh-announce {
      min-height: 4.75rem;
    }

    .sh-announce-compact {
      min-height: 2.5rem;
    }

    .announcement-slide {
      line-height: 1.35;
      transition-duration: 0.65s;
    }

    .announcement-separator {
      display: none;
    }

    .announcement-link {
      display: block;
      width: max-content;
      margin: 0.3rem auto 0;
      white-space: nowrap;
    }
  }

  /* Mobile: the mega-menus hide themselves below 1024px, so the burger and its
     drawer carry the same taxonomy. */
  .sh-burger,
  .sh-phone {
    display: inline-flex;
    height: 2.75rem;
    width: 2.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.5rem;
    color: inherit;
    transition: background 0.2s ease;
  }

  .sh-burger:hover,
  .sh-phone:hover {
    background: var(--bl-sky);
  }

  .site-header.is-scrolled .sh-burger:hover,
  .site-header.is-scrolled .sh-phone:hover {
    background: rgb(255 255 255 / 0.12);
  }

  .sh-mobile-nav {
    position: absolute;
    top: 100%;
    right: 0;
    left: 0;
    border-top: 1px solid #e5ecfa;
    background: #fff;
    color: var(--bl-ink);
    max-height: calc(100vh - 5rem);
    max-height: calc(100dvh - 5rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    box-shadow: 0 24px 48px -24px rgb(16 32 74 / 0.28), 0 8px 16px -12px rgb(16 32 74 / 0.24);
    background:
      radial-gradient(circle at 100% 0%, rgb(227 237 255 / 0.9), transparent 42%),
      #f8faff;
  }

  .sh-mobile-menu-stack {
    display: grid;
    gap: 0.65rem;
  }

  .sh-mobile-group {
    overflow: hidden;
    border-radius: 0.85rem;
    background: #fff;
    box-shadow: 0 12px 24px -20px rgb(16 32 74 / 0.28), 0 2px 5px -3px rgb(16 32 74 / 0.18);
  }

  .sh-mobile-primary {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .sh-mobile-primary-link {
    min-width: 0;
    flex: 1;
    padding: 1rem 0 1rem 1rem;
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.065em;
    text-transform: uppercase;
    color: var(--bl-ink);
  }

  .sh-mobile-primary-link:hover {
    color: var(--bl-blue);
  }

  .sh-mobile-toggle {
    display: inline-flex;
    height: 2.75rem;
    width: 2.75rem;
    flex: none;
    align-items: center;
    justify-content: center;
    margin-right: 0.35rem;
    border-radius: 0.65rem;
    background: var(--bl-sky);
    color: var(--bl-blue-dark);
    transition: background 0.2s ease, color 0.2s ease;
  }

  .sh-mobile-toggle:hover {
    background: #d3e0ff;
    color: var(--bl-ink);
  }

  .sh-mobile-submenu {
    display: grid;
    gap: 0.25rem;
    margin: 0 0.5rem 0.5rem;
    border-radius: 0.65rem;
    background: #f7faff;
    padding: 0.4rem;
  }

  .sh-mobile-sublink {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    border-radius: 0.5rem;
    padding: 0.65rem 0.7rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--bl-body);
  }

  .sh-mobile-sublink:hover {
    background: #fff;
    color: var(--bl-blue);
  }

  .sh-mobile-sublink svg {
    color: var(--bl-blue);
  }

  .sh-mobile-secondary {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .sh-mobile-secondary-link {
    display: flex;
    min-height: 3rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.7rem;
    background: var(--bl-sky);
    padding: 0.6rem 0.35rem;
    text-align: center;
    color: var(--bl-blue-dark);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.045em;
    line-height: 1.35;
    text-transform: uppercase;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .sh-mobile-secondary-link:hover {
    background: #d3e0ff;
    color: var(--bl-ink);
  }

  .sh-mobile-phone {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin: 0.75rem 0 0;
    border-radius: 999px;
    background: var(--bl-sky);
    padding: 0.8rem 1.4rem;
    color: var(--bl-blue-dark);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    transition: background 0.2s ease, color 0.2s ease;
