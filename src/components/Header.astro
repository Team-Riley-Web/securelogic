---
// Site-wide header, adopted from the alternate-homepage design test.
//
// Three stacked pieces, all self-contained so any page can drop in <Header />:
//   1. Announcement bar — rotating, outside the sticky stack on purpose.
//   2. Pinned logo row — split mega-menu around a centred wordmark + CTA.
//   3. Secondary nav — hangs below the pinned row and peeks back on scroll-up.
// Below 1024px the mega-menus hide themselves, so the row swaps to a hamburger
// that opens an accordion drawer covering the same taxonomy.
import { ChevronDown, ChevronLeft, ChevronRight, Menu, Phone, X } from '@lucide/astro';
import { Image } from 'astro:assets';
import MegaMenu from './MegaMenu.astro';
import { megaMenus } from '../data/mega-menus';
import logo from '../assets/images/logo-tight.png';

interface Props {
  // `minimal` strips every link that points at an interior page and leaves the
  // chrome otherwise identical, for use while the site is gated behind the
  // interim landing page. The full header is the default, so no other page
  // changes. Delete the `minimal` usage in index.astro to restore navigation.
  minimal?: boolean;
}

const { minimal = false } = Astro.props;

// Nav splits around the centred logo, so the menus split too.
const leftMenus = megaMenus.filter((m) => ['Human', 'HVAC', 'Ag'].includes(m.label));
const rightMenus = megaMenus
  .filter((m) => ['Resources', 'About Us'].includes(m.label))
  .map((m) => (m.label === 'About Us' ? { ...m, label: 'About' } : m));

const secondaryLinks = [
  { label: 'Genesis 360', href: '/genesis360mistingsystems/' },
  { label: 'BotaniMax', href: '/botanimax/' },
  { label: 'Shop All', href: '#shop' },
];
---

<div
  class="sh"
  x-data="{
    scrolled: false,
    navPeek: true,
    mobileOpen: false,
    lastScrollY: 0,
    headerFrame: null,
    updateHeaderState() {
      const y = Math.max(0, window.scrollY);

      // Separate enter/exit thresholds. Collapsing the bars shortens the page,
      // so a single boundary let the header flip back and forth on the
      // smallest scroll — the gap between 72 and 16 absorbs that.
      if (!this.scrolled && y > 72) this.scrolled = true;
      else if (this.scrolled && y < 16) this.scrolled = false;

      // Secondary nav stays reachable: it peeks back out on a deliberate
      // upward scroll and slides away again on the way down. lastScrollY only
      // moves when the threshold is crossed, so jitter accumulates to nothing.
      if (y <= 16) {
        this.navPeek = true;
        this.lastScrollY = y;
        return;
      }

      const delta = y - this.lastScrollY;
      if (delta > 14) {
        this.navPeek = false;
        this.lastScrollY = y;
      } else if (delta < -14) {
        this.navPeek = true;
        this.lastScrollY = y;
      }
    },
    scheduleHeaderState() {
      if (this.headerFrame !== null) return;

      this.headerFrame = requestAnimationFrame(() => {
        this.headerFrame = null;
        this.updateHeaderState();
      });
    }
  }"
  x-init="
    updateHeaderState();
    window.addEventListener('scroll', () => scheduleHeaderState(), { passive: true });
  "
  x-effect="document.documentElement.classList.toggle('mobile-nav-open', mobileOpen)"
  x-on:keydown.escape.window="mobileOpen = false"
>
  <!-- Announcement bar. Deliberately outside the sticky stack: it scrolls away
       on its own and returns at the top of the page, so the header never
       changes the document height mid-scroll. -->
  <div class="sh-announce flex min-h-10 items-center justify-center gap-3 px-4 py-2 text-center text-xs font-semibold uppercase tracking-[0.08em] text-white sm:gap-6">
    <button type="button" class="rounded-full p-1 opacity-60 transition hover:bg-white/10 hover:opacity-100 focus:outline-none focus:ring-2 focus:ring-white/70" data-announcement-prev aria-label="Previous announcement">
      <ChevronLeft class="h-4 w-4" aria-hidden="true" />
    </button>
    <div class="grid min-w-0 flex-1 place-items-center overflow-hidden" aria-live="polite">
      <p class="announcement-slide is-active" data-announcement-slide aria-hidden="false">
        <span>Automated, Whole-Room Disinfection</span><span class="announcement-separator"> &nbsp;|&nbsp; </span><a href={minimal ? '#contact' : '/get-a-quote/'} class="announcement-link underline decoration-white/50 underline-offset-2">{minimal ? 'Contact Us' : 'Get A Quote'} →</a>
      </p>
      <p class="announcement-slide" data-announcement-slide aria-hidden="true">
        <span>Sub-10 <span class="normal-case">μm</span> Dry-Mist Precision</span><span class="announcement-separator"> &nbsp;|&nbsp; </span><a href={minimal ? '#contact' : '/about-us/technology/'} class="announcement-link underline decoration-white/50 underline-offset-2">{minimal ? 'Contact Us' : 'See How It Works'} →</a>
      </p>
      <p class="announcement-slide" data-announcement-slide aria-hidden="true">
        <span>Botanical Chemistry, Built for Precision</span><span class="announcement-separator"> &nbsp;|&nbsp; </span><a href={minimal ? '#contact' : '/botanimax/'} class="announcement-link underline decoration-white/50 underline-offset-2">{minimal ? 'Contact Us' : 'Explore BotaniMax'} →</a>
      </p>
    </div>
    <button type="button" class="rounded-full p-1 opacity-60 transition hover:bg-white/10 hover:opacity-100 focus:outline-none focus:ring-2 focus:ring-white/70" data-announcement-next aria-label="Next announcement">
      <ChevronRight class="h-4 w-4" aria-hidden="true" />
    </button>
  </div>

  <!-- Sticky stack: the logo row pins at a constant height; the secondary nav
       hangs off it absolutely and slides in and out behind it. -->
  <div class="site-header" x-bind:class="scrolled && 'is-scrolled'">
    <!-- Header — `relative` anchors the mega-menu panel (it uses top-full). -->
    <header
      class="site-header-main relative z-50 border-b border-slate-100"
      style="--mm-accent: var(--bl-blue); --mm-ink: var(--bl-ink); --mm-tile-bg: var(--bl-sky); --mm-tile-hover-bg: #d3e0ff; --mm-foot-bg: #f7faff; --mm-row-hover-bg: #f7faff; --mm-border: #e5ecfa; --mm-trigger-size: 0.78rem; --mm-trigger-weight: 700; --mm-trigger-transform: uppercase; --mm-trigger-tracking: 0.07em;"
    >
      <div class="site-header-row mx-auto grid max-w-7xl grid-cols-[1fr_auto_1fr] items-center gap-6 px-6">
        {!minimal && <MegaMenu menus={leftMenus} class="col-start-1 row-start-1 justify-self-start font-semibold" />}
        <a href="tel:18889974310" class="sh-phone col-start-1 row-start-1 justify-self-start" aria-label="Call Secure Logic at 1-888-997-4310">
          <Phone class="h-5 w-5" aria-hidden="true" />
        </a>
        {!minimal && (
          <button
            type="button"
            class="sh-burger col-start-3 row-start-1 justify-self-end"
            x-on:click="mobileOpen = !mobileOpen"
            x-bind:aria-expanded="mobileOpen.toString()"
            aria-controls="sh-mobile-nav"
            aria-label="Toggle navigation"
          >
            <Menu class="h-6 w-6" x-show="!mobileOpen" />
            <X class="h-6 w-6" x-show="mobileOpen" x-cloak />
          </button>
        )}
        <a href="/" class="col-start-2 row-start-1 flex items-center justify-center justify-self-center" aria-label="Secure Logic home">
          <Image src={logo} alt="Secure Logic logo" class="header-logo-mark w-auto object-contain" style="height: calc(var(--spacing) * 8.5);" widths={[120, 180]} sizes="120px" />
        </a>
        <div class:list={['col-start-3 row-start-1 items-center justify-self-end gap-4', minimal ? 'flex' : 'hidden lg:flex']}>
          {!minimal && <MegaMenu menus={rightMenus} class="font-semibold" />}
          <a href={minimal ? '#contact' : '/get-a-quote/'} class="bl-pill">{minimal ? 'Contact Us' : 'Get A Quote'}</a>
        </div>
      </div>

      <!-- Mobile drawer. Inside the pinned row so it stays reachable while the
           page scrolls; the mega-menus above are desktop-only. -->
      {!minimal && (
        <nav
          id="sh-mobile-nav"
          class="sh-mobile-nav"
          x-show="mobileOpen"
          x-transition:enter="transition ease-out duration-300"
          x-transition:enter-start="-translate-y-4 opacity-0"
          x-transition:enter-end="translate-y-0 opacity-100"
          x-transition:leave="transition ease-in duration-200"
          x-transition:leave-start="translate-y-0 opacity-100"
          x-transition:leave-end="-translate-y-4 opacity-0"
          x-cloak
          aria-label="Mobile navigation"
        >
          <div class="mx-auto max-w-7xl px-5 py-5 sm:px-6">
            <div class="sh-mobile-menu-stack">
            {megaMenus.map((menu) => (
              <div x-data="{ open: false }" class="sh-mobile-group">
                <div class="sh-mobile-primary">
                  <a href={menu.href} class="sh-mobile-primary-link" x-on:click="mobileOpen = false">
                    {menu.label}
                  </a>
                  <button
                    type="button"
                    class="sh-mobile-toggle"
                    x-on:click="open = !open"
                    x-bind:aria-expanded="open.toString()"
                    aria-label={`Show ${menu.label} links`}
                  >
                    <ChevronDown class="h-4 w-4 transition duration-200" x-bind:class="open && 'rotate-180'" aria-hidden="true" />
                  </button>
                </div>
                <div
                  class="sh-mobile-submenu"
                  x-show="open"
                  x-transition:enter="transition ease-out duration-200"
                  x-transition:enter-start="-translate-y-1 opacity-0"
                  x-transition:enter-end="translate-y-0 opacity-100"
                  x-cloak
                >
                  {menu.items.map(({ icon: Icon, title, href }) => (
                    <a href={href} class="sh-mobile-sublink" x-on:click="mobileOpen = false">
                      <Icon class="h-4 w-4 shrink-0" aria-hidden="true" />
                      <span>{title}</span>
                    </a>
                  ))}
                </div>
              </div>
            ))}
            </div>

            <div class="sh-mobile-secondary">
              {secondaryLinks.map(({ label, href }) => (
                <a href={href} class="sh-mobile-secondary-link" x-on:click="mobileOpen = false">{label}</a>
              ))}
            </div>

            <a href="/get-a-quote/" class="bl-pill mt-5 w-full" x-on:click="mobileOpen = false">Get A Quote</a>
            <a href="tel:18889974310" class="sh-mobile-phone">
              <Phone class="h-4 w-4 shrink-0" aria-hidden="true" />
              <span>1-888-997-4310</span>
            </a>
          </div>
        </nav>
      )}

    </header>

    {!minimal && (
      <div class="site-header-sub" x-bind:class="!navPeek && 'is-tucked'" x-bind:inert="!navPeek">
        <div class="hidden justify-center gap-8 border-t border-slate-100 py-3 lg:flex">
          {secondaryLinks.map(({ label, href }) => (
            <a href={href} class="sub-link">{label}</a>
          ))}
        </div>
      </div>
    )}
  </div>
</div>

<style>
  /* The wrapper only carries tokens and Alpine state — it must not generate a
     box, or the sticky row below would be trapped inside its short height and
     scroll away on interior pages. */
  .sh {
    display: contents;
    font-family: 'Poppins', ui-sans-serif, system-ui, sans-serif;
    color: var(--bl-ink);
  }

  .sh-announce {
    background: var(--bl-blue);
  }

  /* Secondary nav matches the CTA's weight and case; the mega-menu triggers get
     the same treatment through its --mm-trigger-* tokens. */
  .site-header-sub a {
    font-weight: 700;
    transition: color 0.2s ease;
    font-size: 0.78rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .sub-link:hover {
    color: var(--bl-blue);
  }

  .site-header-sub > div {
    background: var(--bl-sky);
    color: var(--bl-ink);
    /* Small drop shadow so the bar reads as a layer sitting above the page when
       it peeks back in on an upward scroll. Offset downward and tightly
       feathered: the pinned row sits at a higher z-index and paints over
       anything cast upward, so only the bottom edge is ever seen. It rides on
       this inner div rather than the positioned wrapper because this is the
       element that carries the background, and it is display:none below lg —
       which is what keeps the shadow off mobile, where the bar never shows. */
    box-shadow: 0 8px 14px -8px rgb(16 32 74 / 0.22);
  }

  /* Sticky header. The whole stack pins; the announcement bar and secondary
     nav collapse on scroll so only the logo row stays, then expand again at
     the top of the page. */
  /* Nothing in here may change the document height while scrolling: an earlier
     version collapsed the bars in-flow, the page got shorter, and Chrome's
     scroll anchoring pushed the scroll position back across the threshold —
     which re-opened the bars, and flickered forever. The row is now a fixed
     height and the secondary nav is out of flow. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    overflow-anchor: none;
  }

  .site-header-main {
    position: relative;
    z-index: 2;
    background: #fff;
    transition: background 0.32s ease, color 0.32s ease, border-color 0.32s ease, box-shadow 0.32s ease;
  }

  .site-header-row {
    min-height: 5rem;
  }

  :global(html.mobile-nav-open) {
    overflow: hidden;
  }

  /* Hangs below the pinned row and slides up behind it, so it peeks back out
     on an upward scroll without touching layout. */
  .site-header-sub {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    z-index: 1;
    transition: transform 0.38s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.24s ease;
  }

  .site-header-sub.is-tucked {
    transform: translateY(-100%);
    opacity: 0;
    pointer-events: none;
  }

  /* Scrolled state: the pinned row flips to brand dark blue with the wordmark
     inverted to white; the CTA flips to white-on-blue to stay readable. */
  .site-header.is-scrolled .site-header-main {
    background: var(--bl-ink);
    color: #fff;
    border-bottom-color: rgb(255 255 255 / 0.08);
    box-shadow: 0 16px 36px -24px rgb(8 21 86 / 0.7);
  }

  .site-header.is-scrolled .header-logo-mark {
    filter: brightness(0) invert(1);
  }

  .site-header.is-scrolled .site-header-main .bl-pill {
    background: #fff;
    color: var(--bl-ink);
  }

  .site-header.is-scrolled .site-header-main .bl-pill:hover {
    background: var(--bl-sky);
    color: var(--bl-blue-dark);
  }

  .header-logo-mark {
    transition: filter 0.32s ease;
  }

  .announcement-slide {
    grid-column: 1;
    grid-row: 1;
    opacity: 0;
    transform: translateY(0.35rem);
    transition: opacity 0.35s ease, transform 0.35s ease;
    pointer-events: none;
  }

  .announcement-slide.is-active {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  @media (max-width: 639px) {
    .sh-announce {
      min-height: 4.75rem;
    }

    .announcement-slide {
      line-height: 1.35;
      transition-duration: 0.65s;
    }

    .announcement-separator {
      display: none;
    }

    .announcement-link {
      display: block;
      width: max-content;
      margin: 0.3rem auto 0;
      white-space: nowrap;
    }
  }

  /* Mobile: the mega-menus hide themselves below 1024px, so the burger and its
     drawer carry the same taxonomy. */
  .sh-burger,
  .sh-phone {
    display: inline-flex;
    height: 2.75rem;
    width: 2.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.5rem;
    color: inherit;
    transition: background 0.2s ease;
  }

  .sh-burger:hover,
  .sh-phone:hover {
    background: var(--bl-sky);
  }

  .site-header.is-scrolled .sh-burger:hover,
  .site-header.is-scrolled .sh-phone:hover {
    background: rgb(255 255 255 / 0.12);
  }

  .sh-mobile-nav {
    position: absolute;
    top: 100%;
    right: 0;
    left: 0;
    border-top: 1px solid #e5ecfa;
    background: #fff;
    color: var(--bl-ink);
    max-height: calc(100vh - 5rem);
    max-height: calc(100dvh - 5rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    box-shadow: 0 24px 48px -24px rgb(16 32 74 / 0.28), 0 8px 16px -12px rgb(16 32 74 / 0.24);
    background:
      radial-gradient(circle at 100% 0%, rgb(227 237 255 / 0.9), transparent 42%),
      #f8faff;
  }

  .sh-mobile-menu-stack {
    display: grid;
    gap: 0.65rem;
  }

  .sh-mobile-group {
    overflow: hidden;
    border-radius: 0.85rem;
    background: #fff;
    box-shadow: 0 12px 24px -20px rgb(16 32 74 / 0.28), 0 2px 5px -3px rgb(16 32 74 / 0.18);
  }

  .sh-mobile-primary {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .sh-mobile-primary-link {
    min-width: 0;
    flex: 1;
    padding: 1rem 0 1rem 1rem;
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.065em;
    text-transform: uppercase;
    color: var(--bl-ink);
  }

  .sh-mobile-primary-link:hover {
    color: var(--bl-blue);
  }

  .sh-mobile-toggle {
    display: inline-flex;
    height: 2.75rem;
    width: 2.75rem;
    flex: none;
    align-items: center;
    justify-content: center;
    margin-right: 0.35rem;
    border-radius: 0.65rem;
    background: var(--bl-sky);
    color: var(--bl-blue-dark);
    transition: background 0.2s ease, color 0.2s ease;
  }

  .sh-mobile-toggle:hover {
    background: #d3e0ff;
    color: var(--bl-ink);
  }

  .sh-mobile-submenu {
    display: grid;
    gap: 0.25rem;
    margin: 0 0.5rem 0.5rem;
    border-radius: 0.65rem;
    background: #f7faff;
    padding: 0.4rem;
  }

  .sh-mobile-sublink {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    border-radius: 0.5rem;
    padding: 0.65rem 0.7rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--bl-body);
  }

  .sh-mobile-sublink:hover {
    background: #fff;
    color: var(--bl-blue);
  }

  .sh-mobile-sublink svg {
    color: var(--bl-blue);
  }

  .sh-mobile-secondary {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .sh-mobile-secondary-link {
    display: flex;
    min-height: 3rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.7rem;
    background: var(--bl-sky);
    padding: 0.6rem 0.35rem;
    text-align: center;
    color: var(--bl-blue-dark);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.045em;
    line-height: 1.35;
    text-transform: uppercase;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .sh-mobile-secondary-link:hover {
    background: #d3e0ff;
    color: var(--bl-ink);
  }

  .sh-mobile-phone {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin: 0.75rem 0 0;
    border-radius: 999px;
    background: var(--bl-sky);
    padding: 0.8rem 1.4rem;
    color: var(--bl-blue-dark);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .sh-mobile-phone:hover {
    background: #d3e0ff;
    color: var(--bl-ink);
  }

  @media (min-width: 1024px) {
    .sh-phone,
    .sh-burger,
    .sh-mobile-nav { display: none !important; }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header-main,
    .site-header-sub,
    .header-logo-mark { transition: none; }
  }
</style>

<script>
  const announcementSlides = Array.from(document.querySelectorAll<HTMLElement>('[data-announcement-slide]'));
  const announcementPrevious = document.querySelector<HTMLButtonElement>('[data-announcement-prev]');
  const announcementNext = document.querySelector<HTMLButtonElement>('[data-announcement-next]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const mobileAnnouncement = window.matchMedia('(max-width: 639px)');

  let announcementIndex = 0;
  let announcementTimer: number | undefined;

  function showAnnouncement(index: number) {
    announcementIndex = (index + announcementSlides.length) % announcementSlides.length;
    announcementSlides.forEach((slide, slideIndex) => {
      const isActive = slideIndex === announcementIndex;
      slide.classList.toggle('is-active', isActive);
      slide.setAttribute('aria-hidden', String(!isActive));
    });
  }

  function startAnnouncementRotation() {
    if (reduceMotion || announcementSlides.length < 2) return;
    window.clearInterval(announcementTimer);
    const rotationDelay = mobileAnnouncement.matches ? 7600 : 5200;
    announcementTimer = window.setInterval(() => showAnnouncement(announcementIndex + 1), rotationDelay);
  }

  announcementPrevious?.addEventListener('click', () => {
    showAnnouncement(announcementIndex - 1);
    startAnnouncementRotation();
  });

  announcementNext?.addEventListener('click', () => {
    showAnnouncement(announcementIndex + 1);
    startAnnouncementRotation();
  });

  startAnnouncementRotation();
</script>
